---
import chartIcon from '../assets/image/IA/ICONNBANNE-15.png';
import cartIcon from '../assets/image/IA/ICONNBANNE-14.png';
import personIcon from '../assets/image/IA/ICONNBANNE-13.png';
import moneyIcon from '../assets/image/IA/ICONNBANNE-12.png';
import clockIcon from '../assets/image/IA/ICONNBANNE-11.png';
import fondoSection from '../assets/image/IA/FONDOO12_Mesa de trabajo 1.png';

const stats = [
  { icon: chartIcon, target: 35, sign: '+', description: 'Aumento promedio en ventas' },
  { icon: cartIcon, target: 28, sign: '-', description: 'Reducción de quiebres de stock' },
  { icon: personIcon, target: 42, sign: '+', description: 'Recuperación de clientes inactivos' },
  { icon: moneyIcon, target: 25, sign: '+', description: 'Mejora en utilidad neta' },
  { icon: clockIcon, target: 70, sign: '-', description: 'Menos tiempo en análisis de datos' },
];
---

<section class="resultados-clientes" aria-labelledby="resultados-title">
  <div class="resultados-clientes__overlay"></div>
  <div class="resultados-clientes__inner">
    <h2 id="resultados-title">Resultados que nuestros clientes ya están logrando</h2>

    <div class="stats-grid">
      {stats.map((item) => (
        <article class="stat-card">
          <div class="stat-icon-wrap">
            <img src={item.icon.src} alt="" class="stat-icon" loading="lazy" decoding="async" />
          </div>

          <div class="stat-value" data-target={item.target} data-sign={item.sign}>
            <span class="stat-value__number">0</span>
            <span class="stat-value__suffix">%</span>
          </div>

          <p class="stat-description">{item.description}</p>
        </article>
      ))}
    </div>

    <p class="results-footnote">*Resultados promedio de clientes que usan Naniva IA por más de 3 meses.</p>
  </div>
</section>

<script>
  const counters = document.querySelectorAll<HTMLElement>('.stat-value');
  const animations = new WeakMap<HTMLElement, boolean>();

  function animateCounter(element: HTMLElement, target: number, sign: string, duration = 2400) {
    const numberEl = element.querySelector<HTMLElement>('.stat-value__number');
    if (!numberEl) return;
    if (animations.get(element)) return;

    animations.set(element, true);
    const startValue = 0;
    const startTime = performance.now();

    function update(currentTime: number) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const nextValue = Math.round(startValue + (target - startValue) * eased);
      numberEl.textContent = `${sign}${nextValue}`;

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        numberEl.textContent = `${sign}${target}`;
        animations.set(element, false);
      }
    }

    requestAnimationFrame(update);
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const element = entry.target as HTMLElement;
        const target = Number(element.dataset.target || 0);
        const sign = element.dataset.sign || '+';
        const numberEl = element.querySelector<HTMLElement>('.stat-value__number');
        if (!numberEl) return;

        if (entry.isIntersecting) {
          animateCounter(element, target, sign);
        } else {
          numberEl.textContent = `${sign}0`;
          animations.set(element, false);
        }
      });
    },
    {
      threshold: 0.35,
      rootMargin: '0px 0px -5% 0px',
    }
  );

  counters.forEach((counter) => observer.observe(counter));
</script>

<style>
  .resultados-clientes {
    position: relative;
    max-width: 1580px;
    margin: 0 auto 3rem;
    padding: 2rem 0.75rem;
    color: #f8fafc;
    overflow: hidden;
    border-radius: 32px;
    isolation: isolate;
    background: #04091A;
  }

  .resultados-clientes__overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 70%;
    background-image: url('/src/assets/image/IA/FONDOO12_Mesa de trabajo 1.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(1.02);
    z-index: -2;
  }

  .resultados-clientes__inner {
    position: relative;
    z-index: 1;
    margin: 0 auto;
    border-radius: 32px;
    padding: clamp(1.25rem, 1.5vw, 1.75rem);
    overflow: hidden;
    backdrop-filter: blur(2px);
  }

  .resultados-clientes__inner::before {
    content: '';
    position: absolute;
    inset: 0;
   
    border-radius: 32px;
    pointer-events: none;
    box-sizing: border-box;
  }

  .resultados-clientes h2 {
    margin: 0 0 2.2rem;
    text-align: center;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    line-height: 1.15;
    font-weight: 800;
    color: #ffffff;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    min-height: 240px;
    padding: 1.35rem 1rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
  }

  .stat-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 78px;
  }

  .stat-icon {
    width: 72px;
    height: 72px;
    object-fit: contain;
    filter: drop-shadow(0 8px 20px rgba(97, 82, 255, 0.35));
  }

  .stat-value {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.1rem;
    color: #ffffff;
    font-size: clamp(2rem, 2.7vw, 2.8rem);
    font-weight: 800;
    line-height: 1;
    min-height: 2.8rem;
  }

  .stat-value__number {
    font-variant-numeric: tabular-nums;
  }

  .stat-value__suffix {
    color: #dbeafe;
  }

  .stat-description {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 170px;
  }

  .results-footnote {
    margin: 1.7rem 0 0;
    text-align: center;
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.5;
  }
   @media (max-width: 1368px) and (min-width: 606px) {

    .resultados-clientes__overlay {
    position: relative;
    max-width: 80%;
    padding: 1rem 0.75rem;
    color: #f8fafc;
    overflow: hidden;
    border-radius: 32px;
    isolation: isolate;
    background: #04091A;
  }
  .resultados-clientes {
    position: relative;
    max-width: 90%;
    padding: 1rem 0.75rem;
    color: #f8fafc;
    overflow: hidden;
    border-radius: 32px;
    isolation: isolate;
    background: #04091A;
  }
   }

  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .resultados-clientes {
      padding: 4rem 1rem;
    }

    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .resultados-clientes__inner {
      padding: 1.5rem 1rem;
      border-radius: 24px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stat-card {
      min-height: 220px;
    }
  }
</style>
