---
// Icon generator function
function icon(name: string, color: string = "#2563eb", size = 22) {
  const icons: Record<string, string> = {
    check: `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`,
  };
  return icons[name] ?? "";
}

const otherProducts = [
  {
    anchor: "ia",
    badge: "INTELIGENCIA DE NEGOCIO",
    title: "IA NANIVA",
    subtitle: "Predicciones y recomendaciones basadas en tus datos.",
    items: ["Predicción de ventas", "Recomendaciones de stock", "Alertas inteligentes", "Reportes automáticos"],
  },
];
---

{otherProducts.map((product) => (
  <section id={product.anchor} class="other-product-detail product-detail">
    <div class="container other-product-card reveal">
      <span class="erp-badge">{product.badge}</span>
      <h2>{product.title}</h2>
      <p class="erp-hero-sub">{product.subtitle}</p>
      <ul class="checklist-col single">
        {product.items.map((it) => (
          <li><span set:html={icon("check")} />{it}</li>
        ))}
      </ul>
      <div class="erp-cta">
        <a href="/contacto" class="btn-primary hover-pop">Comenzar ahora</a>
        <a href="/contacto" class="btn-outline hover-pop">Solicitar demostración</a>
      </div>
    </div>
  </section>
))}

<style>
  .erp-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #eef4ff;
    color: #2563eb;
    font-size: 1.1rem;
    font-weight: 750;
    letter-spacing: 0.03em;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    margin-top: 0.5rem;
  }

  .other-product-detail {
    padding: 4rem 0;
    scroll-margin-top: 6rem;
    border-top: 1px solid #e2e8f0;
  }

  .other-product-card {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .other-product-card h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.5rem;
  }

  .erp-hero-sub {
    font-size: 1.5rem;
    color: #475569;
    margin: 0 0 1.5rem;
    font-weight: 700;
  }

  .checklist-col {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .checklist-col.single {
    max-width: 480px;
    margin: 1.5rem 0;
  }

  .checklist-col li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    color: #334155;
  }

  .other-product-card .checklist-col.single {
    align-items: flex-start;
    display: inline-flex;
  }

  .erp-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .other-product-card .erp-cta { justify-content: center; }

  .btn-primary {
    background: #2563eb;
    color: white;
    border: none;
    padding: 0.85rem 1.6rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    display: inline-block;
  }

  .btn-outline {
    background: white;
    color: #2563eb;
    border: 1.5px solid #2563eb;
    padding: 0.85rem 1.6rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    display: inline-block;
  }

  .product-detail {
    display: none;
  }

  .product-detail.is-active {
    display: block;
  }
</style>
