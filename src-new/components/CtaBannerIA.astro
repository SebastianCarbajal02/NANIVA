---
import brainiImg from '../assets/image/IA/img cerebrof1_Mesa de trabajo 1.png';
import ctaBackground from '../assets/image/IA/FONDOO12_Mesa de trabajo 1.png';
---

<section class="cta-banner-ia">
  <div class="container">
    <div class="cta-content" style={`background-image: url('${ctaBackground.src}');`}>
      <!-- Left Column -->
      <div class="cta-text reveal">
        <span class="cta-badge">✨ IA QUE TRABAJA POR TI</span>

        <h2 class="cta-title">
          <span class="title-white">No mostramos datos.</span>
          <span class="title-highlight">Entregamos decisiones.</span>
        </h2>

        <p class="cta-description">
          Mientras tú diriges tu empresa, Naniva IA nunca deja de analizarla.
        </p>

        <div class="cta-buttons">
          <a href="#" target="_blank" rel="noopener noreferrer" class="btn-primary hover-pop">
            Quiero ver Naniva IA en acción →
          </a>
          <a href="https://wa.link/d99odw" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Solicitar demostración
          </a>
        </div>
      </div>

      <!-- Right Column -->
      <div class="cta-visual reveal">
        <img src={brainiImg.src} alt="Ilustración de cerebro con engranajes" class="brain-illustration" />
      </div>
    </div>
  </div>
</section>

<style>
  

  .cta-banner-ia .container {
    max-width: 1550px;
  }

  .cta-content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    border-radius: 24px;
    padding: 3.5rem;
    min-height: 520px;
    border: 1px solid rgba(168, 85, 247, 0.15);
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .cta-text {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    z-index: 2;
    max-width: 500px;
    position: relative;
  }

  .cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    border: 1px solid rgba(168, 85, 247, 0.3);
    color: #e9d5ff;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    transform: translateY(-2rem);
  }

  .cta-title {
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    transform: translateY(-1rem);
  }

  .title-white {
    color: #ffffff;
  }

  .title-highlight {
    color: #a855f7;
  }

  .cta-description {
    font-size: 1rem;
    font-weight: 500;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0;
    max-width: 320px;
    transform: translateY(-1rem);
  }

  .cta-buttons {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #a855f7, #7c3aed);
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #9333ea, #6d28d9);
    box-shadow: 0 0 30px rgba(168, 85, 247, 0.4);
    transform: translateY(-2px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: #a78bfa;
    font-weight: 600;
    font-size: 1rem;
    padding: 0;
    text-decoration: none;
    transition: color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .btn-secondary:hover {
    color: #e9d5ff;
  }

  .cta-visual {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 100%;
    width: 55%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    z-index: 1;
  }

  .brain-illustration {
    height: 100%;
    width: auto;
    object-fit: contain;
    object-position: right center;
  }

  @media (max-width: 1100px) {
    .cta-content {
      min-height: 420px;
      padding: 3rem;
    }

    .cta-visual {
      width: 50%;
    }
  }

  @media (max-width: 768px) {
    .cta-banner-ia {
      padding: 3rem 1rem;
    }

    .cta-content {
      min-height: 500px;
      padding: 2.5rem 2rem;
      justify-content: center;
    }

    .cta-content::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(15, 23, 42, 0.7);
      z-index: 1;
      border-radius: 24px;
    }

    .cta-text {
      max-width: 100%;
      text-align: center;
      position: relative;
      z-index: 10;
    }

    .cta-visual {
      position: absolute;
      width: 100%;
      height: 100%;
      right: auto;
      left: 0;
      justify-content: center;
      z-index: 0;
      opacity: 0.5;
    }

    .cta-title {
      font-size: 1.6rem;
    }

    .cta-description {
      font-size: 0.9rem;
      margin: 0 auto;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
      width: 100%;
      margin: 0 auto;
    }

    .btn-primary {
      width: auto;
      justify-content: center;
      padding: 0.85rem 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .cta-content {
      padding: 1.5rem;
    }

    .cta-title {
      font-size: 1.4rem;
    }

    .cta-description {
      font-size: 0.85rem;
    }

    .cta-badge {
      font-size: 0.68rem;
      padding: 0.45rem 0.9rem;
    }
  }
</style>
