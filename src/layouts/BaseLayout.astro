---
import Footer from '../components/Footer.astro';
import logoIcon from '../assets/image/shared/logos/logo-inicio.webp';

export interface Props {
  title?: string;
  description?: string;
}
const { title = "Spiffy Shepherd", description = "Landing page" } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/webp" href={logoIcon.src} />
    <title>{title}</title>
  </head>
  <body>
    <div id="page-loader" class="page-loader">
      <div class="spinner"></div>
    </div>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #6366f1;
    --color-secondary: #ec4899;
    --color-surface: #ffffff;
    --color-bg: #f8fafc;
    --color-text: #1f2937;
    --color-text-muted: #6b7280;
    --max-width: 1200px;
    --radius: 12px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: system-ui, -apple-system, sans-serif;
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
  }
  section { padding: 5rem 1rem; }
  .container { max-width: var(--max-width); margin: 0 auto; padding: 0 1.5rem; }
  html, body { overflow-x: hidden; }

  @media (max-width: 600px) {
    .container { padding: 0 1rem; }
  }

  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .page-loader.active {
    opacity: 1;
    pointer-events: all;
  }
  .page-loader .spinner {
    width: 44px;
    height: 44px;
    border: 4px solid #dbeafe;
    border-top-color: #2563eb;
    border-radius: 999px;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.in-view {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* --- utilidades de animación --- */
  .hover-lift {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .hover-lift:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 30px rgba(15, 23, 42, 0.15);
  }

  .hover-pop {
    transition: transform 0.2s ease;
  }
  .hover-pop:hover {
    transform: scale(1.06);
  }

  .icon-bounce {
    transition: transform 0.25s ease;
  }
  .icon-bounce:hover {
    animation: bounce-icon 0.6s ease;
  }
  @keyframes bounce-icon {
    0%, 100% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-6px) scale(1.08); }
    60% { transform: translateY(0) scale(0.98); }
  }

  .pulse-ring {
    position: relative;
  }
  .pulse-ring::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.45);
    animation: pulse-ring 2.2s ease-out infinite;
    pointer-events: none;
  }
  @keyframes pulse-ring {
    0% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.45); }
    80% { box-shadow: 0 0 0 16px rgba(37, 99, 235, 0); }
    100% { box-shadow: 0 0 0 16px rgba(37, 99, 235, 0); }
  }
  .pulse-ring.whatsapp::after {
    box-shadow: 0 0 0 0 rgba(37, 197, 94, 0.45);
  }
  @keyframes pulse-ring-wa {
    0% { box-shadow: 0 0 0 0 rgba(37, 197, 94, 0.45); }
    80% { box-shadow: 0 0 0 16px rgba(37, 197, 94, 0); }
    100% { box-shadow: 0 0 0 16px rgba(37, 197, 94, 0); }
  }
  .pulse-ring.whatsapp::after { animation-name: pulse-ring-wa; }

  .float-anim {
    animation: float-anim 4s ease-in-out infinite;
  }
  @keyframes float-anim {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hover-lift, .hover-pop, .icon-bounce, .pulse-ring::after, .float-anim {
      animation: none !important;
      transition: none !important;
    }
  }

  /* --- Modal de confirmación de formularios (Contáctanos, Libro de Reclamaciones) --- */
  body.modal-open { overflow: hidden; }

  .form-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1rem;
    animation: form-modal-fade 0.2s ease;
  }
  .form-modal-backdrop[hidden] { display: none; }

  @keyframes form-modal-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .form-modal {
    position: relative;
    background: white;
    border-radius: 20px;
    padding: 2.5rem 2rem 2rem;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 25px 70px rgba(15, 23, 42, 0.3);
    animation: form-modal-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  @keyframes form-modal-pop {
    from { opacity: 0; transform: scale(0.9) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .form-modal-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    width: 0%;
    background: #16a34a;
    transition-property: width;
    transition-timing-function: linear;
  }
  .form-modal.is-error .form-modal-progress { display: none; }

  .form-modal-close {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: #f1f5f9;
    color: #64748b;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .form-modal-close:hover {
    background: #e2e8f0;
    color: #334155;
  }
  .form-modal-close svg { width: 14px; height: 14px; }

  .form-modal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 1.25rem;
    border-radius: 999px;
    animation: form-modal-icon-pop 0.35s ease 0.1s backwards;
  }
  .form-modal-icon svg path,
  .form-modal-icon svg line {
    stroke-dasharray: 28;
    stroke-dashoffset: 28;
    animation: form-modal-icon-draw 0.4s ease 0.25s forwards;
  }

  @keyframes form-modal-icon-pop {
    from { opacity: 0; transform: scale(0.5); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes form-modal-icon-draw {
    to { stroke-dashoffset: 0; }
  }

  .form-modal.is-success .form-modal-icon {
    background: #dcfce7;
    color: #16a34a;
  }
  .form-modal.is-error .form-modal-icon {
    background: #fee2e2;
    color: #dc2626;
  }

  .form-modal h3 {
    font-size: 1.3rem;
    color: #0f172a;
    margin-bottom: 0.6rem;
  }

  .form-modal p {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .form-modal-btn {
    width: 100%;
    justify-content: center;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #2563eb;
    color: white;
    border: none;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .form-modal-btn:hover { background: #1e40af; }

  @media (prefers-reduced-motion: reduce) {
    .form-modal-backdrop,
    .form-modal,
    .form-modal-icon,
    .form-modal-icon svg path,
    .form-modal-icon svg line {
      animation: none !important;
    }
    .form-modal-progress { transition: none !important; }
  }
</style>

<script>
  const loader = document.getElementById("page-loader");

  document.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement).closest("a");
    if (!link) return;
    const href = link.getAttribute("href");
    if (!href || href.startsWith("#") || href.startsWith("http") || link.target === "_blank") return;

    const [path, hash] = href.split("#");
    if (hash && (path === "" || path === window.location.pathname)) return;

    loader?.classList.add("active");
  });

  window.addEventListener("pageshow", () => {
    loader?.classList.remove("active");
  });

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("in-view");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
  );

  document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));
</script>