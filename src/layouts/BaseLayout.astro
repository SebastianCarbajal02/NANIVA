---
import Footer from '@components/layout/Footer.astro';
import logoIcon from '@assets/image/shared/logos/logo-inicio.webp';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = "NANIVA - Plataforma inteligente para hacer crecer tu empresa",
  description = "NANIVA: facturación electrónica SUNAT, ERP, sistema para restaurantes, catálogo digital e inteligencia artificial para gestionar y hacer crecer tu negocio en Perú.",
  image = "/og-image.jpg",
  noindex = false,
  schema,
} = Astro.props;

const siteName = "NANIVA";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": new URL("/#organization", Astro.site).href,
  name: "NANIVA Technologies",
  url: Astro.site?.href,
  logo: new URL(logoIcon.src, Astro.site).href,
  email: "nanivatechnologies@gmail.com",
  telephone: "+51908644190",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Calle Manrique de Luna 168",
    addressLocality: "San Miguel",
    addressRegion: "Lima",
    addressCountry: "PE",
  },
  sameAs: [
    "https://www.instagram.com/nanivatechnologies/",
    "https://www.tiktok.com/@naniva_tec_sac",
    "https://www.youtube.com/@NanivaTechnologies",
  ],
};
// WebSite solo en la home: le indica a Google el nombre del sitio ("NANIVA") en los resultados
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": new URL("/#website", Astro.site).href,
  name: "NANIVA",
  alternateName: ["NANIVA Technologies", "naniva.pe"],
  url: new URL("/", Astro.site).href,
  inLanguage: "es-PE",
  publisher: { "@id": organizationSchema["@id"] },
};
const isHome = Astro.url.pathname === "/";
const schemas = [
  organizationSchema,
  ...(isHome ? [websiteSchema] : []),
  ...(schema ? [schema].flat() : []),
];

// Google Analytics 4: solo en producción, para no registrar visitas de desarrollo
const gaMeasurementId = "G-6JK2T780MX";
const loadAnalytics = import.meta.env.PROD;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#1e3a8a" />
    <link rel="icon" type="image/webp" href={logoIcon.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <slot name="head" />

    {loadAnalytics && (
      <script is:inline define:vars={{ gaMeasurementId }}>
        // gtag se define ya para que los eventos se encolen; el script de Google
        // se descarga después de la carga (o en la primera interacción) para no afectar LCP/INP.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag("js", new Date());
        gtag("config", gaMeasurementId);

        let gaLoaded = false;
        function loadGa() {
          if (gaLoaded) return;
          gaLoaded = true;
          const s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaMeasurementId;
          document.head.appendChild(s);
        }
        ["pointerdown", "keydown", "scroll"].forEach((ev) =>
          window.addEventListener(ev, loadGa, { once: true, passive: true })
        );
        window.addEventListener("load", () => {
          if ("requestIdleCallback" in window) requestIdleCallback(loadGa, { timeout: 3000 });
          else setTimeout(loadGa, 2000);
        });

        // Evento de conversión: cualquier clic a WhatsApp (wa.me, wa.link, api.whatsapp.com)
        document.addEventListener("click", (e) => {
          const link = e.target.closest && e.target.closest("a[href]");
          if (!link) return;
          let host;
          try { host = new URL(link.href).hostname; } catch { return; }
          if (!/(^|\.)(wa\.me|wa\.link|api\.whatsapp\.com)$/.test(host)) return;
          const section = link.closest("section[id], nav, footer, header");
          gtag("event", "whatsapp_click", {
            link_url: link.href,
            link_text: (link.textContent || "").trim().replace(/\s+/g, " ").slice(0, 100),
            link_location: section ? (section.id || section.tagName.toLowerCase()) : "body",
            page_path: location.pathname,
          });
        }, { capture: true });
      </script>
    )}
  </head>
  <body>
    <div id="page-loader" class="page-loader">
      <div class="spinner"></div>
    </div>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #6366f1;
    --color-secondary: #ec4899;
    --color-surface: #ffffff;
    --color-bg: #f8fafc;
    --color-text: #1f2937;
    --color-text-muted: #6b7280;
    --max-width: 1200px;
    --radius: 12px;
    /* Regla única para todos los H1 del sitio: 32px en celular hasta 56px en escritorio */
    --h1-size: clamp(2rem, 1.25rem + 2.5vw, 3.5rem);
    --h1-weight: 700;

    /* Bordes del sitio. Referencia: "Vistas reales del software" del ERP.
       Tarjetas (como sus pestañas): borde gris suave, esquinas de 16px y sombra casi imperceptible.
       Paneles grandes (como su ventana de navegador): mismo borde y esquinas de 18px.
       Ver la skill .claude/skills/naniva-bordes. */
    --border-soft: 1px solid rgba(148, 163, 184, 0.25);
    --card-radius: 16px;
    --card-shadow: 0 6px 18px rgba(15, 23, 42, 0.04);
    --card-shadow-hover: 0 14px 30px rgba(15, 23, 42, 0.08);
    --panel-radius: 18px;
    --frame-shadow: 0 40px 80px -20px rgba(15, 23, 42, 0.22), 0 12px 24px rgba(15, 23, 42, 0.06);
  }
  h1 {
    font-size: var(--h1-size);
    font-weight: var(--h1-weight);
    line-height: 1.15;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: system-ui, -apple-system, sans-serif;
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.6;
  }
  section { padding: 5rem 1rem; }
  .container { max-width: var(--max-width); margin: 0 auto; padding: 0 1.5rem; }
  html, body { overflow-x: hidden; }

  @media (max-width: 600px) {
    .container { padding: 0 1rem; }
  }

  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .page-loader.active {
    opacity: 1;
    pointer-events: all;
  }
  .page-loader .spinner {
    width: 44px;
    height: 44px;
    border: 4px solid #dbeafe;
    border-top-color: #2563eb;
    border-radius: 999px;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.in-view {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* --- utilidades de animación --- */
  .hover-lift {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .hover-lift:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 30px rgba(15, 23, 42, 0.15);
  }

  .hover-pop {
    transition: transform 0.2s ease;
  }
  .hover-pop:hover {
    transform: scale(1.06);
  }

  .icon-bounce {
    transition: transform 0.25s ease;
  }
  .icon-bounce:hover {
    animation: bounce-icon 0.6s ease;
  }
  @keyframes bounce-icon {
    0%, 100% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-6px) scale(1.08); }
    60% { transform: translateY(0) scale(0.98); }
  }

  .pulse-ring {
    position: relative;
  }
  .pulse-ring::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.45);
    animation: pulse-ring 2.2s ease-out infinite;
    pointer-events: none;
  }
  @keyframes pulse-ring {
    0% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.45); }
    80% { box-shadow: 0 0 0 16px rgba(37, 99, 235, 0); }
    100% { box-shadow: 0 0 0 16px rgba(37, 99, 235, 0); }
  }
  .pulse-ring.whatsapp::after {
    box-shadow: 0 0 0 0 rgba(37, 197, 94, 0.45);
  }
  @keyframes pulse-ring-wa {
    0% { box-shadow: 0 0 0 0 rgba(37, 197, 94, 0.45); }
    80% { box-shadow: 0 0 0 16px rgba(37, 197, 94, 0); }
    100% { box-shadow: 0 0 0 16px rgba(37, 197, 94, 0); }
  }
  .pulse-ring.whatsapp::after { animation-name: pulse-ring-wa; }

  .float-anim {
    animation: float-anim 4s ease-in-out infinite;
  }
  @keyframes float-anim {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hover-lift, .hover-pop, .icon-bounce, .pulse-ring::after, .float-anim {
      animation: none !important;
      transition: none !important;
    }
  }

  /* --- Modal de confirmación de formularios (Contáctanos, Libro de Reclamaciones) --- */
  body.modal-open { overflow: hidden; }

  .form-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1rem;
    animation: form-modal-fade 0.2s ease;
  }
  .form-modal-backdrop[hidden] { display: none; }

  @keyframes form-modal-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .form-modal {
    position: relative;
    background: white;
    border-radius: 20px;
    padding: 2.5rem 2rem 2rem;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 25px 70px rgba(15, 23, 42, 0.3);
    animation: form-modal-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  @keyframes form-modal-pop {
    from { opacity: 0; transform: scale(0.9) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .form-modal-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    width: 0%;
    background: #16a34a;
    transition-property: width;
    transition-timing-function: linear;
  }
  .form-modal.is-error .form-modal-progress { display: none; }

  .form-modal-close {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: #f1f5f9;
    color: #64748b;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .form-modal-close:hover {
    background: #e2e8f0;
    color: #334155;
  }
  .form-modal-close svg { width: 14px; height: 14px; }

  .form-modal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 1.25rem;
    border-radius: 999px;
    animation: form-modal-icon-pop 0.35s ease 0.1s backwards;
  }
  .form-modal-icon svg path,
  .form-modal-icon svg line {
    stroke-dasharray: 28;
    stroke-dashoffset: 28;
    animation: form-modal-icon-draw 0.4s ease 0.25s forwards;
  }

  @keyframes form-modal-icon-pop {
    from { opacity: 0; transform: scale(0.5); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes form-modal-icon-draw {
    to { stroke-dashoffset: 0; }
  }

  .form-modal.is-success .form-modal-icon {
    background: #dcfce7;
    color: #16a34a;
  }
  .form-modal.is-error .form-modal-icon {
    background: #fee2e2;
    color: #dc2626;
  }

  .form-modal h3 {
    font-size: 1.3rem;
    color: #0f172a;
    margin-bottom: 0.6rem;
  }

  .form-modal p {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .form-modal-btn {
    width: 100%;
    justify-content: center;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #2563eb;
    color: white;
    border: none;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .form-modal-btn:hover { background: #1e40af; }

  @media (prefers-reduced-motion: reduce) {
    .form-modal-backdrop,
    .form-modal,
    .form-modal-icon,
    .form-modal-icon svg path,
    .form-modal-icon svg line {
      animation: none !important;
    }
    .form-modal-progress { transition: none !important; }
  }
</style>

<script>
  const loader = document.getElementById("page-loader");

  document.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement).closest("a");
    if (!link) return;
    const href = link.getAttribute("href");
    if (!href || href.startsWith("#") || href.startsWith("http") || link.target === "_blank") return;

    const [path, hash] = href.split("#");
    if (hash && (path === "" || path === window.location.pathname)) return;

    loader?.classList.add("active");
  });

  window.addEventListener("pageshow", () => {
    loader?.classList.remove("active");
  });

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("in-view");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
  );

  document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));
</script>