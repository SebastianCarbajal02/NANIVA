---
// Banner de /migracion-datos: texto, botones y checks a la izquierda; laptop de NANIVA a la derecha
// con el Excel entrando al sistema y una tarjeta de confianza. Es propio de esta página (no usa el Hero de producto).
import { Image } from 'astro:assets';
import { arrowIcon, checkIcon } from '@components/producto/icons';
import laptopImg from '@assets/image/migracion-datos/img-migracion-sin-fondo.png';

const whatsapp = `https://wa.me/51937292341?text=${encodeURIComponent('Hola, quiero migrar mis datos a NANIVA')}`;

const checks = [
  'Migración de Excel y otros sistemas',
  'Acompañamiento en todo el proceso',
  'Implementación rápida y segura',
];

const whatsappIcon = `<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.870 9.870 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.860 9.860 0 0 1-1.510-5.260c.001-5.450 4.436-9.884 9.888-9.884 2.640 0 5.122 1.030 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.450-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.050 0C5.495 0 .160 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.480-8.413Z"/></svg>`;
---

<section class="mg-hero">
  <div class="mg-hero-inner">
    <div class="mg-hero-content">
      <span class="mg-tag">Migración de datos</span>
      <h1>Cambia de sistema <span class="mg-accent">sin empezar de cero.</span></h1>
      <p class="mg-intro">
        En NANIVA adaptamos tus datos y plantillas existentes de Excel o de otros sistemas para que puedas empezar a
        gestionar tu negocio sin perder la información que ya tienes.
      </p>

      <div class="mg-actions">
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="mg-btn mg-btn-primary">
          Solicitar una demo gratuita <span set:html={arrowIcon} />
        </a>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="mg-btn mg-btn-whatsapp">
          <span class="mg-wa" set:html={whatsappIcon} />
          Contactar por WhatsApp
        </a>
      </div>

      <ul class="mg-checks">
        {checks.map((c) => (
          <li><span class="mg-check" set:html={checkIcon} /><span>{c}</span></li>
        ))}
      </ul>
    </div>

    <div class="mg-media">
      <div class="mg-excel" aria-hidden="true">
        <svg viewBox="0 0 64 56" width="64" height="56">
          <rect x="26" y="4" width="36" height="48" rx="3" fill="#fff" stroke="#1d6f42" stroke-width="2.5"/>
          <path d="M34 14h20M34 22h20M34 30h20M34 38h20M44 10v36" stroke="#1d6f42" stroke-width="2.5"/>
          <path d="M2 8 36 2v52L2 48Z" fill="#1d6f42"/>
          <path d="m11 18 14 20M25 18 11 38" stroke="#fff" stroke-width="5" stroke-linecap="round"/>
        </svg>
        <span class="mg-sheet"><i></i><i></i><i></i></span>
      </div>
      <svg class="mg-arrow" viewBox="0 0 90 56" fill="none" aria-hidden="true">
        <path d="M4 12c28-12 58-6 76 26" stroke="#2f8ef5" stroke-width="5" stroke-linecap="round"/>
        <path d="m64 40 17 0-3-17" stroke="#2f8ef5" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <Image
        src={laptopImg}
        alt="Laptop con el panel de control de NANIVA mostrando ventas, inventario y reportes"
        widths={[360, 560, 760, 1000, 1300]}
        sizes="(max-width: 900px) 90vw, 52vw"
        loading="eager"
        fetchpriority="high"
        class="mg-laptop"
      />
      <p class="mg-badge">Tu información,<br />en buenas manos.</p>
    </div>
  </div>
</section>

<style>
  .mg-hero {
    --ink: #0b1f4d;
    padding: 7.5rem clamp(1.5rem, 4vw, 4rem) 4rem;
    background:
      radial-gradient(34rem 24rem at 78% 40%, rgba(147, 197, 253, 0.38), transparent 70%),
      radial-gradient(22rem 18rem at 96% 90%, rgba(186, 215, 255, 0.45), transparent 70%),
      linear-gradient(135deg, #f4f9ff 0%, #e9f3ff 55%, #dfeeff 100%);
  }
  .mg-hero-inner {
    max-width: 1380px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 3rem;
  }
  .mg-hero-content { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }

  .mg-tag {
    display: inline-flex;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    background: #cdeee6;
    color: #0f6b5c;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .mg-hero h1 {
    max-width: 14em;
    margin: 0;
    color: var(--ink);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .mg-accent { display: block; color: #1d8cf8; }
  .mg-intro { max-width: 560px; margin: 0; color: #334155; font-size: 1.08rem; font-weight: 450; line-height: 1.7; }

  .mg-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 0.5rem; }
  .mg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.2s ease;
  }
  .mg-btn:hover { transform: translateY(-2px); }
  .mg-btn:active { transform: scale(0.98); }
  .mg-btn:focus-visible { outline: 3px solid #93c5fd; outline-offset: 3px; }
  .mg-btn :global(svg) { flex-shrink: 0; transition: transform 0.2s ease; }
  .mg-btn:hover :global(svg) { transform: translateX(3px); }
  .mg-btn-primary { background: #0b2a6b; color: #fff; }
  .mg-btn-primary:hover { background: #0a225a; }
  .mg-btn-whatsapp { padding: 0.8rem 1.4rem; border: 2px solid #8cc4f5; background: #fff; color: #0b6fd6; }
  .mg-btn-whatsapp:hover { background: #f0f7ff; border-color: #5aa9ee; }
  .mg-wa { display: inline-flex; color: #22c55e; }

  /* Checks bajo los botones */
  .mg-checks {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, max-content);
    gap: 1.5rem;
    margin: 1.2rem 0 0;
    padding: 0;
  }
  .mg-checks li { display: flex; align-items: center; gap: 0.7rem; max-width: 11rem; font-size: 0.9rem; line-height: 1.35; color: #334155; }
  .mg-check {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #cdeee6;
    color: #0f6b5c;
  }

  /* Laptop con el Excel entrando por la izquierda y la tarjeta de confianza */
  .mg-media { position: relative; justify-self: end; width: 100%; max-width: 780px; padding: 1.5rem 0 2rem 6rem; }
  .mg-laptop { display: block; width: 100%; height: auto; }
  .mg-excel {
    position: absolute;
    top: 14%;
    left: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.1rem 1.1rem 0.9rem;
    border-radius: var(--card-radius);
    background: #cdeee6;
    box-shadow: var(--card-shadow);
  }
  .mg-sheet { display: grid; gap: 5px; width: 54px; padding: 9px; border-radius: 6px; background: #fff; }
  .mg-sheet i { display: block; height: 4px; border-radius: 2px; background: #bfdbfe; }
  .mg-sheet i:nth-child(2) { width: 70%; }
  .mg-arrow { position: absolute; top: 20%; left: 5.2rem; z-index: 2; width: 70px; }
  .mg-badge {
    position: absolute;
    right: 0;
    bottom: 22%;
    z-index: 2;
    max-width: 9.5rem;
    margin: 0;
    padding: 0.9rem 1.15rem;
    border: var(--border-soft);
    border-radius: var(--card-radius);
    background: #fff;
    box-shadow: var(--card-shadow-hover);
    color: #0b4fb3;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.35;
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-btn, .mg-btn:hover { transform: none; }
  }
  @media (max-width: 1100px) {
    .mg-checks { grid-template-columns: 1fr; gap: 0.8rem; }
  }
  @media (max-width: 900px) {
    .mg-hero { padding: 6.5rem 1rem 3rem; }
    .mg-hero-inner { grid-template-columns: 1fr; gap: 2rem; }
    .mg-media { justify-self: center; padding-left: 3.5rem; }
    .mg-excel { transform: scale(0.75); transform-origin: top left; }
    .mg-arrow { left: 3.6rem; width: 52px; }
  }
  @media (max-width: 600px) {
    .mg-actions, .mg-btn { width: 100%; }
    .mg-media { padding-left: 0; }
    .mg-excel, .mg-arrow { display: none; }
    .mg-badge { bottom: 4%; padding: 0.6rem 0.8rem; font-size: 0.78rem; }
  }
</style>
