---
// Banner de cierre de /migracion-datos: ilustración b-migracion2 (servidor → nube NANIVA), texto y botones.
// Fondo azul: va después de la sección blanca de implementación; el panel del banner es celeste muy claro.
import { Image } from 'astro:assets';
import { arrowIcon } from '@components/producto/icons';
import artImg from '@assets/image/migracion-datos/b-migracion2.png';

const whatsapp = `https://wa.me/51937292341?text=${encodeURIComponent('Hola, quiero migrar mis datos a NANIVA')}`;

const whatsappIcon = `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.870 9.870 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.860 9.860 0 0 1-1.510-5.260c.001-5.450 4.436-9.884 9.888-9.884 2.640 0 5.122 1.030 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.450-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.050 0C5.495 0 .160 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.480-8.413Z"/></svg>`;
---

<section class="mg-cta">
  <div class="mg-wrap">
    <div class="mg-cta-panel reveal">
      {/* Líneas de circuito de fondo: decorativas */}
      <svg class="mg-cta-circuit" viewBox="0 0 400 240" aria-hidden="true">
        <path d="M400 30H330l-20 20h-60M400 70h-50l-15 15h-40M400 200h-80l-20-20h-50M400 160h-40l-12 12" />
        <circle cx="250" cy="50" r="3" /><circle cx="295" cy="85" r="3" /><circle cx="250" cy="180" r="3" /><circle cx="348" cy="172" r="3" />
      </svg>

      <div class="mg-cta-art">
        <Image
          src={artImg}
          alt="Servidor que envía datos a la nube de NANIVA, donde se convierten en reportes y archivos"
          widths={[320, 480, 640, 960, 1200]}
          sizes="(max-width: 700px) 90vw, 640px"
          loading="lazy"
          class="mg-cta-img"
        />
      </div>

      <div class="mg-cta-copy">
        <span class="mg-cta-eyebrow">DA EL SIGUIENTE PASO</span>
        <h2>Tu información ya tiene <span class="mg-hl">un nuevo hogar</span>.</h2>
        <p>Solicita una demo y descubre cómo NANIVA puede migrar tus datos de forma segura y sin complicaciones.</p>
      </div>

      <div class="mg-cta-actions">
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="mg-btn mg-btn-primary">
          Solicitar una demo gratuita <span set:html={arrowIcon} />
        </a>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="mg-btn mg-btn-outline">
          <span class="mg-wa" set:html={whatsappIcon} />
          Contactar por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .mg-cta { padding: clamp(3.5rem, 6vw, 6rem) 0; background: #f3f8ff; }
  /* Banner de cierre más angosto que las secciones de arriba */
  .mg-wrap { width: min(1440px, calc(100% - 3rem)); margin: 0 auto; }

  /* Panel de cierre: regla de bordes del sitio */
  .mg-cta-panel {
    position: relative;
    display: grid;
    /* La columna de la imagen mide lo que la imagen: el texto queda pegado a ella */
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 4rem);
    padding: clamp(1.25rem, 2vw, 2rem) clamp(1.75rem, 4vw, 4.5rem);
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    background: linear-gradient(120deg, #fdfeff 0%, #fafcff 55%, #f6f9ff 100%);
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }
  .mg-cta-circuit {
    position: absolute;
    top: 0;
    right: 0;
    width: 38%;
    height: 100%;
    fill: #bfdbfe;
    stroke: #bfdbfe;
    stroke-width: 1.5;
    pointer-events: none;
  }
  .mg-cta-circuit path { fill: none; }

  /* La ilustración llega al borde izquierdo del panel y sobresale un poco arriba y abajo (el panel la recorta) */
  .mg-cta-art {
    position: relative;
    justify-self: start;
    width: auto;
    margin: -0.75rem 0 -0.75rem calc(-1 * clamp(1.75rem, 4vw, 4.5rem));
  }
  /* El alto de la imagen marca el alto del banner: se limita para que no quede tan alto */
  .mg-cta-img { display: block; width: auto; max-width: 100%; height: auto; max-height: 330px; }

  .mg-cta-copy { position: relative; }
  .mg-cta-eyebrow { color: #0b6fd6; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.06em; }
  .mg-cta-copy h2 {
    max-width: 16em;
    margin: 0.5rem 0 0.85rem;
    font-size: clamp(1.8rem, 1.2rem + 1.8vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #0b1f4d;
  }
  .mg-hl { color: #1d8cf8; }
  .mg-cta-copy p { max-width: 30rem; margin: 0; color: #1e293b; font-size: 1.08rem; line-height: 1.6; }

  .mg-cta-actions { position: relative; display: flex; flex-direction: column; gap: 1rem; }
  .mg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 54px;
    padding: 0.9rem 1.8rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.2s ease;
  }
  .mg-btn:hover { transform: translateY(-2px); }
  .mg-btn:focus-visible { outline: 3px solid #93c5fd; outline-offset: 3px; }
  .mg-btn :global(svg) { flex-shrink: 0; transition: transform 0.2s ease; }
  .mg-btn-primary { background: #0b1f4d; color: #fff; }
  .mg-btn-primary:hover { background: #0b2a6b; }
  .mg-btn-primary:hover :global(svg) { transform: translateX(3px); }
  .mg-btn-outline { border: 2px solid #0b1f4d; background: #fff; color: #0b1f4d; }
  .mg-btn-outline:hover { background: #f0f7ff; }
  .mg-wa { display: inline-flex; color: #0b1f4d; }

  @media (prefers-reduced-motion: reduce) {
    .mg-btn, .mg-btn:hover { transform: none; }
  }
  @media (max-width: 1100px) {
    .mg-cta-panel { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    .mg-cta-actions { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; justify-content: center; }
  }
  @media (max-width: 700px) {
    .mg-cta-panel { grid-template-columns: 1fr; text-align: center; padding: 1.75rem 1.1rem; }
    .mg-cta-art { width: 100%; max-width: 420px; margin: 0 auto; justify-self: center; }
    .mg-cta-copy h2, .mg-cta-copy p { margin-left: auto; margin-right: auto; }
    .mg-cta-actions { flex-direction: column; }
    .mg-btn { width: 100%; white-space: normal; }
    .mg-cta-circuit { display: none; }
  }
</style>
