---
import heroBg from '../assets/image/home/hero/fondo final1-01.webp';
import banner34 from '../assets/image/IA/hero/ia-banner.webp';
import iconDecisiones from '../assets/image/IA/hero/icono-decisiones.webp';
import iconVentas from '../assets/image/IA/hero/icono-ventas.webp';
import iconCompras from '../assets/image/IA/hero/icono-compras.webp';
import iconInventario from '../assets/image/IA/hero/icono-inventario.webp';

const features = [
  { icon: iconDecisiones, label: "Desiciones más rápidas" },
  { icon: iconVentas, label: "Ventas en crecimiento" },
  { icon: iconCompras, label: "Compras inteligentes" },
  { icon: iconInventario, label: "Inventario bajo control" },
];
---
<section class="hero-ia-section hero-ia-crop" style={`background-image: url('${heroBg.src}');`}>
  <div class="content reveal">
    <span class="tag">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2a3.5 3.5 0 0 0-3.5 3.5v.6A3 3 0 0 0 4 9v1a3 3 0 0 0 1 2.24V15a3 3 0 0 0 3 3h.5v2a1 1 0 0 0 1 1h1V4.5A2.5 2.5 0 0 1 9.5 2Z" /><path d="M14.5 2a3.5 3.5 0 0 1 3.5 3.5v.6A3 3 0 0 1 20 9v1a3 3 0 0 1-1 2.24V15a3 3 0 0 1-3 3h-.5v2a1 1 0 0 1-1 1h-1V4.5A2.5 2.5 0 0 0 14.5 2Z" /></svg>
      IA QUE TRABAJA POR TI
    </span>
    <h1>Convierte tus datos<br />en <span class="highlight">desiciones</span></h1>
    <p>Plataforma inteligente que centraliza ventas, compras e inventario para impulsar tu negocio con IA</p>

    <div class="features">
      {features.map((f) => (
        <div class="feature">
          <span class="feature-icon"><img src={f.icon.src} alt={f.label} /></span>
          <span class="feature-label">{f.label}</span>
        </div>
      ))}
    </div>

    <div class="hero-actions">
      <a href="https://wa.link/fogrsn" target="_blank" rel="noopener noreferrer" class="btn-primary hover-pop">
        Solicita una demo
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
      </a>
      <a href="https://wa.link/d99odw" target="_blank" rel="noopener noreferrer" class="btn-dark hover-pop">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="m10 8 6 4-6 4V8Z" fill="currentColor" stroke="none" /></svg>
        DEMOSTRACIÓN DE IA<br />EN TU EMPRESA
      </a>
    </div>
  </div>

  <img src={banner34.src} alt="Banner IA Naniva" class="hero-visual-img" />
</section>

<style>
  .hero-ia-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 7rem 2rem 2rem 6rem;
  }

  .hero-ia-crop {
    overflow: hidden;

  }

  .content {
    position: relative;
    z-index: 2;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 1rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.3);
    color: #2563eb;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
  }

  h1 {
    font-size: clamp(2.4rem, 3.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
  }
  .highlight {
    color: #2563eb;
  }

  p {
    font-size: 1.05rem;
    font-weight: 500;
    color: #475569;
    line-height: 1.7;
    max-width: 480px;
  }

  .features {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }
  .feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    width: 100px;
    text-align: center;
  }
  .feature-icon {
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid transparent;
    border-radius: 16px;
    transition: transform 0.25s ease, border-color 0.25s ease, filter 0.25s ease;
  }
  .feature:hover .feature-icon {
    transform: translateY(-4px) scale(1.08);
    border-color: #2563eb;
    filter: brightness(1.35);
  }
  .feature-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .feature-label {
    font-size: 1rem;
    font-weight: 600;
    color: #1e293b;
    line-height: 1.3;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #1d4ed8, #2563eb);
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .btn-dark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #0b1220, #16233d);
    color: white;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    line-height: 1.3;
    padding: 0.8rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .hero-visual-img {
    position: absolute;
    right: -0.5%;
    bottom: 0;
    height: 95vh;
    width: auto;
    object-fit: contain;
    z-index: 1;
    pointer-events: none;
    transform: translateY(-0rem);
  }

  @media (max-width: 1100px) {
    .hero-visual-img { display: none; }
    .content { max-width: 100%; }
  }

  @media (max-width: 900px) {
    .hero-ia-section { padding: 6rem 1.5rem 2rem; }
  }

  @media (max-width: 768px) {
    .hero-ia-section {
      background-position: 70% center;
      min-height: auto;
      padding: 6.5rem 1rem 2.5rem;
    }
    .content { align-items: center; text-align: center; }
    .features { justify-content: center; flex-wrap: wrap; }
    .hero-actions { justify-content: center; }
  }

  @media (max-width: 640px) {
    .features { gap: 1rem; }
    .feature { width: 72px; }
    .feature-icon { width: 52px; height: 52px; }
    .btn-dark { text-align: left; }
  }
    @media (max-width: 480px) {

    .content > p { order: 1; }
    .content > .hero-actions { order: 2; }
    .content > .features { order: 3; }

    .features {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      width: 100%;
      justify-items: center;
      transform: translateY(4rem);
    }
    .feature { width: 100%; }
    .feature-icon { width: 70px; height: 70px; }

    .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #1d4ed8, #2563eb);
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.8rem 4rem;
    border-radius: 10px;
    text-decoration: none;
    width: 80%;
    transform: translateY(4rem);
  }
  .btn-dark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #0b1220, #16233d);
    color: white;
    font-weight: 700;
    font-size: 0.8rem;
    line-height: 1.2;
    padding: 0.8rem 1.8rem;
    border-radius: 10px;
    text-decoration: none;
    width: 80%;
    transform: translateY(4rem);
  }
  .hero-ia-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 0.5rem;
  }

  .hero-visual-img {
    display: block;
    position: static;
    width: 100%;
    max-width: 320px;
    height: auto;
    margin: 1.5rem auto 0;
    transform: none;
    -webkit-mask-image: linear-gradient(to bottom, black 75%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 75%, transparent 105%);
  }
    h1 {
    font-size: clamp(2.4rem, 3.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    transform: translateY(4rem);

  }
  p {
    font-size: 1.05rem;
    font-weight: 500;
    color: #475569;
    line-height: 1.7;
    max-width: 480px;
    transform: translateY(4rem);
  }
   .feature-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #1e293b;
    line-height: 1.3;
  }

    }
</style>
