---
import { Image } from 'astro:assets';
import banerImg from '@assets/image/home/why-naniva/baner1-02-02.webp';
---
<section id="por-que-naniva" class="why-naniva">
  <div class="container">
    <a href="https://wa.me/51937292341?text=%F0%9F%91%8B%20%C2%A1Hola!%20Me%20gustar%C3%ADa%20solicitar%20una%20demostraci%C3%B3n%20de%20la%20plataforma%20Naniva.%20%F0%9F%9A%80%20Quisiera%20conocer%20sus%20funcionalidades%20y%20c%C3%B3mo%20puede%20ayudar%20a%20optimizar%20la%20gesti%C3%B3n%20de%20mi%20empresa" target="_blank" class="why-naniva-link">
      <Image src={banerImg} alt="¿Por qué elegir Naniva? Una plataforma diseñada para que tu empresa sea más eficiente, segura y rentable." class="why-naniva-img reveal hover-lift"  widths={[640, 1024, 1440, 1920]} sizes="100vw" />
    </a>
  </div>
</section>

<style>
  .why-naniva {
    padding: 3rem 0;
    background: #f8fafc;
  }
  .why-naniva .container {
    max-width: 1770px;
  }
  .why-naniva-link {
    display: inline-block;
    width: 100%;
    text-decoration: none;
    cursor: pointer;
  }
  .why-naniva-img {
    display: block;
    width: 99%;
    height: auto;
    margin-left: auto;
    border-radius: var(--radius);
    box-shadow: 0 0 20px rgba(37, 99, 235, 0.35), 0 0 45px rgba(37, 99, 235, 0.2);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .why-naniva-link:hover .why-naniva-img {
    transform: scale(1.015);
    box-shadow: 0 0 25px rgba(37, 99, 235, 0.7), 0 0 60px rgba(37, 99, 235, 0.5);
  }
  @media (max-width: 480px) {
    .why-naniva { display: none; }
  }
</style>