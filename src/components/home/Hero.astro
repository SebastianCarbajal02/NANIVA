---
// Banner de inicio: texto, botones y módulos a la izquierda sobre fondo claro; a la derecha la foto de los
// equipos con NANIVA (laptop, celular y tablet), un arco azul detrás y la nota "Todo integrado en un solo sistema".
import { Image } from 'astro:assets';
import foto from '@assets/image/home/hero/diseño-mejorado.webp';

const svg = (paths: string, size = 24) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

const ico = {
  store: '<path d="M3 9 4.5 4h15L21 9"/><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/><path d="M5 12v9h14v-9"/><path d="M9 21v-5h3v5M14.5 14h2.5v3h-2.5z"/>',
  cart: '<circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 7H6"/>',
  bars: '<path d="M4 20h16"/><path d="M6 20v-5M10 20V10M14 20v-7M18 20V5"/>',
  invoice: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M12 11v7M14 12.5h-2.5a1.25 1.25 0 0 0 0 2.5h1a1.25 1.25 0 0 1 0 2.5H10"/>',
  brain: '<path d="M9.5 3a3 3 0 0 0-3 3 3 3 0 0 0-2 5.2A3 3 0 0 0 6 16.5 3 3 0 0 0 9.5 21H12V3Z"/><path d="M14.5 3a3 3 0 0 1 3 3 3 3 0 0 1 2 5.2 3 3 0 0 1-1.5 5.3 3 3 0 0 1-3.5 4.5H12V3Z"/><path d="M9 8h1.5M8 12.5h2M9.5 17H11M15 8h-1.5M16 12.5h-2M14.5 17H13"/>',
  box: '<path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="m3 8 9 5 9-5M12 13v8"/>',
};

const features = [
  { icon: ico.store, label: 'Punto de Venta (POS)' },
  { icon: ico.cart, label: 'Ecommerce' },
  { icon: ico.bars, label: 'Reportes Inteligentes' },
  { icon: ico.invoice, label: 'Facturación Electrónica' },
  { icon: ico.brain, label: 'IA Empresarial' },
  { icon: ico.box, label: 'ERP' },
];

const cloudIcon = `<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.5 19H8a6 6 0 1 1 5.7-7.9A4.5 4.5 0 1 1 17.5 19Z"/></svg>`;
const calendarIcon = svg('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>', 20);
const playIcon = `<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="m10 8 6 4-6 4Z" fill="#fff"/></svg>`;
---

<section class="hero">

  <div class="hero-content">
    <span class="hero-tag"><span set:html={cloudIcon} />Plataforma todo en uno</span>
    <h1>La plataforma <span class="hero-accent">inteligente</span> para hacer crecer<br /> tu empresa.</h1>
    <p class="hero-intro">
      Administra ventas, inventario, facturación electrónica, ecommerce e inteligencia artificial{' '}
      <span class="hero-intro-accent">desde una sola plataforma</span>.
    </p>

    <div class="hero-actions">
      <a href="/solicitar-demo" class="hero-btn hero-btn-primary">
        <span set:html={calendarIcon} />
        Solicitar demostración
      </a>
      <a href="#demo" class="hero-btn hero-btn-outline">
        <span class="hero-play" set:html={playIcon} />
        Ver cómo funciona
      </a>
    </div>

    <ul class="hero-features">
      {features.map((f) => (
        <li>
          <span class="hero-feature-icon" set:html={svg(f.icon, 40)} />
          <span class="hero-feature-label">{f.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="hero-visual">
    <Image
      src={foto}
      alt="Laptop, celular y tablet mostrando el dashboard de NANIVA sobre un escritorio"
      class="hero-photo"
      widths={[640, 960, 1280, 1600, 1902]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />

    <p class="hero-note">
      Todo integrado<br />en un solo sistema
      <svg viewBox="0 0 120 40" fill="none" aria-hidden="true">
        <path d="M112 6 C 96 28, 60 34, 14 30" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        <path d="m24 20-12 10 13 8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </p>
  </div>
</section>

<style>
  .hero {
    --ink: #0b1f4d;
    --blue: #1d6ff2;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: max(700px, min(100vh, 52vw));
    padding: 7rem clamp(1.5rem, 4vw, 5rem) 3rem;
    overflow: hidden;
    background: #eef4fd;
  }

  /* Foto de los equipos a la derecha, en su proporción y apoyada abajo; los bordes izquierdo y superior
     se funden con el fondo claro. Las tarjetas se ubican en % de la foto, así siempre caen sobre los equipos */
  .hero-photo {
    display: block;
    width: 100%;
    height: auto;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 30%),
      linear-gradient(180deg, transparent 0%, #000 16%, #000 78%, transparent 100%);
    mask-composite: intersect;
  }
  /* Arco azul detrás de la franja de las tarjetas, como en el diseño */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -2;
    width: 70vw;
    height: 70vw;
    top: -38vw;
    right: -16vw;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 70%, rgba(147, 197, 253, 0.55) 0%, rgba(59, 130, 246, 0.45) 55%, rgba(29, 78, 216, 0.55) 100%);
    pointer-events: none;
  }

  .hero-content { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; max-width: min(620px, 44vw); }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1.1rem;
    border: 1px solid #bfd6fb;
    border-radius: 999px;
    background: #e3eeff;
    color: #1a5fd6;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero-tag :global(svg) { flex: none; }

  .hero h1 { margin: 0; color: var(--ink); font-weight: 700; line-height: 1.08; letter-spacing: -0.02em; }
  .hero-accent { display: block; color: var(--blue); }
  .hero-intro { max-width: 34rem; margin: 0; color: #334a73; font-size: 1.08rem; font-weight: 600; line-height: 1.6; }
  .hero-intro-accent { color: #1a5fd6; font-weight: 700; }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.4rem; }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 3.5rem;
    padding: 0.85rem 1.8rem;
    border-radius: 16px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }
  .hero-btn:hover { transform: translateY(-2px); }
  .hero-btn:active { transform: scale(0.98); }
  .hero-btn:focus-visible { outline: 3px solid #93c5fd; outline-offset: 3px; }
  .hero-btn :global(svg) { flex: none; }
  .hero-btn-primary { background: linear-gradient(90deg, #1764e8, #2f7cf6); color: #fff; box-shadow: 0 10px 24px rgba(29, 111, 242, 0.28); }
  .hero-btn-primary:hover { box-shadow: 0 14px 30px rgba(29, 111, 242, 0.34); }
  .hero-btn-outline { border: 2px solid var(--blue); background: rgba(255, 255, 255, 0.9); color: var(--ink); }
  .hero-btn-outline:hover { background: #fff; }
  .hero-play { display: inline-flex; color: #1a5fd6; }

  /* Módulos: tarjetas blancas con ícono azul y el nombre debajo */
  .hero-features {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(0.5rem, 1vw, 1rem);
    width: 100%;
    margin: 1.4rem 0 0;
    padding: 0;
  }
  .hero-features li { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; text-align: center; }
  .hero-feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 88px;
    aspect-ratio: 1;
    border: var(--border-soft);
    border-radius: var(--card-radius);
    background: rgba(255, 255, 255, 0.95);
    box-shadow: var(--card-shadow);
    color: #1a5fd6;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hero-features li:hover .hero-feature-icon { transform: translateY(-2px); box-shadow: var(--card-shadow-hover); }
  .hero-feature-icon :global(svg) { width: 46%; height: auto; }
  .hero-feature-label { color: var(--ink); font-size: 0.85rem; font-weight: 600; line-height: 1.3; }

  /* Foto de los equipos en la mitad derecha del banner, con la nota encima */
  .hero-visual { position: absolute; right: -3%; bottom: 7%; z-index: 1; width: 76%; }
  .hero-note {
    position: absolute;
    right: 5%;
    bottom: 3%;
    margin: 0;
    color: #1a5fd6;
    font-family: 'Segoe Print', 'Bradley Hand', 'Comic Sans MS', cursive;
    font-size: clamp(1rem, 1.25vw, 1.3rem);
    font-weight: 700;
    line-height: 1.3;
    transform: rotate(-6deg);
    text-shadow: 0 1px 8px rgba(255, 255, 255, 0.9);
  }
  .hero-note svg { display: block; width: 6rem; margin: 0.3rem 0 0 auto; }

  @media (prefers-reduced-motion: reduce) {
    .hero-btn:hover, .hero-features li:hover .hero-feature-icon { transform: none; }
  }

  /* Pantallas medianas: la foto un poco más chica para que la laptop no quede debajo del texto */
  @media (max-width: 1500px) {
    .hero-visual { width: 70%; }
  }
  @media (max-width: 1280px) {
    .hero-visual { width: 66%; }
  }

  /* Tablet y celular: texto arriba y la foto completa debajo */
  @media (max-width: 1024px) {
    .hero { flex-direction: column; align-items: stretch; gap: 1.5rem; min-height: 0; padding: 6.5rem 1rem 2.5rem; background: linear-gradient(180deg, #f5f9ff 0%, #eaf2ff 100%); }
    .hero::before { display: none; }
    .hero-content { max-width: 640px; }
    .hero-visual { position: static; width: auto; }
    .hero-photo { height: auto; mask-image: none; border-radius: var(--card-radius); }
    .hero-note { display: none; }
  }
  @media (max-width: 600px) {
    .hero-features { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.1rem; }
    .hero-actions, .hero-btn { width: 100%; }
  }
</style>
