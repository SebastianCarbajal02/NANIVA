---
// Casos de éxito: una tarjeta por cliente con su logo, rubro, resumen, dos resultados y el enlace al caso completo
import { Image } from 'astro:assets';
import { arrowIcon } from '@components/producto/icons';
import { casos } from '@data/casos-exito';

const svg = (paths: string) =>
  `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

// Iconos de los resultados, por el nombre que usa la lista de casos
const iconos: Record<string, string> = {
  trend: svg('<path d="m22 7-8.5 8.5-5-5L2 17"/><path d="M16 7h6v6"/>'),
  clock: svg('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'),
  bolt: svg('<path d="M13 2 4 14h7l-1 8 9-12h-7Z"/>'),
  headset: svg('<path d="M3 13a9 9 0 0 1 18 0"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M19 19v1a3 3 0 0 1-3 3h-2"/>'),
};
---

<section class="ce-casos">
  <div class="ce-casos-inner">
    <div class="ce-casos-head">
      <div class="ce-casos-eyebrow-row reveal"><span class="ce-casos-eyebrow">NUESTROS CLIENTES</span></div>
      <h2 class="reveal" style="--d: 60ms">
        Casos de éxito que <span class="ce-casos-hl">inspiran<svg viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 10C60 3 140 2 197 8" /></svg></span>
      </h2>
      <p class="reveal" style="--d: 120ms">
        Conoce cómo diferentes empresas han optimizado sus procesos, mejorado su control y hecho crecer su negocio con NANIVA.
      </p>
    </div>

    {/* Cinta que se desliza sola: la lista va dos veces para que el giro no tenga cortes; la copia no se lee ni se enfoca */}
    <div class="ce-carrusel reveal" style="--d: 180ms">
    <div class="ce-casos-track">
    {[0, 1].map((copia) => (
    <ul class="ce-casos-lista" aria-hidden={copia === 1 ? 'true' : undefined} inert={copia === 1}>
      {casos.map((c) => (
        <li class="ce-caso">
          <div class="ce-caso-top">
            <div class="ce-caso-logo">
              <Image src={c.avatar} alt={`Logo de ${c.nombre}`} widths={[240, 480]} sizes="240px" class="ce-caso-logo-img" />
            </div>
          </div>

          <div class="ce-caso-body">
            {/* Rubro y año desde que trabajan con NANIVA */}
            <ul class="ce-caso-tags">
              <li>{c.meta[0].text}</li>
              <li>{c.meta[3].text}</li>
            </ul>
            <h3>{c.nombre}</h3>
            <p>{c.quote}</p>
          </div>

          <ul class="ce-caso-resultados">
            {c.results.map((r) => (
              <li>
                <span class="ce-caso-res-icon" set:html={iconos[r.icon]} />
                <span class="ce-caso-res-text">
                  <strong>{r.value}</strong>
                  <span>{r.label}</span>
                </span>
              </li>
            ))}
          </ul>

          <a href="#" class="ce-caso-link">Leer caso completo <span set:html={arrowIcon} /></a>
        </li>
      ))}
    </ul>
    ))}
    </div>
    </div>
  </div>
</section>

<style>
  .ce-casos {
    --ink: #0b1f4d;
    position: relative;
    padding: clamp(3.5rem, 6vw, 6rem) 1rem;
    overflow: hidden;
    background: linear-gradient(180deg, #f3f8ff 0%, #f8fbff 100%);
  }
  /* Manchas celestes en las esquinas superiores */
  .ce-casos::before,
  .ce-casos::after {
    content: "";
    position: absolute;
    z-index: 0;
    border-radius: 50%;
    background: #d6e9fd;
    opacity: 0.7;
    pointer-events: none;
  }
  .ce-casos::before { top: -160px; left: -140px; width: 420px; height: 340px; transform: rotate(-20deg); }
  .ce-casos::after { top: -40px; right: -160px; width: 380px; height: 300px; transform: rotate(-35deg); }
  .ce-casos-inner { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; }
  .ce-casos-head { max-width: 44rem; margin: 0 auto 2.5rem; text-align: center; }

  /* Etiqueta con una línea fina a cada lado */
  .ce-casos-eyebrow-row { display: flex; align-items: center; justify-content: center; gap: 1.25rem; }
  .ce-casos-eyebrow-row::before,
  .ce-casos-eyebrow-row::after { content: ""; flex: 0 1 180px; height: 1px; background: #93c5fd; }

  .ce-casos-eyebrow {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: #e8f0ff;
    color: #1d4ed8;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .ce-casos h2 {
    margin: 0.7rem 0 0.5rem;
    font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  /* "inspiran" en azul con un trazo curvo debajo */
  .ce-casos-hl { position: relative; display: inline-block; color: #1d8cf8; }
  .ce-casos-hl svg {
    position: absolute;
    left: 0;
    bottom: -0.22em;
    width: 100%;
    height: 0.3em;
    fill: none;
    stroke: #1d8cf8;
    stroke-width: 3;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .ce-casos-head p { margin: 0 auto; color: #475569; font-size: 1rem; line-height: 1.6; }

  /* Cinta: se desliza sola de derecha a izquierda, se desvanece en los bordes y se detiene con el mouse encima */
  .ce-carrusel {
    margin: 0 -1rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .ce-casos-track { display: flex; width: max-content; animation: ce-deslizar 60s linear infinite; }
  .ce-carrusel:hover .ce-casos-track,
  .ce-carrusel:focus-within .ce-casos-track { animation-play-state: paused; }
  /* El padding deja ver la sombra y la subida del hover; el de la derecha separa la copia */
  .ce-casos-lista { display: flex; gap: 1.5rem; margin: 0; padding: 0.5rem 1.5rem 1rem 0; list-style: none; }
  @keyframes ce-deslizar {
    to { transform: translateX(-50%); }
  }
  .ce-caso {
    flex: 0 0 360px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--border-soft);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    background: #fff;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .ce-caso:hover { transform: translateY(-2px); box-shadow: var(--card-shadow-hover); }


  /* Logo del cliente directo sobre la tarjeta, centrado */
  .ce-caso-top { display: flex; justify-content: center; padding: 1.5rem 1.5rem 0; }
  .ce-caso-logo { display: flex; align-items: center; justify-content: center; width: 240px; height: 130px; }
  .ce-caso-logo-img { width: 100%; height: 100%; object-fit: contain; }

  .ce-caso-body { padding: 1.25rem 1.5rem 1.25rem; }
  .ce-caso-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 0.9rem; padding: 0; list-style: none; }
  .ce-caso-tags li {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: #e8f1ff;
    color: #1d4ed8;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .ce-caso h3 { margin: 0 0 0.5rem; color: var(--ink); font-size: 1.25rem; font-weight: 700; line-height: 1.25; }
  .ce-caso-body p { margin: 0; color: #475569; font-size: 0.95rem; line-height: 1.6; }

  /* Franja de resultados: dos datos separados por una línea fina */
  .ce-caso-resultados {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: auto 1rem 0;
    padding: 1rem 0;
    border-radius: 12px;
    background: #f0f7ff;
    list-style: none;
  }
  .ce-caso-resultados li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0 0.75rem;
  }
  .ce-caso-resultados li + li { border-left: 1px solid rgba(148, 163, 184, 0.35); }
  .ce-caso-res-icon { display: inline-flex; flex-shrink: 0; color: #1d6ff2; }
  .ce-caso-res-text { display: flex; flex-direction: column; color: #1e3a8a; font-size: 0.85rem; line-height: 1.35; }
  .ce-caso-res-text strong { color: var(--ink); font-size: 1.25rem; font-weight: 700; line-height: 1.2; }

  .ce-caso-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    color: #1d4ed8;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }
  .ce-caso-link :global(svg) { transition: transform 0.2s ease; }
  .ce-caso-link:hover :global(svg) { transform: translateX(3px); }
  .ce-caso-link:focus-visible { outline: 3px solid #93c5fd; outline-offset: -3px; }

  /* Sin animación: la cinta se mueve a mano con desplazamiento horizontal, sin la copia */
  @media (prefers-reduced-motion: reduce) {
    .ce-caso:hover { transform: none; }
    .ce-carrusel { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .ce-casos-track { animation: none; }
    .ce-casos-lista[aria-hidden='true'] { display: none; }
  }
  @media (max-width: 680px) {
    .ce-caso { flex-basis: 290px; }
    .ce-casos-lista { gap: 1rem; padding-right: 1rem; }
  }
</style>
