---
import { Image } from 'astro:assets';
import banner from '../assets/image/contacto/fondo contactanos-01.webp';
import personaImg from '../assets/image/contacto/contactanos persona-02.webp';
import logo from '../assets/image/shared/logos/logo.webp';
import iconAcompanamiento from '../assets/image/contacto/iconcontc-02.png';
import iconSoluciones from '../assets/image/contacto/iconcontc-03.png';
import iconRespuesta from '../assets/image/contacto/iconcontc-04.png';
import iconAtencion from '../assets/image/contacto/iconcontc-05.png';

const bannerFeatures = [
  { icon: iconAtencion, title: "Atención personalizada", desc: "Asesoría 1 a 1 con nuestros expertos." },
  { icon: iconRespuesta, title: "Respuesta rápida", desc: "Te respondemos en menos de 5 minutos." },
  { icon: iconSoluciones, title: "Soluciones a medida", desc: "Implementamos la mejor solución para tu negocio." },
  { icon: iconAcompanamiento, title: "Acompañamiento total", desc: "Desde la implementación hasta el crecimiento." },
];
---
<section class="banner" style={`background-image: url('${banner.src}');`}>
  <Image src={personaImg} alt="Contacto persona" class="banner-persona" aria-hidden="true" loading="eager" widths={[600, 1200, 1800, 2400]} sizes="60vw" />
  <div class="content reveal">
    <h1>Contáctanos y<br /><span class="highlight">Digitaliza</span> tu Negocio</h1>
    <p class="banner-subtitle">Nuestro equipo de expertos está listo para responder todas tus dudas y ayudar a implementar la mejor solución para tu empresa.</p>
    <div class="banner-actions">
      <a href="https://wa.me/51908644190" target="_blank" rel="noopener noreferrer" class="btn-primary hover-pop pulse-ring whatsapp">Escríbenos Ahora</a>
    </div>
    <div class="banner-features">
      <div class="banner-feature">
        <span class="banner-feature-icon banner-feature-icon-1 icon-bounce"><Image src={bannerFeatures[0].icon} alt={bannerFeatures[0].title} /></span>
        <h4>{bannerFeatures[0].title}</h4>
        <p class="feature-desc">{bannerFeatures[0].desc}</p>
      </div>
      <div class="banner-feature">
        <span class="banner-feature-icon banner-feature-icon-2 icon-bounce"><Image src={bannerFeatures[1].icon} alt={bannerFeatures[1].title} /></span>
        <h4>{bannerFeatures[1].title}</h4>
        <p class="feature-desc">{bannerFeatures[1].desc}</p>
      </div>
      <div class="banner-feature">
        <span class="banner-feature-icon banner-feature-icon-3 icon-bounce"><Image src={bannerFeatures[2].icon} alt={bannerFeatures[2].title} /></span>
        <h4>{bannerFeatures[2].title}</h4>
        <p class="feature-desc">{bannerFeatures[2].desc}</p>
      </div>
      <div class="banner-feature">
        <span class="banner-feature-icon banner-feature-icon-4 icon-bounce"><Image src={bannerFeatures[3].icon} alt={bannerFeatures[3].title} /></span>
        <h4>{bannerFeatures[3].title}</h4>
        <p class="feature-desc">{bannerFeatures[3].desc}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .banner {
    position: relative;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 8rem 2rem 2rem 5rem;
  }

  .banner-persona {
    position: absolute;
    right: 0rem;
    bottom: 0;
    max-width: 60%;
    height: 100vh;
    object-fit: contain;
    z-index: 1;
    pointer-events: none;
    transform: translateY(1rem);
  }

  .content {
    max-width: 540px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.65rem;
  }
  .banner-actions {
    width: 100%;
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    transform: translateY(-2rem);
  }
  .btn-primary {
    background: #2563eb;
    color: white;
    padding: 0.85rem 1.5rem;
    border-radius: 5px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    white-space: nowrap;
  }
  .btn-outline {
    background: white;
    color: #2563eb;
    border: 1px solid #2563eb;
    padding: 0.85rem 1.5rem;
    border-radius: 5px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    white-space: nowrap;
  }
  .banner-features {
    width: 140%;
    display: flex;
    gap: 1rem;
    gap: 4rem;
    transform: translateY(3rem);
  }
  .banner-feature {
    flex: 2;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap:0rem;
  }
  .banner-feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .banner-feature-icon img {
    width: 120px;
    height: 120px;
    object-fit: contain;
    padding-left:2rem;
    margin-bottom: 1rem;
    margin-left: 3rem;
  }

  .banner-feature-icon-1 img,
  .banner-feature-icon-4 img {
    width: 140px;
    height: 140px;
    margin-left: 4rem;
  }

  .banner-feature-icon:hover img {
    transform: scale(1.15);
    transition: transform 0.3s ease;
  }

  .banner-feature h4 {
    font-size: 1rem;
    color: #0f172a;
    line-height: 2;
    width: 180%;
    
    
  }
  .banner-feature p.feature-desc {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 500;
    line-height: 1.4;
     width: 120%;
  }
  .logo {
    height: 92px;
    width: auto;
    object-fit: contain;
    transform: translateY(-7rem);
  }
  h1 {
    font-size: clamp(3rem, 3.5vw, 4rem);
    font-weight: 798;
    line-height: 1.15;
    color: #0f172a;
    transform: translateY(-5rem);
  }
  .highlight { color: #007bff; }
  .banner-subtitle {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    color: #475569;
    transform: translateY(-3.5rem);
  }
  @media (max-width: 1368px) and (min-width: 606px) {

     .banner-persona {
    position: absolute;
    right: 0rem;
    bottom: 0;
    max-width: 55%;
    height: 90vh;
    object-fit: contain;
    z-index: 1;
    pointer-events: none;
    transform: translateY(-0.3rem);
  }

  .content {
    max-width: 490px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.3rem;
  }
  h1 {
    font-size: clamp(3rem, 3.5vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    transform: translateY(-2rem);
  }
  .banner-subtitle {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    color: #475569;
    transform: translateY(-1rem);
  }
  .btn-primary {
    background: #2563eb;
    color: white;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    white-space: nowrap;
    transform: translateY(2rem);
  }
  .btn-outline {
    font-size: 1rem;
    white-space: nowrap;
    transform: translateY(2rem);
  }
  .banner-features{
    width: 140%;
    display: flex;
    transform: translate(-1rem, 3rem);
}
    }
  @media (max-width: 900px) {
    .banner { padding-left: 1.5rem; }
  }
  @media (max-width: 768px) {
    .banner {
      background-position: 70% center;
      height: auto;
      min-height: 100vh;
      overflow: visible;
      padding: 6.5rem 1rem 2rem;
    }
    .content {
      max-width: 100%;
      padding: 1.5rem;
      border-radius: var(--radius);
      gap: 1rem;
    }
    .logo { transform: none; height: 60px; }
    h1 { transform: none; font-size: clamp(1.8rem, 7vw, 2.4rem); }
    .banner-subtitle { transform: none; font-size: 0.9rem; }
    .banner-actions { transform: none; }
    .btn-primary, .btn-outline { flex: 1 1 auto; justify-content: center; text-align: center; }
    .banner-features { flex-wrap: wrap; }
    .banner-feature { flex: 1 1 calc(50% - 0.5rem); }
    .banner-feature h4 { white-space: normal; }
  }

  /* Fix: 4th feature (Acompañamiento total) was hidden behind .banner-persona
     from 769px up (width:140% + wide icon margins overflowed past the content column).
     Kept as a single row but sized to fit inside .content instead of overflowing under the image. */
  @media (min-width: 769px) {
    .content { max-width: 44%; }
    .banner-features {
      width: 100%;
      flex-wrap: nowrap;
      gap: 0.6rem;
      margin-top: 1.5rem;
      transform: none;
    }
    .banner-feature {
      flex: 1 1 0;
      min-width: 0;
      align-items: center;
      text-align: center;
    }
    .banner-feature-icon {
      width: 64px;
      height: 64px;
    }
    .banner-feature-icon img,
    .banner-feature-icon-1 img,
    .banner-feature-icon-4 img {
      width: 64px;
      height: 64px;
      margin: 0 0 0.4rem 0;
      padding-left: 0;
    }
    .banner-feature h4 {
      font-size: 0.8rem;
      line-height: 1.3;
      width: 100%;
      text-align: center;
    }
    .banner-feature p.feature-desc {
      text-align: center;
      font-size: 0.65rem;
      width: 100%;
    }
  }

  @media (width <= 480px) {
    .banner {
      flex-direction: column;
      align-items: stretch;
      height: 105vh;
      overflow: hidden;
    }

    .banner-persona {
      display: block;
      position: static;
      z-index: 0;
      order: 2;
      width: 100%;
      max-width: 460px;
      height: 60vh;
      margin: 1.5rem auto 0;
      transform: translateY(-2rem);
      mask-image: linear-gradient(to bottom, black 75%, transparent 100%);
    }

    /* "Desarma" .content para reordenar sus hijos junto con .banner-persona */
    .content {
      display: contents;
    }

    .banner-actions {
      order: 1;
      flex-wrap: nowrap;
      gap: 0.5rem;
    }

    .btn-primary,
    .btn-outline {
      flex: 1 1 0;
      padding: 0.6rem 0.5rem;
      font-size: 0.78rem;
      white-space: normal;
      text-align: center;
      justify-content: center;
    }

    .banner-features {
      order: 3;
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
      transform: none;
      margin-top: 1.5rem;
    }

    .banner-feature {
      flex: none;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: 0.6rem;
      background: white;
      border-radius: 14px;
      padding: 1rem 0.85rem;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06);
    }

    .banner-feature-icon {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
    }

    .banner-feature-icon img,
    .banner-feature-icon-1 img,
    .banner-feature-icon-4 img {
      width: 44px;
      height: 44px;
      margin: 0;
      padding-left: 0;
    }

    .banner-feature {
      align-items: center;
    }

    .banner-feature h4 {
      display: block;
      font-size: 0.7rem;
      width: auto;
      white-space: normal;
      line-height: 1.3;
      margin-bottom: 0;
    }

    .banner-feature p.feature-desc {
      display: none;
    }
  }
</style>
