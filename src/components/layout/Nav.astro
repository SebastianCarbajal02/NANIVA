---
import { Image } from 'astro:assets';
import logo from '@assets/image/shared/logos/logo-inicio.webp';

const links = [
  { label: "Inicio", href: "/", icon: "home" },
  { label: "Servicios", href: "/servicios", icon: "grid" },
  { label: "IA", href: "/ia", icon: "brain" },
  { label: "Planes", href: "/planes", icon: "tag" },
  { label: "Contáctanos", href: "/contacto", icon: "mail" },
];

// Submenú de "Servicios": las 3 líneas de producto (Tiendas Digitales agrupa Catálogo Smart y Tienda Online)
const serviceGroups = [
  { title: "ERP", items: [{ label: "Sistema ERP", desc: "Ventas, inventario y facturación", href: "/erp", badge: null }] },
  { title: "Restaurantes", items: [{ label: "Sistema POS para Restaurantes", desc: "Mesas, comandas y caja", href: null, badge: "Próximamente" }] },
  {
    title: "Tiendas Digitales",
    href: "/tiendas-digitales",
    items: [
      { label: "Catálogo Smart", desc: "Vende por WhatsApp", href: "/catalogo-digital", badge: null },
      { label: "Tienda Online", desc: "Vende y cobra en línea", href: "/tienda-online", badge: null },
    ],
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const servicePaths = ["/servicios", ...serviceGroups.flatMap((g) => ["href" in g ? g.href : null, ...g.items.map((i) => i.href)])];
---
<header class="nav">
  <div class="nav-inner">
    <a href="/" class="brand">
      <Image src={logo} alt=""  widths={[140, 280, 420]} sizes="140px" loading="eager" />
      <span>NANIVA</span>
    </a>

    <nav class="links" id="navLinks">
      {links.map((link) => {
        const hasSubmenu = link.href === "/servicios";
        const isActive = hasSubmenu
          ? servicePaths.includes(currentPath)
          : currentPath === link.href.replace(/\/$/, "");
        const anchor = (
          <a href={link.href} class={isActive ? "active" : ""}>
            {link.icon === "home" && (
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5" /><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" /></svg>
            )}
            {link.icon === "grid" && (
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
            )}
            {link.icon === "brain" && (
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2a3.5 3.5 0 0 0-3.5 3.5v.6A3 3 0 0 0 4 9v1a3 3 0 0 0 1 2.24V15a3 3 0 0 0 3 3h.5v2a1 1 0 0 0 1 1h1V4.5A2.5 2.5 0 0 1 9.5 2Z" /><path d="M14.5 2a3.5 3.5 0 0 1 3.5 3.5v.6A3 3 0 0 1 20 9v1a3 3 0 0 1-1 2.24V15a3 3 0 0 1-3 3h-.5v2a1 1 0 0 1-1 1h-1V4.5A2.5 2.5 0 0 0 14.5 2Z" /></svg>
            )}
            {link.icon === "tag" && (
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m20.59 13.41-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z" /><circle cx="7" cy="7" r="1.5" fill="currentColor" stroke="none" /></svg>
            )}
            {link.icon === "mail" && (
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></svg>
            )}
            <span>{link.label}</span>
          </a>
        );
        if (!hasSubmenu) return anchor;
        return (
          <div class="nav-item has-submenu">
            <div class="nav-item-row">
              {anchor}
              <button type="button" class="submenu-toggle" aria-expanded="false" aria-controls="submenu-servicios" aria-label="Ver servicios">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
            </div>
            <div class="submenu" id="submenu-servicios">
              {serviceGroups.map((group) => {
                const renderItem = (item: (typeof group.items)[number]) =>
                  item.href ? (
                    <a href={item.href} class:list={["submenu-link", { active: currentPath === item.href }]}>
                      <strong>{item.label}</strong>
                    </a>
                  ) : (
                    <div class="submenu-link submenu-link-disabled">
                      <strong>{item.label}</strong>
                      <span class="coming-soon-badge">{item.badge}</span>
                    </div>
                  );
                if (group.items.length === 1) return renderItem(group.items[0]);
                // Grupos con varias páginas: fila con flecha que abre sus páginas a la derecha
                const groupHref = "href" in group ? group.href : undefined;
                const groupActive = [groupHref, ...group.items.map((i) => i.href)].includes(currentPath);
                return (
                  <div class="submenu-flyout">
                    <a href={groupHref} class:list={["submenu-link", "submenu-flyout-trigger", { active: groupActive }]}>
                      <strong>{group.title}</strong>
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                    </a>
                    <div class="submenu-flyout-panel">
                      {group.items.map(renderItem)}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}

      <div class="mobile-menu-actions">
        <a href="https://wa.me/51937292341?text=%F0%9F%91%8B%20%C2%A1Hola!%20Me%20gustar%C3%ADa%20solicitar%20una%20demostraci%C3%B3n%20de%20la%20plataforma%20Naniva.%20%F0%9F%9A%80%20Quisiera%20conocer%20sus%20funcionalidades%20y%20c%C3%B3mo%20puede%20ayudar%20a%20optimizar%20la%20gesti%C3%B3n%20de%20mi%20empresa" target="_blank" rel="noopener noreferrer" class="mobile-menu-btn mobile-menu-btn-primary">Solicitar demostración</a>
      </div>

      <div class="mobile-menu-footer">
        <div class="mobile-menu-brand">
          <Image src={logo} alt=""  widths={[140, 280, 420]} sizes="140px" loading="eager" />
          <span>NANIVA</span>
        </div>
      </div>
    </nav>

    <a href="https://wa.me/51937292341?text=%F0%9F%91%8B%20%C2%A1Hola!%20Me%20gustar%C3%ADa%20solicitar%20una%20demostraci%C3%B3n%20de%20la%20plataforma%20Naniva.%20%F0%9F%9A%80%20Quisiera%20conocer%20sus%20funcionalidades%20y%20c%C3%B3mo%20puede%20ayudar%20a%20optimizar%20la%20gesti%C3%B3n%20de%20mi%20empresa" target="_blank" rel="noopener noreferrer" class="demo-btn hover-pop">
      Solicitar demo
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
    </a>

    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
  <div class="menu-backdrop" id="menuBackdrop"></div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    padding: 0;
  }
  .nav-inner {
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: #ffffff;
    border-radius: 0;
    padding: 0.7rem 0.75rem 0.7rem 4rem;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
    border-bottom: 1px solid #e2e8f0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
    text-decoration: none;
  }
  .brand img {
    height: 56px;
    width: auto;
    object-fit: contain;
  }
  .brand span {
    color: #0f172a;
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex: 1;
    justify-content: center;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #475569;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.92rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease;
  }
  .links a:hover {
    color: #2563eb;
    border-bottom-color: #2563eb;
  }
  .links a.active {
    color: #2563eb;
    border-bottom-color: #2563eb;
  }
  /* --- Submenú de Servicios --- */
  .nav-item { position: relative; }
  .nav-item-row { display: flex; align-items: center; gap: 0.1rem; }
  .submenu-toggle {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    color: #475569;
    cursor: pointer;
    padding: 0 0 0.35rem;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .has-submenu:hover .submenu-toggle,
  .has-submenu.open .submenu-toggle { color: #2563eb; }
  .has-submenu.open .submenu-toggle { transform: rotate(180deg); }
  .submenu {
    position: absolute;
    top: 100%;
    left: 50%;
    display: grid;
    grid-template-columns: 1fr;
    width: 300px;
    margin-top: 0.9rem;
    padding: 0.4rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  /* Puente invisible para no perder el hover al bajar al submenú */
  .submenu::before { content: ""; position: absolute; left: 0; right: 0; top: -1rem; height: 1rem; }
  .has-submenu:hover .submenu,
  .has-submenu:focus-within .submenu,
  .has-submenu.open .submenu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .links a.submenu-link {
    display: flex;
    align-items: center;
    padding: 0.5rem 0.65rem;
    border-bottom: none;
    border-radius: 8px;
  }
  .links a.submenu-link:hover,
  .links a.submenu-link.active { background: none; border-bottom: none; }
  .submenu-link strong { color: #0f172a; font-size: 0.86rem; font-weight: 600; }
  .links a.submenu-link:hover strong,
  .links a.submenu-link.active strong { color: #2563eb; }

  .submenu-link-disabled {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.65rem;
    border-radius: 8px;
    cursor: not-allowed;
  }
  .submenu-link-disabled strong { color: #94a3b8; }
  /* Grupo con páginas anidadas: se abre a la derecha al pasar el mouse */
  .submenu-flyout { position: relative; }
  .submenu-flyout-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.65rem;
    border-radius: 8px;
    color: #64748b;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .submenu-flyout:hover .submenu-flyout-trigger,
  .submenu-flyout:focus-within .submenu-flyout-trigger,
  .submenu-flyout-trigger.active { background: none; color: #2563eb; }
  .submenu-flyout:hover .submenu-flyout-trigger strong,
  .submenu-flyout:focus-within .submenu-flyout-trigger strong,
  .submenu-flyout-trigger.active strong { color: #2563eb; }
  .submenu-flyout-panel {
    position: absolute;
    top: -0.4rem;
    left: 100%;
    display: grid;
    width: 220px;
    margin-left: 0.6rem;
    padding: 0.4rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  /* Puente invisible para no perder el hover al cruzar hacia el panel */
  .submenu-flyout-panel::before { content: ""; position: absolute; top: 0; bottom: 0; left: -0.75rem; width: 0.75rem; }
  .submenu-flyout:hover .submenu-flyout-panel,
  .submenu-flyout:focus-within .submenu-flyout-panel {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }
  .coming-soon-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: #fef3c7;
    color: #92400e;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .demo-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    background: linear-gradient(135deg, #2563eb, #3b82f6);
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.65rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
  }
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    border: none;
    background: #f1f5f9;
    border-radius: 8px;
    cursor: pointer;
    margin-left: auto;
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }
  .menu-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: #0f172a;
    margin: 0 auto;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .menu-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle.open span:nth-child(2) { opacity: 0; }
  .menu-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .menu-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    z-index: 0;
  }
  .menu-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Laptops pequeñas y tablets horizontales: menú más compacto para que el botón no se salga */
  @media (max-width: 1200px) and (min-width: 769px) {
    .nav-inner { padding-left: 1.5rem; gap: 1rem; }
    .links { gap: 1.25rem; }
    .links a { white-space: nowrap; }
  }
  @media (max-width: 1100px) and (min-width: 901px) {
    .links a > svg { display: none; }
  }
  @media (max-width: 900px) {
    .links { gap: 1.1rem; }
    .links a span { display: none; }
  }

  .mobile-menu-footer { display: none; }

  @media (max-width: 768px) {
    .nav-inner { padding-left: 1rem; }
    .demo-btn { display: none; }
    .menu-toggle { display: flex; }
    .links {
      display: flex;
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: min(80vw, 320px);
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: #ffffff;
      /* La sombra solo con el menú abierto: cerrado, se veía como una franja gris en el borde derecho */
      box-shadow: none;
      transform: translateX(100%);
      transition: transform 0.35s ease, box-shadow 0.35s ease;
      padding-top: 6rem;
      justify-content: flex-start;
      overflow-y: auto;
      z-index: 1;
    }
    .links.open {
      transform: translateX(0);
      box-shadow: -10px 0 40px rgba(15,23,42,0.15);
    }
    .links a {
      width: 100%;
      margin-top: 0;
      padding: 1.25rem 1.75rem;
      border-bottom: 1px solid #e2e8f0;
      border-radius: 0;
      font-size: 1.1rem;
    }
    .links a span { display: inline; }
    .links a:last-child { border-bottom: none; }
    .links a.active { border-bottom-color: #e2e8f0; }

    /* Submenú en el menú lateral: acordeón que se abre con la flecha */
    .nav-item { width: 100%; }
    .nav-item-row { border-bottom: 1px solid #e2e8f0; }
    .nav-item-row a { flex: 1; border-bottom: none; }
    .links .nav-item-row a:last-child { border-bottom: none; }
    .submenu-toggle { padding: 1.25rem 1.5rem; align-self: stretch; }
    .submenu {
      position: static;
      display: none;
      width: 100%;
      margin: 0;
      padding: 0.5rem 1rem 1rem 1.75rem;
      grid-template-columns: 1fr;
      border: none;
      border-bottom: 1px solid #e2e8f0;
      border-radius: 0;
      box-shadow: none;
      background: #f8fafc;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .submenu::before { display: none; }
    .has-submenu.open .submenu { display: grid; transform: none; }
    .links a.submenu-link { width: 100%; padding: 0.6rem 0.75rem; font-size: 1rem; }

    /* En el menú lateral el grupo se muestra abierto, con sus páginas debajo */
    .submenu-flyout-trigger { padding: 0.6rem 0.75rem; background: none; }
    .submenu-flyout-trigger svg { display: none; }
    .submenu-flyout-panel {
      position: static;
      width: 100%;
      margin: 0;
      padding: 0 0 0 0.75rem;
      border: none;
      border-radius: 0;
      box-shadow: none;
      background: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .submenu-flyout-panel::before { display: none; }

    .mobile-menu-footer {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      width: 100%;
      padding: 1.5rem 1.75rem 4rem;
    }

    .mobile-menu-actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      width: auto;
      padding: 1rem 1.75rem 0;
    }

    .links .mobile-menu-btn {
      width: auto;
      text-align: center;
      padding: 0.3rem 0.9rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.78rem;
      text-decoration: none;
      white-space: nowrap;
      border-bottom: none !important;
      margin-top: 0;
    }

    .links .mobile-menu-btn-primary {
      background: linear-gradient(135deg, #2563eb, #3b82f6);
      color: white;
    }

    .mobile-menu-brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .mobile-menu-brand img {
      height: 80px;
      width: auto;
      object-fit: contain;
    }

    .mobile-menu-brand span {
      color: #0f172a;
      font-weight: 800;
      font-size: 1.1rem;
      letter-spacing: 0.02em;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menuToggle");
  const links = document.getElementById("navLinks");
  const backdrop = document.getElementById("menuBackdrop");

  function closeMenu() {
    links?.classList.remove("open");
    toggle?.classList.remove("open");
    backdrop?.classList.remove("open");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", () => {
    const isOpen = links?.classList.toggle("open");
    toggle.classList.toggle("open");
    backdrop?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    document.body.style.overflow = isOpen ? "hidden" : "";
  });

  backdrop?.addEventListener("click", closeMenu);
  links?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));

  // Submenú de Servicios: la flecha lo abre/cierra (en celular y en pantallas táctiles)
  const submenuItem = document.querySelector<HTMLElement>(".has-submenu");
  const submenuToggle = submenuItem?.querySelector<HTMLButtonElement>(".submenu-toggle");

  function setSubmenu(open: boolean) {
    submenuItem?.classList.toggle("open", open);
    submenuToggle?.setAttribute("aria-expanded", open ? "true" : "false");
  }

  submenuToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    setSubmenu(!submenuItem?.classList.contains("open"));
  });
  document.addEventListener("click", (e) => {
    if (submenuItem && !submenuItem.contains(e.target as Node) && window.innerWidth > 768) setSubmenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setSubmenu(false);
  });
</script>
