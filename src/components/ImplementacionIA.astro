---
import icon08 from '../assets/image/IA/iconff4g-14.webp';
import icon07 from '../assets/image/IA/iconff4g-13.webp';
import icon09 from '../assets/image/IA/iconff4g-12.webp';
import icon10 from '../assets/image/IA/iconff4g-11.webp';
import benefitIcon11 from '../assets/image/IA/iconff4g-15.webp';

const steps = [
  {
    num: 1,
    icon: icon07,
    title: 'Diagnóstico',
    items: [
      'Entendemos tu empresa',
      'Definimos el plan',
      'Preparamos la implementación',
    ],
  },
  {
    num: 2,
    icon: icon08,
    title: 'Configuración',
    items: [
      'Configuramos Naniva',
      'Importamos información',
      'Validamos los datos',
    ],
  },
  {
    num: 3,
    icon: icon09,
    title: 'Capacitación',
    items: [
      'Entrenamos al equipo',
      'Probamos el sistema',
      'Ajustamos detalles',
    ],
  },
  {
    num: 4,
    icon: icon10,
    title: '¡Empieza a operar!',
    items: [
      'Sistema en producción',
      'Equipo acompañado',
      'Soporte permanente',
    ],
  },
];

---

<section class="implementacion-ia">
  <div class="container">
    <div class="header reveal">
      <h2>Así de facil funciona <span class="highlight">NANIVA</span> IA</h2>
    </div>

    <div class="steps-carousel-wrap">
      <button type="button" class="step-arrow-btn step-arrow-btn-prev" aria-label="Paso anterior">‹</button>
      <button type="button" class="step-arrow-btn step-arrow-btn-next" aria-label="Siguiente paso">›</button>

      <div class="steps-grid">
      {steps.map((step, i) => (
        <div class={`step-card reveal hover-lift ${step.isDone ? 'step-done' : ''}`} style={`transition-delay:${i * 0.08}s`}>
          <span class={`step-num ${step.isDone ? 'step-done-color' : ''}`}>{step.num}</span>
          <img src={step.icon.src} alt={step.title} class="step-icon-img" />
          <h4>{step.title}</h4>
          <ul>
            {step.items.map((item) => (
              <li>
                <span class={`check ${step.isDone ? 'check-done' : ''}`}>✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          {i < steps.length - 1 && <span class="step-arrow">→</span>}
        </div>
      ))}
      </div>
    </div>
  </div>
</section>

<style>
  .implementacion-ia {
    background: #ffffff;
    padding: 5rem 1rem;
  }

  .implementacion-ia .container {
    max-width: 1400px;
  }

  .header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .tag {
    display: inline-block;
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  h2 {
    font-size: clamp(2rem, 2.8vw, 2.8rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .highlight {
    color: #2563eb;
  }

  .subtitle {
    font-size: 3rem;
    color: #64748b;
    line-height: 1.7;
    max-width: 800px;
    margin: 0 auto;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
    margin-bottom: 4rem;
    align-items: stretch;
  }

  .step-card {
    background: #ffffff;
    border: 2px solid rgba(15, 23, 42, 0.08);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    transition: all 0.3s ease;
    margin-top: 2.5rem;
  }

  .step-card:hover {
    border-color: rgba(37, 99, 235, 0.2);
    box-shadow: 0 10px 30px rgba(37, 99, 235, 0.08);
  }

  .step-card.step-done {
    background: rgba(22, 163, 74, 0.05);
    border-color: rgba(22, 163, 74, 0.2);
  }

  .step-num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: white;
    font-weight: 800;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
  }

  .step-card:nth-child(1) .step-num {
    background: #16a34a;
  }

  .step-card:nth-child(2) .step-num {
    background: #f97316;
  }

  .step-card:nth-child(3) .step-num {
    background: #2563eb;
  }

  .step-card:nth-child(4) .step-num {
    background: #a855f7;
  }

  .step-done-color {
    background: #16a34a;
  }

  .step-icon-img {
    width: 100%;
    height: auto;
    max-width: 120px;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  .step-card h4 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 1rem 0;
  }

  .step-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .step-card li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: #64748b;
    text-align: left;
  }

  .check {
    color: #2563eb;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-card.step-done .check {
    color: #16a34a;
  }

  .step-arrow {
    position: absolute;
    right: -45px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem;
    color: #cbd5e1;
    font-weight: 700;
  }

  .step-card:last-child .step-arrow {
    display: none;
  }

  .benefits-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    background: #f8fafc;
    border-radius: 20px;
    padding: 2.5rem;
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .benefit-icon-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .benefit-item h5 {
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.5rem 0;
  }

  .benefit-item p {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1100px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }

    .step-arrow {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .implementacion-ia {
      padding: 3.5rem 1rem;
    }

    .header {
      margin-bottom: 3rem;
    }

    .steps-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .step-card {
      padding: 1.75rem 1.5rem;
    }

    .benefits-bar {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      padding: 2rem;
    }
  }

  @media (max-width: 600px) {
    h2 {
      font-size: 1.6rem;
    }

    .subtitle {
      font-size: 0.95rem;
    }

    .benefits-bar {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 1.5rem;
    }

    .benefit-item {
      gap: 1rem;
    }

    .benefit-icon-img {
      width: 48px;
      height: 48px;
    }
  }

  .step-arrow-btn {
    display: none;
  }

  @media (max-width: 480px) {
    .steps-carousel-wrap {
      position: relative;
      padding: 0 1.75rem;
    }

    .steps-grid {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 1rem;
      padding-bottom: 0.5rem;
      margin-bottom: 0;
    }
    .steps-grid::-webkit-scrollbar { display: none; }

    .step-card {
      flex: 0 0 100%;
      scroll-snap-align: center;
    }

    .step-arrow-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 45%;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      border-radius: 999px;
      border: none;
      background: rgba(15, 23, 42, 0.85);
      color: white;
      font-size: 1.4rem;
      line-height: 1;
      z-index: 3;
      cursor: pointer;
    }
    .step-arrow-btn-prev { left: 0; }
    .step-arrow-btn-next { right: 0; }
  }
</style>

<script>
  function initStepsCarousel() {
    const wrap = document.querySelector<HTMLElement>(".steps-carousel-wrap");
    const track = document.querySelector<HTMLElement>(".steps-grid");
    if (!wrap || !track) return;

    const prevBtn = wrap.querySelector<HTMLButtonElement>(".step-arrow-btn-prev");
    const nextBtn = wrap.querySelector<HTMLButtonElement>(".step-arrow-btn-next");

    const scrollAmount = () => {
      const item = track.querySelector<HTMLElement>(":scope > *");
      if (!item) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || "0");
      return item.getBoundingClientRect().width + gap;
    };

    prevBtn?.addEventListener("click", () => {
      track.scrollBy({ left: -scrollAmount(), behavior: "smooth" });
    });
    nextBtn?.addEventListener("click", () => {
      track.scrollBy({ left: scrollAmount(), behavior: "smooth" });
    });
  }

  initStepsCarousel();
</script>
