---
import iconAsesoriaImg from '../assets/image/shared/iconos-comunes/ICOMS1-07.webp';
import iconCompromisoImg from '../assets/image/home/faq/ICOMS1-08.webp';
import iconRespuestaImg from '../assets/image/home/faq/ICOMS1-09.webp';
import iconHeadsetImg from '../assets/image/home/faq/ICOMS1-10.webp';

function iconSvg(name: string, color: string = "#2563eb", size = 18): string {
  const icons: Record<string, string> = {
    help: `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 2-3 4"/><path d="M12 17h.01"/></svg>`,
    whatsapp: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="${color}"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371 0-.57 0-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a5.505 5.505 0 0 0-5.5 5.515c0 1.527.586 2.957 1.655 4.038l-.655 2.392 2.445-.644C6.926 20.285 8.372 21 9.975 21c3.051 0 5.538-2.487 5.538-5.538 0-1.48-.635-2.869-1.744-3.91-.857-.857-2.007-1.363-3.224-1.363z"/></svg>`,
  };
  return icons[name] ?? "";
}

const faqs = [
  { q: "¿Cuánto demora implementar Naniva?", a: "La implementación completa toma entre 3 y 7 días, dependiendo del tamaño de tu empresa y los módulos que necesites." },
  { q: "¿Puedo conectar WhatsApp?", a: "Sí, Naniva se integra directamente con WhatsApp Business para catálogo, pedidos y notificaciones a tus clientes." },
  { q: "¿Puedo migrar mis datos?", a: "Sí, nuestro equipo te ayuda a importar y validar tu información existente (productos, clientes, inventario) sin perder nada." },
  { q: "¿La información está segura?", a: "Toda tu información se almacena cifrada en la nube con respaldos automáticos y los más altos estándares de seguridad." },
  { q: "¿Necesito instalar algo?", a: "No, Naniva funciona 100% desde el navegador. Solo necesitas conexión a internet, sin instalar software adicional." },
  { q: "¿Puedo usar varias empresas?", a: "Sí, puedes administrar múltiples empresas o sucursales desde una sola cuenta, cada una con su propia información." },
  { q: "¿Tiene aplicación móvil?", a: "Sí, Naniva cuenta con una app móvil para que gestiones tu negocio desde cualquier lugar." },
  { q: "¿Cómo solicito una demostración?", a: "Solo haz clic en \"Solicitar demostración\" o escríbenos por WhatsApp y coordinamos una sesión personalizada sin compromiso." },
];

const half = Math.ceil(faqs.length / 2);
const colLeft = faqs.slice(0, half);
const colRight = faqs.slice(half);

const trustMini = [
  { iconImg: iconRespuestaImg, label: "Respuesta rápida" },
  { iconImg: iconAsesoriaImg, label: "Asesoría personalizada" },
  { iconImg: iconCompromisoImg, label: "Sin compromiso" },
];
---
<section id="faq" class="faq">
  <div class="container">
    <div class="faq-card">
    <div class="faq-grid">
      <div class="faq-main reveal">
        <div class="tag" set:html={`${iconSvg('help')} PREGUNTAS FRECUENTES`} />
        <h2>¿Tienes <span class="highlight">dudas?</span></h2>
        <p class="subtitle">Aquí respondemos las preguntas más frecuentes antes de solicitar tu demostración.</p>

        <div class="faq-cols">
          <div class="faq-col">
            {colLeft.map((f, i) => (
              <details class="faq-item">
                <summary>
                  <span class="faq-num">{i + 1}</span>
                  <span class="faq-q">{f.q}</span>
                  <span class="faq-chevron">⌄</span>
                </summary>
                <p class="faq-a">{f.a}</p>
              </details>
            ))}
          </div>
          <div class="faq-col">
            {colRight.map((f, i) => (
              <details class="faq-item">
                <summary>
                  <span class="faq-num">{i + half + 1}</span>
                  <span class="faq-q">{f.q}</span>
                  <span class="faq-chevron">⌄</span>
                </summary>
                <p class="faq-a">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <div class="faq-side reveal">
        <div class="faq-side-icon-wrap">
          <img src={iconHeadsetImg.src} alt="" class="faq-side-icon-img" />
          <span class="sparkle">✦</span>
        </div>
        <h3>¿No encontraste<br />tu respuesta?</h3>
        <p>Nuestro equipo está listo para ayudarte y orientarte en el proceso.</p>
        <a href="https://wa.link/iar289" target="_blank" rel="noopener noreferrer" class="whatsapp-btn hover-pop" set:html={`${iconSvg('whatsapp', 'white', 28)} Escríbenos por WhatsApp →`} />
        <div class="faq-mini-list">
          {trustMini.map((t) => (
            <div class="faq-mini-item">
              <img src={t.iconImg.src} alt="" class="faq-mini-icon-img" />
              <span>{t.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 4rem 0;
    background: #f8fafc;
  }
  .faq .container {
    max-width: 1600px;
  }
  .faq-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: var(--radius);
    padding: 2.5rem;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
  }
  .faq-grid {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .faq-main {
    flex: 2;
    min-width: 320px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #eaf1ff;
    color: #2563eb;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.75rem;
  }
  .highlight { color: #2563eb; }
  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    font-size: 1rem;
  }
  .faq-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .faq-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .faq-item {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-num {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: #eaf1ff;
    color: #2563eb;
    font-weight: 800;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .faq-q {
    flex: 1;
    font-weight: 700;
    font-size: 0.92rem;
    color: #0f172a;
  }
  .faq-chevron {
    color: #94a3b8;
    font-size: 1.1rem;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-a {
    margin: 0.85rem 0 0 2.5rem;
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.5;
  }

  .faq-side {
    flex: 1;
    min-width: 280px;
    background: linear-gradient(160deg, #eef4ff, #f8fbff);
    border: 1px solid #dbeafe;
    border-radius: var(--radius);
    padding: 2rem 1.75rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    transform: translateY(5rem);
  }
  .faq-side-icon-wrap {
    position: relative;
    width: 92px;
    height: 92px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }
  .faq-side-icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .sparkle {
    position: absolute;
    top: -10px;
    right: -18px;
    color: #93c5fd;
    font-size: 1.4rem;
  }
  .faq-side h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .faq-side p {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }
  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    background: #16a34a;
    color: white;
    padding: 1.1rem 2rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    white-space: nowrap;
  }
  .faq-mini-list {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .faq-mini-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
  }
  .faq-mini-icon-img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .faq-cols { grid-template-columns: 1fr; }
  }
    @media (max-width: 400px) 
    { 
    .faq-card[data-astro-cid-hemr5th4] {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: 0 14px 40px #0f172a0f;
}
.faq-side {
    flex: 1;
    min-width: 280px;
    background: linear-gradient(160deg, #eef4ff, #f8fbff);
    border: 1px solid #dbeafe;
    border-radius: var(--radius);
    padding: 2rem 1.75rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    transform: translateY(-1rem);
  }
  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    background: #16a34a;
    color: white;
    padding: 1.1rem 2em;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 1.5rem;
    white-space: nowrap;
  }


    }
</style>
