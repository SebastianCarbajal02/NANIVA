---
// Banner "Tu tienda online, siempre activa": franja con la laptop y el celular a la izquierda,
// el título al centro y los medios de pago a la derecha. Usa `producto.payBanner`.
import { Image } from 'astro:assets';
import { themeStyle, type Producto } from '@data/productos';
import './producto.css';
import { icons } from './icons';

interface Props {
  producto: Producto;
}
const { producto: p } = Astro.props;
const b = p.payBanner!;
---
<section class="producto-section pay" style={themeStyle(p)}>
  <div class="container">
    <div class="pay-panel">
      <div class="pay-art reveal">
        <Image
          src={b.img}
          alt={b.imgAlt}
          widths={[360, 560, 800]}
          sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 380px"
          class="pay-img"
        />
      </div>

      <div class="pay-text">
        <h2 class="reveal" style="--d: 60ms">{b.title} <span class="pay-highlight">{b.highlight}</span></h2>
        <p class="pay-intro reveal" style="--d: 120ms">{b.intro}</p>
      </div>

      <ul class="pay-methods">
        {b.methods.map((m, i) => (
          <li class="pay-method reveal" style={`--d: ${180 + i * 80}ms`}>
            {m.img ? (
              <Image src={m.img} alt="" widths={[80, 160]} sizes="40px" class="pay-logo" />
            ) : (
              <span class="pay-icon" set:html={icons[m.icon ?? 'card']} />
            )}
            <span class="pay-label">{m.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .pay { --navy: #0b2559; }
  .pay .container { max-width: 1400px; }

  /* Franja horizontal: imagen | texto | medios de pago */
  .pay-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) minmax(0, 1.2fr);
    align-items: center;
    gap: 2.5rem;
    padding: 1.75rem 2.5rem;
    background: #fff;
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }

  .pay-img { display: block; width: 100%; height: auto; filter: drop-shadow(0 16px 22px rgba(15, 23, 42, 0.14)); }

  .pay h2 {
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--navy);
  }
  .pay-highlight { color: var(--accent-strong); }
  .pay-intro { margin-top: 0.75rem; max-width: 30em; color: #475569; font-size: 1.02rem; line-height: 1.6; }

  /* Medios de pago: recuadros pequeños; con el fondo claro necesitan borde para distinguirse */
  .pay-methods {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .pay-method {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 112px;
    padding: 1rem 0.5rem;
    background: #fff;
    border: var(--border-soft);
    border-radius: var(--card-radius);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .pay-method:hover { transform: translateY(-2px); box-shadow: var(--card-shadow-hover); }
  .pay-logo { display: block; width: 40px; height: 40px; object-fit: contain; }
  .pay-icon { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; color: var(--accent-strong); }
  .pay-icon :global(svg) { width: 30px; height: 30px; }
  .pay-label { color: var(--navy); font-size: 0.9rem; font-weight: 600; line-height: 1.2; }

  /* Tablet: imagen y texto arriba, medios de pago debajo a todo el ancho */
  @media (max-width: 1100px) {
    .pay-panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 1.75rem 2rem; padding: 1.75rem; }
    .pay-methods { grid-column: 1 / -1; }
  }
  @media (max-width: 700px) {
    .pay-panel { grid-template-columns: 1fr; padding: 1.5rem 1.1rem; text-align: center; }
    .pay-art { max-width: 380px; width: 100%; margin: 0 auto; }
    .pay-intro { margin-inline: auto; }
  }
  @media (max-width: 420px) {
    .pay-methods { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pay-method { transition: none; }
    .pay-method:hover { transform: none; }
  }
</style>
