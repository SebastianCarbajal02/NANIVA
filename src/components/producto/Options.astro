---
// Tiendas Digitales: las dos opciones (Catálogo Smart y Tienda Online), cada una con su página
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { themeStyle, type Producto, type IconName } from '@data/productos';
import imgCatalogo from '@assets/image/tiendas-digitales/card-catalogo-smart.webp';
import imgTienda from '@assets/image/tiendas-digitales/card-tienda-online.webp';
import './producto.css';
import { icons, arrowIcon } from './icons';

interface Props {
  producto: Producto;
}
const { producto: p } = Astro.props;

const circleCheck = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.5 2.5L16 9.5"/></svg>`;

const opciones: {
  variant: 'catalogo' | 'tienda';
  nombre: string;
  subtitulo: string;
  icon: IconName;
  desc: string;
  items: string[];
  href: string;
  cta: string;
  /** false: la página aún no se publica y el botón muestra "Próximamente" */
  disponible: boolean;
  img: ImageMetadata;
  imgAlt: string;
}[] = [
  {
    variant: 'catalogo',
    nombre: 'Catálogo Smart',
    subtitulo: 'Pedidos por WhatsApp',
    icon: 'whatsapp',
    desc: 'Muestra tus productos en un catálogo digital y recibe pedidos directamente en WhatsApp. Ideal para negocios que buscan una forma rápida y sencilla de vender.',
    items: ['Catálogo de productos con imágenes y precios', 'Pedidos por WhatsApp', 'Atención directa a tus clientes', 'Sin costos de pasarela de pagos'],
    href: '/catalogo-digital',
    cta: 'Conoce más sobre Catálogo Smart',
    disponible: true,
    img: imgCatalogo,
    imgAlt: 'Conversación de WhatsApp donde un cliente recibe el enlace del catálogo NANIVA',
  },
  {
    variant: 'tienda',
    nombre: 'Tienda Online',
    subtitulo: 'Carrito y pagos en línea',
    icon: 'cart',
    desc: 'Vende con un carrito de compras completo y permite que tus clientes paguen de forma segura desde tu tienda.',
    items: ['Catálogo de productos con imágenes y precios', 'Carrito de compras', 'Pasarela de pagos (tarjeta, Yape, Plin, etc.)', 'Gestión de pedidos y stock'],
    href: '/tienda-online',
    cta: 'Conoce más sobre Tienda Online',
    disponible: false,
    img: imgTienda,
    imgAlt: 'Carrito de compras de una tienda online NANIVA en laptop',
  },
];
---
<section class="producto-section options" style={themeStyle(p)}>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow reveal">DOS FORMAS DE VENDER</span>
      <h2 class="reveal" style="--d: 60ms">Elige la opción que mejor se adapte a tu negocio</h2>
      <p class="reveal" style="--d: 120ms">Tanto si prefieres recibir pedidos por WhatsApp como si quieres una tienda con pagos en línea, NANIVA te da las herramientas para que vendas sin complicaciones.</p>
    </div>
    <div class="options-grid">
      {opciones.map((o, i) => (
        <article class:list={['option-card', `option-${o.variant}`, 'reveal']} style={`--d: ${i * 120}ms`}>
          <div class="option-text">
            <span class="option-icon" set:html={icons[o.icon]} />
            <h3>{o.nombre}</h3>
            <p class="option-sub">{o.subtitulo}</p>
            <p class="option-desc">{o.desc}</p>
            <ul>
              {o.items.map((item) => <li><span class="option-check" set:html={circleCheck} />{item}</li>)}
            </ul>
            {o.disponible ? (
              <a href={o.href} class="option-btn">{o.cta} <span set:html={arrowIcon} /></a>
            ) : (
              <span class="option-btn option-btn-disabled" aria-disabled="true">Próximamente</span>
            )}
          </div>
          <div class="option-media">
            <Image src={o.img} alt={o.imgAlt} class="option-img" widths={[320, 560, 800, 1100].filter((w) => w <= o.img.width)} sizes="(max-width: 860px) 70vw, 340px" />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .options { background: #f8fafc; }
  .eyebrow {
    display: inline-block;
    margin-bottom: 0.6rem;
    color: #16a34a;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  /* Más ancho que el contenedor normal para que cada tarjeta tenga espacio para su imagen */
  .options .container { max-width: 1400px; }
  .options .section-head { max-width: 900px; }
  .options .section-head h2 { color: #0b2559; }

  .options-grid {
    display: grid;
    /* La tarjeta de Tienda Online es más ancha: su laptop es una imagen horizontal */
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 1.5rem;
  }
  .option-card {
    --c: #16a34a;
    --c-strong: #15803d;
    --c-soft: #dcfce7;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    min-height: 560px;
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    box-shadow: var(--card-shadow);
    padding: 2.5rem 2rem;
    overflow: hidden;
  }
  .option-catalogo { background: linear-gradient(135deg, #ecfdf3 0%, #f3fdf7 60%, #e6faef 100%); }
  .option-tienda {
    --c: #0b6cf5;
    --c-strong: #0a5fd8;
    --c-soft: #dbeafe;
    background: linear-gradient(135deg, #f1f7ff 0%, #f6faff 60%, #e9f2ff 100%);
  }
  .option-media { display: flex; align-items: center; }
  .option-img { display: block; height: auto; }
  /* Las dos imágenes completas, centradas en su columna */
  .option-media { justify-content: center; }
  .option-catalogo { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
  .option-catalogo .option-img { width: 100%; max-width: 220px; filter: drop-shadow(0 18px 28px rgba(15, 23, 42, 0.18)); }
  /* Tienda: más ancho para la laptop (imagen horizontal), sin que se corte en el borde */
  .option-tienda { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); padding-right: 1.25rem; }
  .option-tienda .option-img { width: 108%; max-width: none; filter: drop-shadow(0 18px 28px rgba(15, 23, 42, 0.14)); }
  .option-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    background: var(--c-soft);
    color: var(--c);
    margin-bottom: 0.9rem;
  }
  .option-card h3 { font-size: 1.35rem; color: #0b2559; line-height: 1.25; }
  .option-sub { color: var(--c); font-weight: 600; margin: 0.15rem 0 0.9rem; }
  .option-desc { color: #475569; font-size: 0.92rem; line-height: 1.6; margin-bottom: 1rem; }
  .option-card ul { list-style: none; display: grid; gap: 0.55rem; margin-bottom: 1.5rem; }
  .option-card li { display: flex; align-items: flex-start; gap: 0.5rem; color: #1e293b; font-size: 0.88rem; }
  .option-check { display: inline-flex; flex-shrink: 0; color: var(--c); }
  .option-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.2rem;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }
  .option-btn:hover { transform: translateY(-2px); }
  /* Catálogo: botón con borde verde. Tienda: botón azul relleno */
  .option-catalogo .option-btn { border: 1.5px solid var(--c); color: var(--c-strong); background: #fff; }
  .option-catalogo .option-btn:hover { background: var(--c-soft); }
  .option-tienda .option-btn { background: var(--c); color: #fff; }
  .option-tienda .option-btn:hover { background: var(--c-strong); }
  .option-card .option-btn.option-btn-disabled,
  .option-card .option-btn.option-btn-disabled:hover {
    background: #fef3c7;
    color: #92400e;
    border: none;
    cursor: not-allowed;
    transform: none;
  }
  @media (max-width: 1100px) {
    .options-grid { grid-template-columns: 1fr; max-width: 680px; margin: 0 auto; }
  }
  @media (max-width: 560px) {
    .option-card { grid-template-columns: 1fr; min-height: 0; padding: 1.6rem 1.25rem; }
    .option-catalogo { grid-template-columns: 1fr; }
    .option-catalogo .option-img { max-width: 200px; }
    .option-tienda { grid-template-columns: 1fr; padding-right: 1.25rem; }
    .option-tienda .option-img { width: 100%; }
    .option-btn { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .option-btn:hover { transform: none; }
  }
</style>
