---
// Aviso para una página de producto que aún no se publica: candado, mensaje y botones
// para ir a otra opción disponible. Ocupa la pantalla con el fondo menta del banner.
import { themeStyle, whatsappHref, type Producto } from '@data/productos';
import './producto.css';
import { arrowIcon } from './icons';

interface Props {
  producto: Producto;
  /** Opción disponible que se ofrece en lugar de esta página */
  alternativa: { label: string; href: string };
}
const { producto: p, alternativa } = Astro.props;

const lockIcon = `<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14.5v2.5"/></svg>`;
---
<section class="producto-section soon" style={themeStyle(p)}>
  <div class="soon-card reveal">
    <span class="soon-icon" set:html={lockIcon} />
    <span class="soon-tag">PRÓXIMAMENTE</span>
    <h1>La {p.nombre} aún no está disponible</h1>
    <p>
      Estamos preparando esta sección. Mientras tanto, puedes conocer nuestras otras soluciones
      o escribirnos para que te avisemos cuando esté lista.
    </p>
    <div class="soon-actions">
      <a href={alternativa.href} class="btn btn-primary">{alternativa.label} <span set:html={arrowIcon} /></a>
      <a href={whatsappHref(p)} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Escríbenos por WhatsApp</a>
    </div>
    <a href="/" class="soon-home">Volver al inicio</a>
  </div>
</section>

<style>
  .soon {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 8rem 1.25rem 4rem;
    background:
      radial-gradient(38rem 26rem at 72% 35%, rgba(134, 239, 172, 0.28), transparent 70%),
      radial-gradient(26rem 20rem at 10% 90%, rgba(94, 234, 212, 0.2), transparent 70%),
      linear-gradient(180deg, #f3fcf7 0%, #eefaf4 100%);
  }
  .soon-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 620px;
    padding: 3rem 2.5rem;
    text-align: center;
    background: #fff;
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    box-shadow: var(--card-shadow);
  }
  .soon-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    border-radius: 24px;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .soon-tag {
    margin-top: 1.4rem;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .soon h1 {
    margin-top: 0.6rem;
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #0b2559;
  }
  .soon p { margin-top: 0.9rem; color: #475569; font-size: 1.05rem; line-height: 1.65; }
  .soon-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 1.8rem; }
  .soon-home { margin-top: 1.2rem; color: var(--accent-strong); font-weight: 600; }

  @media (max-width: 600px) {
    .soon-card { padding: 2.25rem 1.25rem; }
    .soon-actions, .soon-actions .btn { width: 100%; }
  }
</style>
