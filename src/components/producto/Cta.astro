---
// Cierre (taste-skill): campo plano del color del producto, sin ornamentos.
// Izquierda: texto en blanco y botón de WhatsApp. Derecha: la foto a todo el alto del panel.
import { Image } from 'astro:assets';
import { themeStyle, whatsappHref, type Producto } from '@data/productos';
import imgPersona from '@assets/image/producto/persona.webp';
import './producto.css';
import { arrowIcon } from './icons';

interface Props {
  producto: Producto;
}
const { producto: p } = Astro.props;

const whatsappIcon = `<svg viewBox="0 0 24 24" width="20" height="20" fill="#fff" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>`;
---
<section class="producto-section cta" style={themeStyle(p)}>
  <div class="cta-inner">
    <div class="cta-text">
      <h2 class="reveal">¿Listo para empezar <span class="cta-mark">con {p.nombre}?</span></h2>
      <p class="reveal" style="--d: 100ms">Te mostramos cómo funciona con ejemplos de tu negocio, sin compromiso.</p>
      <a href={whatsappHref(p)} target="_blank" rel="noopener noreferrer" class="wa-btn reveal" style="--d: 200ms">
        <span class="wa-icon" set:html={whatsappIcon} />
        Escríbenos por WhatsApp
        <span class="wa-arrow" set:html={arrowIcon} />
      </a>
    </div>

    <div class="cta-panel">
      <Image
        src={imgPersona}
        alt="Asesor de NANIVA explicando el ERP en una oficina"
        widths={[480, 760, 1100, 1500]}
        sizes="(max-width: 900px) 100vw, 50vw"
        class="cta-photo reveal"
        style="--d: 150ms"
      />
    </div>
  </div>
</section>

<style>
  /* Tarjeta con márgenes (no a todo el ancho) y fondo claro azulado */
  .cta { padding: 4rem clamp(1rem, 3vw, 2.5rem) 5rem; background: #fff; }
  .cta-inner {
    max-width: 1380px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: clamp(380px, 30vw, 480px);
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    overflow: hidden;
    background: linear-gradient(135deg, #f7f9ff 0%, color-mix(in srgb, var(--accent) 10%, #fff) 100%);
    box-shadow: var(--card-shadow);
    color: var(--ink);
    position: relative;
  }

  /* "Gusano" de luz azul que recorre el borde de la tarjeta */
  @property --cta-worm {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .cta-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    padding: 3px;
    background: conic-gradient(
      from var(--cta-worm),
      transparent 0deg 210deg,
      color-mix(in srgb, var(--accent) 25%, transparent) 260deg,
      color-mix(in srgb, var(--accent) 70%, transparent) 315deg,
      var(--accent) 350deg,
      transparent 360deg
    );
    /* Solo se pinta el aro del borde, no el interior */
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    animation: cta-worm 5s linear infinite;
    pointer-events: none;
  }
  @keyframes cta-worm { to { --cta-worm: 360deg; } }

  /* Texto: alineado con el contenido de la página */
  .cta-text {
    align-self: center;
    padding: 3.5rem clamp(1.5rem, 4vw, 4rem);
  }
  .cta-text h2 {
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.025em;
    max-width: 11em;
  }
  .cta-mark { color: var(--accent-strong); }
  .cta-text p { margin-top: 1.25rem; font-size: clamp(1.1rem, 1.35vw, 1.3rem); line-height: 1.5; max-width: 34ch; }

  /* Botón del color del producto con el logo de WhatsApp */
  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 2.25rem;
    padding: 0.75rem 1.6rem 0.75rem 0.8rem;
    border-radius: 999px;
    background: var(--accent-strong);
    color: #fff;
    font-size: 1.08rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .wa-btn:hover { transform: translateY(-2px); background: color-mix(in srgb, var(--accent-strong) 88%, #000); }
  .wa-btn:active { transform: scale(0.98); }
  .wa-btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .wa-icon { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: #22c55e; }
  .wa-arrow { display: inline-flex; transition: transform 0.2s ease; }
  .wa-btn:hover .wa-arrow { transform: translateX(3px); }

  /* Panel derecho: la foto recortada dentro del bloque azul, con margen y esquinas redondeadas */
  .cta-panel {
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem) 0;
  }
  .cta-photo {
    display: block;
    width: 100%;
    height: clamp(300px, 26vw, 420px);
    object-fit: cover;
    object-position: 50% 28%;
    border-radius: 24px;
  }
  .cta-panel:hover .cta-photo { transform: scale(1.02); }
  /* Solo aparece con fundido: sin desplazarse, para no dejar una franja vacía arriba */
  .cta-photo:global(.reveal) { transform: none; transition: opacity 0.9s ease, transform 1.2s ease; }

  @media (max-width: 900px) {
    .cta-inner { grid-template-columns: 1fr; min-height: 0; }
    .cta { padding: 3rem 1rem 3.5rem; }
    .cta-text { padding: 2.5rem 1.5rem 2rem; }
    .cta-panel { padding: 0 1.5rem 2.5rem; }
    .cta-photo { height: 260px; border-radius: 18px; }
  }
  @media (max-width: 480px) {
    .wa-btn { width: 100%; justify-content: center; white-space: nowrap; font-size: 0.95rem; gap: 0.6rem; padding-right: 1rem; }
    .wa-icon { width: 34px; height: 34px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-inner::before { animation: none; opacity: 0; }
    .cta-panel:hover .cta-photo { transform: none; }
    .wa-btn:hover, .wa-btn:hover .wa-arrow { transform: none; }
  }
</style>
