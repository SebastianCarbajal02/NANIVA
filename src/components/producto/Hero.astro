---
// Banner del producto: etiqueta, título, ventajas, botones e imagen
import { Image } from 'astro:assets';
import heroBg from '@assets/image/home/hero/fondo final1-01.webp';
import { themeStyle, whatsappHref, type Producto } from '@data/productos';
import './producto.css';
import { arrowIcon, checkIcon } from './icons';

interface Props {
  producto: Producto;
}
const { producto: p } = Astro.props;

const whatsappIcon = `<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.870 9.870 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.860 9.860 0 0 1-1.510-5.260c.001-5.450 4.436-9.884 9.888-9.884 2.640 0 5.122 1.030 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.450-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.050 0C5.495 0 .160 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.480-8.413Z"/></svg>`;
---
<section
  class:list={['producto-section hero', { 'hero-mint': p.heroBg === 'mint', 'hero-with-card': p.heroCard }]}
  style={p.heroBg === 'mint' ? themeStyle(p) : `${themeStyle(p)}background-image: url('${heroBg.src}');`}
>
  <div class="hero-inner">
    <div class="hero-content">
      <span class:list={['tag reveal', { 'tag-plain': p.heroSimple }]}>{p.eyebrow}</span>
      <h1 class="reveal" style="--d: 60ms">{p.h1.before}<span class="highlight">{p.h1.highlight}</span>{p.h1.after}{p.h1.highlight2 && <span class="highlight">{p.h1.highlight2}</span>}</h1>
      <p class="intro reveal" style="--d: 120ms">{p.intro}</p>
      {p.heroChips.length > 0 && (
        <ul class="chips reveal" style="--d: 180ms">
          {p.heroChips.map((c) => <li><span class="chip-check" set:html={checkIcon} />{c}</li>)}
        </ul>
      )}
      <div class="actions reveal" style="--d: 240ms">
        {p.heroSimple ? (
          <>
            <a href={whatsappHref(p)} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Solicitar demo gratuita
            </a>
            <a href={whatsappHref(p)} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
              <span class="wa-icon" set:html={whatsappIcon} />
              Hablar por WhatsApp
            </a>
          </>
        ) : (
          <>
            <a href={whatsappHref(p)} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Solicitar demo gratis <span set:html={arrowIcon} />
            </a>
            {p.price.from !== null && (
              <a href={p.price.href} class="btn btn-outline">Planes desde S/ {p.price.from} al mes</a>
            )}
          </>
        )}
      </div>
    </div>
    {p.heroCard ? (
      <div class="hero-media">
        <Image
          src={p.heroImg}
          alt={p.heroAlt}
          widths={[360, 560, 760, 1000, 1300]}
          sizes="(max-width: 900px) 90vw, 52vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
        <p class="hero-badge reveal" style="--d: 300ms">
          <span class="hero-badge-icon" set:html={whatsappIcon} />
          {p.heroCard.badge}
        </p>
        <div class="hero-card reveal" style="--d: 360ms">
          <p class="hero-card-title">{p.heroCard.title}</p>
          <Image src={p.heroCard.img} alt={p.heroCard.alt} widths={[200, 380]} sizes="200px" loading="eager" class="hero-card-img" />
        </div>
      </div>
    ) : (
      <Image
        src={p.heroImg}
        alt={p.heroAlt}
        widths={[360, 560, 760, 1000]}
        sizes="(max-width: 900px) 90vw, 46vw"
        loading="eager"
        fetchpriority="high"
        class="hero-img"
      />
    )}
  </div>
</section>

<style>
  .hero {
    background-size: cover;
    background-position: center;
    padding: 7.5rem clamp(1.5rem, 4vw, 4rem) 4rem;
  }
  .hero-inner {
    max-width: 1380px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: center;
    gap: 3rem;
  }
  .hero-content { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .tag {
    display: inline-flex;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
  }
  h1 {
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 11em;
  }
  .intro { font-size: 1.08rem; line-height: 1.7; max-width: 560px;
  font-weight: 450; }
  /* Las 4 ventajas en una sola fila en escritorio */
  .chips { list-style: none; display: flex; flex-wrap: nowrap; gap: 0.45rem; }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    padding: 0.42rem 0.65rem;
    font-size: clamp(0.74rem, 0.42rem + 0.36vw, 0.85rem);
    font-weight: 600;
    color: #1e293b;
  }
  .tag-plain {
    background: none;
    padding: 0;
    border-radius: 0;
    color: var(--accent);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }
  .chip-check { display: inline-flex; color: var(--accent); }
  .actions .btn-whatsapp {
    gap: 0.6rem;
    background: #fff;
    color: var(--ink);
    border: 2px solid #86efac;
    padding: 0.8rem 1.4rem;
  }
  .actions .btn-whatsapp:hover { background: #f0fdf4; border-color: #22c55e; }
  .wa-icon { display: inline-flex; color: #22c55e; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 0.5rem; }
  .hero-img { justify-self: end; width: 100%; height: auto; max-height: 520px; object-fit: contain; object-position: right center; }

  /* Fondo verde menta (Tiendas Digitales): manchas suaves, título azul marino y botón azul */
  .hero-mint {
    --ink: #0b2559;
    background:
      radial-gradient(38rem 26rem at 72% 45%, rgba(134, 239, 172, 0.28), transparent 70%),
      radial-gradient(26rem 20rem at 98% 85%, rgba(94, 234, 212, 0.22), transparent 70%),
      linear-gradient(180deg, #f3fcf7 0%, #eefaf4 100%);
  }
  .hero-mint .intro { color: #475569; }
  /* Mockup de laptop y celular más grande: le damos más ancho a la columna de la imagen */
  /* Solo en escritorio: en celular el banner pasa a una columna (regla de 900px más abajo) */
  @media (min-width: 901px) {
    .hero-mint .hero-inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }
    .hero-mint .hero-img { max-height: 640px; }
    /* El mockup se corre a la derecha, ocupando parte del margen lateral */
    .hero-mint .hero-img { margin-right: calc(-1 * clamp(1rem, 3vw, 3rem)); }
  }
  .hero-mint .actions .btn-primary { background: #0b6cf5; }
  .hero-mint .actions .btn-primary:hover { background: #0a5fd8; }
  .hero-mint .actions .btn-whatsapp { border-color: #bbf7d0; }

  /* Laptop con tarjeta del carrito y aviso flotantes (Tienda Online) */
  .hero-media { position: relative; justify-self: end; width: 100%; max-width: 760px; padding: 4.5rem 0 1.5rem; }
  .hero-media .hero-img { width: 86%; max-height: none; margin: 0; object-position: left center; }
  .hero-badge {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 15rem;
    padding: 0.9rem 1.1rem;
    background: #fff;
    border: var(--border-soft);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow-hover);
    color: var(--accent-strong);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .hero-badge-icon { display: inline-flex; flex-shrink: 0; padding: 0.55rem; border-radius: 50%; background: var(--accent-soft); color: #22c55e; }
  .hero-card {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 30%;
    min-width: 170px;
    padding: 0.9rem 0.6rem 0.6rem;
    background: #fff;
    border: var(--border-soft);
    border-radius: var(--card-radius);
    box-shadow: var(--frame-shadow);
  }
  .hero-card-title { margin: 0 0 0.2rem 0.4rem; font-size: 0.95rem; font-weight: 800; color: var(--ink); }
  .hero-card-img { display: block; width: 100%; height: auto; }
  @media (min-width: 901px) {
    .hero-mint .hero-media .hero-img { max-height: none; margin-right: 0; }
    /* Título en dos líneas, como el diseño de referencia */
    .hero-with-card h1 { max-width: 14em; font-size: clamp(2rem, 0.9rem + 2.1vw, 3rem); }
  }

  /* Laptops pequeñas: si no caben en una fila sin tocar la imagen, van 2 y 2 */
  @media (max-width: 1300px) and (min-width: 901px) {
    .chips { display: grid; grid-template-columns: repeat(2, max-content); }
  }
  @media (max-width: 900px) {
    .hero { padding: 6.5rem 1rem 3rem; }
    .hero-inner { grid-template-columns: 1fr; gap: 2rem; }
    .chips { flex-wrap: wrap; }
    .chips li { font-size: 0.85rem; }
    .hero-img { justify-self: center; object-position: center; max-height: 380px; }
    .hero-media { justify-self: center; padding-top: 3.5rem; }
    .hero-media .hero-img { max-height: none; }
  }
  @media (max-width: 600px) {
    .hero-badge { max-width: 12rem; padding: 0.6rem 0.75rem; font-size: 0.75rem; gap: 0.5rem; }
    .hero-badge-icon { padding: 0.4rem; }
    .hero-card { min-width: 0; width: 36%; padding: 0.6rem 0.4rem 0.4rem; }
    .hero-card-title { font-size: 0.8rem; }
  }
  @media (max-width: 600px) {
    .actions, .actions .btn { width: 100%; }
  }
</style>
