---
// Banner "Comparte tu catálogo en segundos": celular inclinado que sobresale por arriba,
// título con subrayado, texto y recuadros con icono. Usa `producto.shareBanner`.
import { Image } from 'astro:assets';
import { themeStyle, type Producto } from '@data/productos';
import './producto.css';
import { icons } from './icons';

interface Props {
  producto: Producto;
}
const { producto: p } = Astro.props;
const b = p.shareBanner!;

const whatsappGlyph = `<svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>`;
---
<section class="producto-section share" style={themeStyle(p)}>
  <div class="container">
    <div class="share-panel">
      <!-- Ondas verdes en las esquinas derechas -->
      <div class="share-deco" aria-hidden="true">
        <svg class="wave wave-top" viewBox="0 0 260 140" preserveAspectRatio="none"><path d="M0 0h260v140c-30-6-46-40-80-58C130 56 70 70 40 36 24 18 14 8 0 0Z" /></svg>
        <svg class="wave wave-bottom" viewBox="0 0 300 140" preserveAspectRatio="none"><path d="M300 0v140H0c40-6 70-34 120-44 60-12 110-6 140-40 18-20 28-40 40-56Z" /></svg>
      </div>

      <!-- Celular con hojas, avión de papel e ícono de WhatsApp -->
      <div class="share-art">
        <svg class="share-plane" viewBox="0 0 90 120" fill="none" aria-hidden="true">
          <path d="M8 34 70 8 50 62 38 44Z" />
          <path d="M38 44 70 8" />
          <path class="share-plane-trail" d="M30 52C6 70 2 92 24 104s46 6 60 14" />
        </svg>
        <svg class="share-leaves" viewBox="0 0 360 260" aria-hidden="true">
          <defs>
            <linearGradient id="shareLeaf" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" stop-color="#15803d" />
              <stop offset="1" stop-color="#4ade80" />
            </linearGradient>
          </defs>
          <path d="M60 260C0 210-14 120 30 50c40 50 70 130 56 210Z" fill="url(#shareLeaf)" opacity="0.9" />
          <path d="M306 260c60-50 76-140 34-206-44 48-78 124-70 206Z" fill="url(#shareLeaf)" opacity="0.85" />
          <path d="M180 260c-70-26-140-36-180-8 60 8 120 10 180 8Z" fill="#bbf7d0" opacity="0.7" />
        </svg>
        <Image
          src={b.img}
          alt={b.imgAlt}
          widths={[240, 360, 480, 644].filter((w) => w <= b.img.width)}
          sizes="(max-width: 1000px) 150px, 180px"
          class="share-phone"
        />
        <span class="share-wa" aria-hidden="true" set:html={whatsappGlyph} />
        <svg class="share-sparks" viewBox="0 0 50 50" aria-hidden="true"><path d="M10 22 6 4M20 28l18-12M24 40l20 2" /></svg>
      </div>

      <div class="share-text">
        <h2 class="reveal">
          <span class="share-title-line">{b.title}</span>
          <span class="share-highlight">
            {b.highlight}
            <svg class="share-underline" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M4 12C80 4 200 2 296 8" /></svg>
          </span>
        </h2>
        <p class="reveal" style="--d: 80ms">{b.intro}</p>
      </div>

      <ul class="share-items">
        {b.items.map((item, i) => (
          <li class="reveal" style={`--d: ${140 + i * 80}ms`}>
            <span class="share-icon" set:html={icons[item.icon]} />
            {item.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Espacio extra arriba: el celular sobresale del panel */
  .share { padding-top: 6rem; }
  .share .container { max-width: 1560px; }
  .share-panel {
    position: relative;
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    column-gap: 3rem;
    min-height: 380px;
    padding: 2.5rem 2.5rem 2.5rem 0;
    background: linear-gradient(120deg, #f2fbf6 0%, #f7fcfa 50%, #eef9f3 100%);
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    box-shadow: var(--card-shadow);
  }
  .share-deco { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; pointer-events: none; }
  .wave { position: absolute; right: 0; fill: color-mix(in srgb, var(--accent) 55%, #6ee7b7); opacity: 0.55; }
  .wave-top { top: 0; width: 240px; height: 120px; }
  .wave-bottom { bottom: 0; width: 300px; height: 130px; }

  /* El arte ocupa todo el alto del panel; se recorta abajo y sobresale por arriba */
  .share-art {
    position: relative;
    align-self: stretch;
    margin: -2.5rem 0;
    clip-path: inset(-200px -200px 0 0 round 0 0 0 var(--panel-radius));
  }
  .share-leaves { position: absolute; left: -10px; bottom: 0; width: 320px; height: 230px; }
  .share-phone {
    position: absolute;
    left: 70px;
    bottom: -50px;
    width: 180px;
    height: auto;
    transform: rotate(-8deg);
    transform-origin: bottom center;
    filter: drop-shadow(0 24px 34px rgba(15, 23, 42, 0.25));
  }
  .share-wa {
    position: absolute;
    top: 60px;
    right: -6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 104px;
    height: 104px;
    border: 5px solid #fff;
    border-radius: 50% 50% 50% 14%;
    background: radial-gradient(circle at 30% 25%, #4ade80, var(--accent) 55%, var(--accent-strong));
    color: #fff;
    box-shadow: 0 18px 32px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .share-sparks {
    position: absolute;
    top: 24px;
    right: -24px;
    width: 46px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .share-plane {
    position: absolute;
    top: 120px;
    left: 8px;
    width: 56px;
    stroke: color-mix(in srgb, var(--accent) 70%, #6ee7b7);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .share-plane-trail { stroke-dasharray: 5 6; }

  /* Título con "en segundos" en verde y subrayado */
  .share-text h2 {
    font-size: clamp(1.9rem, 2.7vw, 2.75rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #0b2559;
  }
  .share-title-line { white-space: nowrap; }
  .share-highlight { position: relative; display: block; width: fit-content; color: var(--accent); padding-bottom: 0.35rem; }
  .share-underline {
    position: absolute;
    left: 6%;
    bottom: -0.2rem;
    width: 88%;
    height: 14px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .share-text p { margin-top: 1.4rem; max-width: 440px; color: var(--muted); font-size: 1.15rem; line-height: 1.6; }
  /* El texto se separa un poco más del celular, y el celular con su decoración se corre a la derecha (solo escritorio) */
  @media (min-width: 1001px) {
    .share-text { padding-left: 5.5rem; }
    .share-art > * { translate: 40px 0; }
  }

  /* Recuadros con icono, separados por líneas */
  .share-items { position: relative; list-style: none; display: flex; justify-self: center; }
  .share-items li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    width: 104px;
    padding: 0.5rem 0.5rem;
    text-align: center;
    color: #0b2559;
    font-weight: 600;
    line-height: 1.3;
  }
  .share-items li + li { border-left: 1px solid #cfe9db; }
  .share-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    color: var(--accent-strong);
  }
  .share-icon :global(svg) { width: 46px; height: 46px; }

  /* Laptops pequeñas: los recuadros pasan debajo del texto */
  @media (max-width: 1200px) {
    .share-panel { grid-template-columns: 290px minmax(0, 1fr); row-gap: 1.75rem; }
    .share-art { grid-row: 1 / 3; }
    .share-items { grid-column: 2; justify-self: start; margin-left: 5.5rem; }
  }
  @media (max-width: 1000px) {
    .share { padding-top: 6rem; }
    .share-panel { grid-template-columns: 1fr; gap: 1.5rem; padding: 0 1.25rem 2rem; text-align: center; }
    .share-art {
      grid-row: auto;
      height: 300px;
      margin: 0 -1.25rem;
      clip-path: inset(-200px 0 0 0);
    }
    .share-leaves { left: 50%; transform: translateX(-50%); width: 280px; }
    .share-phone { left: calc(50% - 75px); width: 150px; bottom: -60px; }
    .share-wa { top: 30px; right: calc(50% - 145px); width: 80px; height: 80px; }
    .share-wa :global(svg) { width: 38px; height: 38px; }
    .share-sparks { right: calc(50% - 150px); top: -14px; width: 30px; }
    .wave-top { width: 150px; height: 80px; }
    .wave-bottom { width: 150px; height: 60px; }
    .share-title-line { white-space: normal; }
    .share-plane { left: calc(50% - 165px); top: 90px; width: 46px; }
    .share-highlight { margin: 0 auto; }
    .share-text p { margin-left: auto; margin-right: auto; font-size: 1.05rem; }
    .share-items { grid-column: auto; margin-left: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .share-items li { width: auto; padding: 0.25rem; gap: 0.6rem; font-size: 0.8rem; }
    .share-icon { width: 44px; height: 44px; }
    .share-icon :global(svg) { width: 34px; height: 34px; }
  }
</style>
