---
// Pasos: tarjetas con número, icono y flechas entre ellas.
// Si `steps.img` existe, se arma como un reloj: la imagen al centro y los pasos alrededor en sentido horario.
import { Image } from 'astro:assets';
import { themeStyle, type Producto } from '@data/productos';
import './producto.css';
import { arrowIcon, icons } from './icons';

interface Props {
  producto: Producto;
}
const { producto: p } = Astro.props;
const steps = p.steps!;

const stepLabels = ['PRIMER PASO', 'SEGUNDO PASO', 'TERCER PASO', 'CUARTO PASO'];
// Título con la palabra resaltada en el color del producto
const { title, highlight } = steps;
const hi = highlight ? title.indexOf(highlight) : -1;
const titleParts =
  hi < 0 || !highlight
    ? { before: title, mark: '', after: '' }
    : { before: title.slice(0, hi), mark: highlight, after: title.slice(hi + highlight.length) };
---
<section class:list={['producto-section steps', { 'steps-has-img': steps.img }]} style={themeStyle(p)}>
  <div class="container">
    <div class="steps-head">
      <p class="steps-eyebrow reveal"><span>{steps.eyebrow}</span></p>
      <h2 class="reveal" style="--d: 60ms">{titleParts.before}<span class="highlight">{titleParts.mark}</span>{titleParts.after}</h2>
      <p class="steps-intro reveal" style="--d: 120ms">{steps.intro}</p>
    </div>
    {steps.img ? (
      // Ciclo alrededor de la imagen en sentido horario: 1 (arriba izq.) → 2 (arriba der.) → 3 (abajo der.) → 4 (abajo izq.) → 1
      <div class="steps-flow">
        <div class="flow-center">
          <div class="flow-media reveal" style="--d: 120ms">
            <svg class="flow-sparks" width="46" height="46" viewBox="0 0 50 50" aria-hidden="true"><path d="M10 22 6 4M20 28l18-12M24 40l20 2" /></svg>
            <Image
              src={steps.img}
              alt={steps.imgAlt ?? ''}
              widths={[240, 360, 480, 673].filter((w) => w <= steps.img!.width)}
              sizes="(max-width: 1000px) 210px, 230px"
              class="steps-img"
            />
          </div>
        </div>
        <ol class="flow-list">
          {steps.items.map((st, i) => (
            <li class="step flow-step reveal" style={`--d: ${200 + i * 180}ms`}>
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              {st.img ? (
                <span class="step-icon"><span class="step-icon-img" style={`--icon: url(${st.img.src})`} aria-hidden="true" /></span>
              ) : (
                <span class="step-icon" set:html={icons[st.icon]} />
              )}
              <div>
                <span class="step-label">{stepLabels[i]}</span>
                <h3>{st.title}</h3>
                <p>{st.desc}</p>
              </div>
            </li>
          ))}
        </ol>
        {/* Flechas dibujadas a mano que marcan el recorrido */}
        <svg class="flow-arrow flow-arrow-top" width="320" height="50" viewBox="0 0 380 60" aria-hidden="true"><path d="M6 54C110-6 270-6 374 54M356 40l18 14-20 4" /></svg>
        <svg class="flow-arrow flow-arrow-right" width="26" height="70" viewBox="0 0 30 80" aria-hidden="true"><path d="M12 2c9 26 9 48 4 74M6 64l10 13 10-12" /></svg>
        <svg class="flow-arrow flow-arrow-bottom" width="320" height="50" viewBox="0 0 380 60" aria-hidden="true"><path d="M374 6C270 66 110 66 6 6M24 20 6 6l20-4" /></svg>
        <svg class="flow-arrow flow-arrow-left" width="26" height="70" viewBox="0 0 30 80" aria-hidden="true"><path d="M18 78C9 52 9 30 14 4M4 16 14 3l10 12" /></svg>
      </div>
    ) : (
      <ol class="step-list" style={`--steps-cols: minmax(0, 1fr)${' auto minmax(0, 1fr)'.repeat(steps.items.length - 1)}`}>
        {steps.items.map((st, i) => (
          <>
            {i > 0 && (
              <li class="step-arrow reveal" style={`--d: ${i * 180 + 90}ms`} aria-hidden="true">
                <span set:html={arrowIcon} />
              </li>
            )}
            <li class="step reveal" style={`--d: ${i * 180}ms`}>
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              {st.img ? (
                <span class="step-icon"><span class="step-icon-img" style={`--icon: url(${st.img.src})`} aria-hidden="true" /></span>
              ) : (
                <span class="step-icon" set:html={icons[st.icon]} />
              )}
              <span class="step-label">{stepLabels[i]}</span>
              <h3>{st.title}</h3>
              <p>{st.desc}</p>
            </li>
          </>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
  .steps { background: linear-gradient(180deg, #f8fafc, #eef4ff); }
  .steps-head { text-align: center; max-width: 820px; margin: 0 auto 3.5rem; }
  .steps-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .steps-eyebrow::before, .steps-eyebrow::after {
    content: '';
    width: 36px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .steps-head h2 {
    margin-top: 0.75rem;
    font-size: clamp(2.1rem, 4vw, 3.3rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .steps-intro { margin: 0.9rem auto 0; color: var(--muted); font-size: 1.05rem; line-height: 1.6; max-width: 560px; }
  .step-list {
    list-style: none;
    display: grid;
    grid-template-columns: var(--steps-cols);
    align-items: center;
    gap: 1rem;
  }
  .step {
    position: relative;
    align-self: stretch;
    background: #fff;
    border: var(--border-soft);
    border-radius: var(--card-radius);
    padding: 2.4rem 1.6rem 1.8rem;
    box-shadow: var(--card-shadow);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.45s ease;
  }
  .step:hover { transform: translateY(-2px); box-shadow: var(--card-shadow-hover); }
  .step-num {
    position: absolute;
    top: -18px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--accent-strong);
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
    box-shadow: 0 8px 20px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .step:global(.in-view) .step-num { animation: step-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(var(--d, 0ms) + 250ms); }
  @keyframes step-pop { from { transform: scale(0); } to { transform: scale(1); } }
  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 0.45s ease, background-color 0.3s ease, color 0.3s ease;
  }
  .step-icon :global(svg) { width: 28px; height: 28px; }
  /* Icono en imagen (PNG de un color): se usa como máscara y toma el color del icono */
  .step-icon-img {
    width: 36px;
    height: 36px;
    background: var(--accent-strong);
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }
  .step:hover .step-icon { transform: rotate(-6deg) scale(1.06); background: var(--accent); color: #fff; }
  .step-label {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .step h3 { margin-top: 0.7rem; font-size: 1.12rem; color: var(--ink); }
  .step p { margin-top: 0.5rem; color: var(--muted); font-size: 0.95rem; line-height: 1.6; }
  .step-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: #fff;
    color: var(--accent);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
  }
  .step-arrow:global(.in-view) :global(svg) { animation: step-nudge 1.8s ease-in-out 1s infinite; }
  @keyframes step-nudge { 0%, 100% { transform: translateX(-2px); } 50% { transform: translateX(3px); } }

  /* --- Ciclo con imagen: celular inclinado al centro y las 4 tarjetas en las esquinas, en sentido horario --- */
  /* Etiqueta en pastilla */
  .steps-has-img .steps-eyebrow span {
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: var(--accent-soft);
    font-weight: 700;
  }
  .steps-has-img .steps-head { margin-bottom: 3rem; }

  .steps-flow { --flow-center: 380px; position: relative; max-width: 1180px; margin: 0 auto; padding: 3.5rem 0; }
  .flow-list {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--flow-center) minmax(0, 1fr);
    grid-template-rows: auto auto;
    row-gap: 5.5rem;
    align-items: start;
  }
  .flow-step:nth-child(1) { grid-area: 1 / 1; }
  .flow-step:nth-child(2) { grid-area: 1 / 3; }
  .flow-step:nth-child(3) { grid-area: 2 / 3; }
  .flow-step:nth-child(4) { grid-area: 2 / 1; }
  /* Tarjeta horizontal: icono a la izquierda y texto a la derecha */
  .flow-step {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
    padding: 2.1rem 1.75rem 1.75rem;
  }
  .flow-step .step-icon { width: 64px; height: 64px; margin-top: 0.15rem; }
  .flow-step .step-icon :global(svg) { width: 30px; height: 30px; }
  .step:hover .step-icon-img { background: #fff; }
  .flow-step .step-label { margin-top: 0; }
  .flow-step h3 { margin-top: 0.55rem; font-size: 1.2rem; }
  .flow-step p { margin-top: 0.45rem; font-size: 0.95rem; line-height: 1.55; }

  /* Celular al centro, inclinado, con un círculo de luz detrás */
  .flow-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: var(--flow-center);
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .flow-center::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 440px;
    height: 440px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 12%, #fff), transparent);
  }
  .flow-media { position: relative; }
  .steps-img {
    position: relative;
    display: block;
    width: 230px;
    height: auto;
    filter: drop-shadow(0 22px 32px rgba(15, 23, 42, 0.2));
    transform: rotate(6deg);
  }
  .flow-sparks {
    position: absolute;
    top: -14px;
    right: -38px;
    width: 46px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-linecap: round;
  }

  /* Flechas: arco arriba 1 → 2, bajada 2 → 3, arco abajo 3 → 4, subida 4 → 1 */
  .flow-arrow {
    position: absolute;
    fill: none;
    stroke: var(--accent-strong);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }
  /* Las posiciones se calculan con el ancho de la columna central (--flow-center) */
  .flow-arrow-top, .flow-arrow-bottom { left: calc(50% - (var(--flow-center) - 60px) / 2); width: calc(var(--flow-center) - 60px); height: auto; }
  .flow-arrow-top { top: 0; }
  .flow-arrow-bottom { bottom: 0; }
  .flow-arrow-left, .flow-arrow-right { top: calc(50% - 40px); width: 26px; height: auto; }
  .flow-arrow-left { left: calc(25% - var(--flow-center) / 4 - 13px); }
  .flow-arrow-right { left: calc(75% + var(--flow-center) / 4 - 13px); }

  /* Laptops pequeñas: centro más angosto, celular más chico e icono encima del texto */
  @media (max-width: 1200px) and (min-width: 1001px) {
    .steps-flow { --flow-center: 300px; }
    .steps-img { width: 200px; }
    .flow-center::before { width: 360px; height: 360px; }
    .flow-step { grid-template-columns: 1fr; gap: 0.9rem; padding: 2.25rem 1.5rem 1.5rem; }
    .flow-step .step-icon { width: 56px; height: 56px; }
  }

  /* Tablet y celular: el celular arriba, sin flechas, y los pasos en orden debajo */
  @media (max-width: 1000px) {
    .flow-center { position: static; transform: none; width: auto; margin: 0 auto 3rem; }
    .flow-center::before { width: 340px; height: 340px; }
    .steps-img { width: 210px; }
    .flow-arrow { display: none; }
    .flow-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.25rem 1.25rem; max-width: 880px; margin: 0 auto; }
    .flow-step:nth-child(n) { grid-area: auto; align-self: auto; }
  }
  @media (max-width: 640px) {
    .flow-list { grid-template-columns: minmax(0, 1fr); max-width: 560px; }
  }
  @media (max-width: 480px) {
    .flow-step { grid-template-columns: 1fr; gap: 0.9rem; padding: 2.25rem 1.25rem 1.4rem; }
    .flow-step .step-icon { width: 52px; height: 52px; }
    .flow-sparks { right: -26px; width: 36px; }
  }

  @media (max-width: 900px) {
    .step-list { grid-template-columns: 1fr; gap: 1.6rem; }
    .step-arrow { justify-self: center; transform: rotate(90deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .step:hover, .step:hover .step-icon { transform: none; }
    .step:global(.in-view) .step-num, .step-arrow:global(.in-view) :global(svg) { animation: none; }
  }
</style>
