---
import restauranteMockup from '../assets/image/planes/restaurante/chef2232-03.webp';
import restauranteFeatureVentas from '../assets/image/planes/restaurante/iconrestaur-16.png';
import restauranteFeatureComandas from '../assets/image/planes/restaurante/iconrestaur-17.png';
import restauranteFeatureCaja from '../assets/image/planes/restaurante/iconrestaur-18.png';
import mensajeroIcon from '../assets/image/servicios/full/mensajero.webp';
import iconMrestVentas from '../assets/image/planes/restaurante/icommm1-09.png';
import iconMrestBusqueda from '../assets/image/planes/restaurante/icommm1-10.png';
import iconMrestReportes from '../assets/image/planes/restaurante/icommm1-11.png';
import iconMrestClientes from '../assets/image/planes/restaurante/icommm1-12.png';
import iconcaja from '../assets/image/planes/restaurante/iconnnrets-16.png';
import restauranteCtaBanner from '../assets/image/planes/restaurante/banner-ecoomer-abajo.webp';
import iconMrestCaja from '../assets/image/planes/restaurante/icommm1-13.png';
import iconMrestFacil from '../assets/image/planes/restaurante/f1icon-14.png';

// Icon generator function
function icon(name: string, color: string = "#2563eb", size = 22) {
  const icons: Record<string, string> = {
    cloche: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18h18"/><path d="M4 18a8 8 0 0 1 16 0"/><path d="M12 6v2"/><circle cx="12" cy="4" r="1"/></svg>`,
    trend: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.5 8.5-5-5L2 17"/><path d="M16 7h6v6"/></svg>`,
    filetext: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/></svg>`,
    box: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
    user: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20a8 8 0 0 1 16 0"/></svg>`,
    printer: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6"/><rect x="4" y="9" width="16" height="8" rx="1"/><path d="M6 17v4h12v-4"/></svg>`,
    users: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    search: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>`,
    headset: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14v-3a9 9 0 0 1 18 0v3"/><path d="M21 15a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2h3Zm-18 0a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2H3Z"/><path d="M21 15v1a4 4 0 0 1-4 4h-4"/></svg>`,
    rocket: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2Z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>`,
    checkcolor: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`,
    help: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9a4 4 0 1 1 5.5 3.7c-.9.4-1.5 1.3-1.5 2.3v.5"/><path d="M12 18.5h.01"/></svg>`,
  };
  return icons[name] ?? "";
}

const CATALOGO_ANNUAL_DISCOUNT = 0.2;
function annualPricing(monthly: number) {
  const fullYear = monthly * 12;
  const discounted = Math.round(fullYear * (1 - CATALOGO_ANNUAL_DISCOUNT));
  return { fullYear, discounted, savings: fullYear - discounted };
}

const restauranteFeatures = [
  { img: restauranteFeatureVentas, alt: "Registro de Ventas" },
  { img: restauranteFeatureComandas, alt: "Comandas y pre comandas", className: "restaurante-feature-comandas" },
  { img: restauranteFeatureCaja, alt: "Control de Caja" },
  { img: iconcaja, alt: "Control de Stock" },
];

const restauranteHighlights = [
  { img: iconMrestVentas, title: "Registro de ventas", sub: "detallado" },
  { img: iconMrestBusqueda, title: "Búsqueda", sub: "RUC / DNI" },
  { img: iconMrestReportes, title: "Reportes de ventas", sub: "y productos" },
  { img: iconMrestClientes, title: "Historial de clientes", sub: "y preferencias" },
  { img: iconMrestCaja, title: "Control de caja", sub: "y cierres" },
  { img: iconMrestFacil, title: "Fácil de usar", sub: "e intuitivo" },
];

const restaurantePlanBasico = {
  name: "Plan Básico",
  subtitle: "Ideal para pequeños restaurantes",
  monthly: 79,
  highlight: { icon: "trend", text: "Aumenta tus ganancias,", strong: "gestiona tu restaurante con COMANDAS" },
  productsNote: { text: "Vende hasta", strong: "500", suffix: "(Comprobantes Electrónicos)" },
  items: [
    { icon: "filetext", text: "Nota de Ventas" },
    { icon: "filetext", text: "Boletas" },
    { icon: "box", text: "Control de Stock" },
    { icon: "user", text: "Tomador de Pedidos" },
    { icon: "printer", text: "Impresión de Comandas" },
    { icon: "printer", text: "Impresión de Pre-Cuentas" },
    { icon: "users", text: "3 Usuarios" },
    { icon: "trend", text: "Registro de Ventas Detallado" },
    { icon: "search", text: "Busqueda RUC/DNI", sub: "(Interconectado con SUNAT/RENIEC)" },
  ],
  support: { text: "SOPORTE PREMIUM", sub: "LLAMADA Y WHATSAPP" },
  cta: "Empezar ahora",
  ctaIcon: "cart",
};

const restaurantePlanProfesional = {
  name: "Plan Profesional",
  badge: "Más Vendido",
  subtitleParts: ["Agiliza la atención a tus clientes", "y optimiza tus ", "Ventas"],
  tagline: "Vende sin Límites",
  monthly: 118,
  includesNote: "Incluye todo lo del plan Básico más:",
  items: [
    "Facturación electrónica",
    "Nota de Ventas",
    "Boletas",
    "Gestión de Inventario",
    "Tomador de Pedidos",
    "Impresión de Comandas",
    "Impresión de Pre-Cuentas",
    "Usuarios ilimitados",
    "Modificadores de Complementos",
    "Registro de Ventas Detallado",
    { text: "Busqueda RUC/DNI", sub: "(Interconectado con SUNAT/RENIEC)" },
  ],
  support: { text: "SOPORTE PREMIUM", sub: "LLAMADA Y WHATSAPP" },
  cta: "Empezar ahora",
  ctaIcon: "rocket",
};
---

<section id="ecommerce" class="erp-detail restaurante-detail product-detail">
  <div class="container erp-hero">
    <div class="erp-hero-copy reveal">
      <span class="erp-badge restaurante-badge">
        <span set:html={icon("cloche", "#7c3aed", 15)} />
        Restaurante
      </span>
      <h2>Sistema <span class="p-highlight restaurante-highlight">Restaurantes</span></h2>
      <p class="erp-hero-sub">Vender más a través de todos los canales. Comparte tu catálogo, recibe pedidos y convierte consultas en ventas.</p>

      <div class="catalogo-features">
        {restauranteFeatures.map((f) => (
          <img src={f.img.src} alt={f.alt} class={`catalogo-feature-img ${f.className ?? ""}`} />
        ))}
      </div>

      <div class="erp-cta">
        <a href="https://wa.link/n2whmv" class="btn-primary restaurante-btn-primary hover-pop">Comenzar ahora</a>
        <a href="https://wa.link/s6p6ci" class="btn-outline restaurante-btn-outline hover-pop">Solicitar demostración</a>
      </div>
    </div>

    <div class="erp-hero-media reveal">
      <img src={restauranteMockup.src} alt="Sistema Restaurantes Naniva" class="erp-mockup-img restaurante-mockup-img" />
    </div>
  </div>

  <div class="container restaurante-highlights-wrap reveal">
    <div class="restaurante-highlights">
      <h3 class="restaurante-highlights-title">
        <span class="audience-dash restaurante-dash"></span> Todo lo que <span class="restaurante-highlight">tu restaurante</span> necesita <span class="audience-dash restaurante-dash"></span>
      </h3>
      <div class="restaurante-highlights-row">
        {restauranteHighlights.map((h) => (
          <div class="restaurante-highlight-item">
            <span class="restaurante-highlight-icon">
              <img src={h.img.src} alt={h.title} />
            </span>
            <span class="restaurante-highlight-dot"></span>
            <strong>{h.title}</strong>
            <span>{h.sub}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="container restaurante-pricing reveal" data-billing-scope="restaurante">
    <div class="catalogo-pricing-head">
      <span class="erp-badge restaurante-pricing-badge">Planes para cada tipo de restaurante</span>
      <h2 class="restaurante-pricing-title">Elige el plan ideal para tu negocio</h2>
    </div>

    <div class="billing-toggle restaurante-billing-toggle">
      <button type="button" class="billing-toggle-btn restaurante-toggle-btn is-active" data-billing-btn="mensual">Mensual</button>
      <button type="button" class="billing-toggle-btn restaurante-toggle-btn" data-billing-btn="anual">Anual</button>
    </div>
    <p class="billing-savings-note restaurante-savings-note" data-billing-note="anual">Ahorra {Math.round(CATALOGO_ANNUAL_DISCOUNT * 100)}% pagando anual</p>

    <div class="restaurante-plans-grid billing-panel is-active" data-billing-panel="mensual">
      <div class="restaurante-plan-card">
        <span class="restaurante-plan-icon" set:html={icon("cloche", "#7c3aed", 26)} />
        <h3 class="restaurante-plan-name">{restaurantePlanBasico.name}</h3>
        <p class="restaurante-plan-subtitle">{restaurantePlanBasico.subtitle}</p>

        <div class="restaurante-highlight-box">
          <span set:html={icon(restaurantePlanBasico.highlight.icon, "#7c3aed", 18)} />
          <span>{restaurantePlanBasico.highlight.text} <strong>{restaurantePlanBasico.highlight.strong}</strong></span>
        </div>

        <div class="restaurante-plan-price-block">
          <div class="plan-price restaurante-plan-price"><span class="plan-price-S">S/</span> {restaurantePlanBasico.monthly}<span class="plan-price-unit">por mes</span></div>
        </div>

        <div class="restaurante-note-box">
          {restaurantePlanBasico.productsNote.text} <strong>{restaurantePlanBasico.productsNote.strong}</strong> {restaurantePlanBasico.productsNote.suffix}
        </div>

        <ul class="restaurante-plan-items">
          {restaurantePlanBasico.items.map((it) => (
            <li>
              <span class="restaurante-item-icon" set:html={icon(it.icon, "#7c3aed", 17)} />
              <span>
                {it.text}
                {it.sub && <span class="plan-item-sub restaurante-item-sub">{it.sub}</span>}
              </span>
            </li>
          ))}
        </ul>

        <div class="restaurante-support-row">
          <span set:html={icon("headset", "#7c3aed", 18)} />
          <span>
            <strong>{restaurantePlanBasico.support.text}</strong>
            <span class="restaurante-support-sub">{restaurantePlanBasico.support.sub}</span>
          </span>
        </div>

        <a href="https://wa.link/64jjx7" class="plan-cta-btn restaurante-cta-btn hover-pop">
          <span set:html={icon(restaurantePlanBasico.ctaIcon, "currentColor", 16)} /> {restaurantePlanBasico.cta}
        </a>
      </div>

      <div class="restaurante-plan-card restaurante-plan-card-featured">
        <span class="plan-badge restaurante-plan-badge">★ {restaurantePlanProfesional.badge}</span>
        <h3 class="restaurante-plan-name">{restaurantePlanProfesional.name}</h3>
        <p class="restaurante-plan-subtitle">
          {restaurantePlanProfesional.subtitleParts[0]}<br />
          {restaurantePlanProfesional.subtitleParts[1]}<strong>{restaurantePlanProfesional.subtitleParts[2]}</strong>
        </p>

        <div class="restaurante-tagline">
          <span class="audience-dash restaurante-dash"></span>
          <span set:html={icon("rocket", "#7c3aed", 16)} /> {restaurantePlanProfesional.tagline} <span set:html={icon("rocket", "#7c3aed", 16)} />
          <span class="audience-dash restaurante-dash"></span>
        </div>

        <div class="restaurante-plan-price-block">
          <div class="plan-price restaurante-plan-price"><span class="plan-price-S">S/</span> {restaurantePlanProfesional.monthly}<span class="plan-price-unit">por mes</span></div>
        </div>

        <p class="restaurante-includes-note">{restaurantePlanProfesional.includesNote}</p>

        <ul class="restaurante-plan-items restaurante-plan-items-check">
          {restaurantePlanProfesional.items.map((it) => (
            <li>
              <span class="restaurante-item-icon" set:html={icon("checkcolor", "#7c3aed", 16)} />
              <span>
                {typeof it === "string" ? it : (<>{it.text}<span class="plan-item-sub restaurante-item-sub">{it.sub}</span></>)}
              </span>
            </li>
          ))}
        </ul>

        <div class="restaurante-support-row">
          <strong>{restaurantePlanProfesional.support.text}</strong>
          <span class="restaurante-support-sub">{restaurantePlanProfesional.support.sub}</span>
        </div>

        <a href="https://wa.link/57fb8p" class="plan-cta-btn plan-cta-btn-filled restaurante-cta-btn restaurante-cta-btn-filled hover-pop">
          <span set:html={icon(restaurantePlanProfesional.ctaIcon, "white", 16)} /> {restaurantePlanProfesional.cta}
        </a>
      </div>
    </div>

    <div class="restaurante-plans-grid billing-panel" data-billing-panel="anual">
      <div class="restaurante-plan-card">
        <span class="restaurante-plan-icon" set:html={icon("cloche", "#7c3aed", 26)} />
        <h3 class="restaurante-plan-name">{restaurantePlanBasico.name}</h3>
        <p class="restaurante-plan-subtitle">{restaurantePlanBasico.subtitle}</p>

        <div class="restaurante-highlight-box">
          <span set:html={icon(restaurantePlanBasico.highlight.icon, "#7c3aed", 18)} />
          <span>{restaurantePlanBasico.highlight.text} <strong>{restaurantePlanBasico.highlight.strong}</strong></span>
        </div>

        <div class="restaurante-plan-price-block">
          <span class="plan-price-strike">S/ {annualPricing(restaurantePlanBasico.monthly).fullYear.toLocaleString("es-PE")}</span>
          <div class="plan-price restaurante-plan-price"><span class="plan-price-S">S/</span> {annualPricing(restaurantePlanBasico.monthly).discounted.toLocaleString("es-PE")}<span class="plan-price-unit">por año</span></div>
          <span class="plan-savings-note restaurante-plan-savings">Ahorra S/ {annualPricing(restaurantePlanBasico.monthly).savings.toLocaleString("es-PE")} al año</span>
        </div>

        <div class="restaurante-note-box">
          {restaurantePlanBasico.productsNote.text} <strong>{restaurantePlanBasico.productsNote.strong}</strong> {restaurantePlanBasico.productsNote.suffix}
        </div>

        <ul class="restaurante-plan-items">
          {restaurantePlanBasico.items.map((it) => (
            <li>
              <span class="restaurante-item-icon" set:html={icon(it.icon, "#7c3aed", 17)} />
              <span>
                {it.text}
                {it.sub && <span class="plan-item-sub restaurante-item-sub">{it.sub}</span>}
              </span>
            </li>
          ))}
        </ul>

        <div class="restaurante-support-row">
          <span set:html={icon("headset", "#7c3aed", 18)} />
          <span>
            <strong>{restaurantePlanBasico.support.text}</strong>
            <span class="restaurante-support-sub">{restaurantePlanBasico.support.sub}</span>
          </span>
        </div>

        <a href="https://wa.link/57fb8p" class="plan-cta-btn restaurante-cta-btn hover-pop">
          <span set:html={icon(restaurantePlanBasico.ctaIcon, "currentColor", 16)} /> {restaurantePlanBasico.cta}
        </a>
      </div>

      <div class="restaurante-plan-card restaurante-plan-card-featured">
        <span class="plan-badge restaurante-plan-badge">★ {restaurantePlanProfesional.badge}</span>
        <h3 class="restaurante-plan-name">{restaurantePlanProfesional.name}</h3>
        <p class="restaurante-plan-subtitle">
          {restaurantePlanProfesional.subtitleParts[0]}<br />
          {restaurantePlanProfesional.subtitleParts[1]}<strong>{restaurantePlanProfesional.subtitleParts[2]}</strong>
        </p>

        <div class="restaurante-tagline">
          <span class="audience-dash restaurante-dash"></span>
          <span set:html={icon("rocket", "#7c3aed", 16)} /> {restaurantePlanProfesional.tagline} <span set:html={icon("rocket", "#7c3aed", 16)} />
          <span class="audience-dash restaurante-dash"></span>
        </div>

        <div class="restaurante-plan-price-block">
          <span class="plan-price-strike">S/ {annualPricing(restaurantePlanProfesional.monthly).fullYear.toLocaleString("es-PE")}</span>
          <div class="plan-price restaurante-plan-price"><span class="plan-price-S">S/</span> {annualPricing(restaurantePlanProfesional.monthly).discounted.toLocaleString("es-PE")}<span class="plan-price-unit">por año</span></div>
          <span class="plan-savings-note restaurante-plan-savings">Ahorra S/ {annualPricing(restaurantePlanProfesional.monthly).savings.toLocaleString("es-PE")} al año</span>
        </div>

        <p class="restaurante-includes-note">{restaurantePlanProfesional.includesNote}</p>

        <ul class="restaurante-plan-items restaurante-plan-items-check">
          {restaurantePlanProfesional.items.map((it) => (
            <li>
              <span class="restaurante-item-icon" set:html={icon("checkcolor", "#7c3aed", 16)} />
              <span>
                {typeof it === "string" ? it : (<>{it.text}<span class="plan-item-sub restaurante-item-sub">{it.sub}</span></>)}
              </span>
            </li>
          ))}
        </ul>

        <div class="restaurante-support-row">
          <strong>{restaurantePlanProfesional.support.text}</strong>
          <span class="restaurante-support-sub">{restaurantePlanProfesional.support.sub}</span>
        </div>

        <a href="/contacto" class="plan-cta-btn plan-cta-btn-filled restaurante-cta-btn restaurante-cta-btn-filled hover-pop">
          <span set:html={icon(restaurantePlanProfesional.ctaIcon, "white", 16)} /> {restaurantePlanProfesional.cta}
        </a>
      </div>
    </div>
  </div>

  <div class="container catalogo-compare restaurante-compare reveal">
    <div class="compare-layout">
      <div class="rc-wrap">
        <div class="rc-basico">
          <div class="rc-label-head">
            <span class="compare-label-title restaurante-compare-label-title">CARACTERÍSTICAS</span>
          </div>
          <div class="rc-plan-head">
            <span class="restaurante-compare-icon" set:html={icon("cloche", "#7c3aed", 20)} />
            <span class="compare-plan-name">{restaurantePlanBasico.name}</span>
            <p class="restaurante-compare-plan-sub">{restaurantePlanBasico.subtitle}</p>
            <div class="restaurante-compare-price-pill"><span class="plan-price-S">S/</span> {restaurantePlanBasico.monthly}<span class="plan-price-unit">por mes</span></div>
          </div>

          <div class="rc-row-label">
            <span class="compare-label-icon" set:html={icon(restaurantePlanBasico.highlight.icon, "#7c3aed", 15)} />
            <span class="compare-label-text restaurante-compare-label-text">
              {restaurantePlanBasico.highlight.text}
              <span class="compare-label-sub restaurante-compare-label-sub">{restaurantePlanBasico.highlight.strong}</span>
            </span>
          </div>
          <div class="rc-row-value"></div>

          <div class="rc-row-label">
            <span class="compare-label-icon" set:html={icon("box", "#7c3aed", 15)} />
            <span class="compare-label-text restaurante-compare-label-text">
              {restaurantePlanBasico.productsNote.text} {restaurantePlanBasico.productsNote.strong}
              <span class="compare-label-sub restaurante-compare-label-sub">{restaurantePlanBasico.productsNote.suffix}</span>
            </span>
          </div>
          <div class="rc-row-value">
            <span class="compare-check restaurante-compare-check" set:html={icon("checkcolor", "#7c3aed", 16)} />
          </div>

          {restaurantePlanBasico.items.map((it) => (
            <>
              <div class="rc-row-label">
                <span class="compare-label-icon" set:html={icon(it.icon, "#64748b", 15)} />
                <span class="compare-label-text restaurante-compare-label-text">
                  {it.text}
                  {it.sub && <span class="compare-label-sub restaurante-compare-label-sub">{it.sub}</span>}
                </span>
              </div>
              <div class="rc-row-value">
                <span class="compare-check restaurante-compare-check" set:html={icon("checkcolor", "#7c3aed", 16)} />
              </div>
            </>
          ))}

          <div class="rc-row-label">
            <span class="compare-label-icon" set:html={icon("headset", "#7c3aed", 15)} />
            <span class="compare-label-text restaurante-compare-label-text">
              {restaurantePlanBasico.support.text}
              <span class="compare-label-sub restaurante-compare-label-sub">{restaurantePlanBasico.support.sub}</span>
            </span>
          </div>
          <div class="rc-row-value">
