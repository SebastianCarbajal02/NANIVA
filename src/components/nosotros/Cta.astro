---
// Cierre de /nosotros: banner "Estamos para ayudarte" con WhatsApp y formulario de contacto
import { icons, arrowIcon } from '@components/producto/icons';
import './nosotros.css';

const whatsapp = `https://wa.me/51937292341?text=${encodeURIComponent('Hola, quiero conocer más sobre NANIVA')}`;
const whatsappIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>`;
const mailIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>`;
---

<section class="ns-section ns-azul help">
  <div class="container">
    <div class="help-banner reveal">
      <div class="help-head">
        <span class="help-icon" set:html={icons.headset} />
        <div>
          <span class="help-eyebrow">¿DUDAS O CONSULTAS?</span>
          <h2>Estamos para ayudarte</h2>
        </div>
      </div>
      <p class="help-text">
        Si necesitas más información sobre nuestros servicios, puedes contactarnos por WhatsApp o llenar el formulario de contacto.
      </p>
      <div class="help-actions">
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="help-btn help-btn-light">
          <span class="help-btn-icon" set:html={whatsappIcon} />
          Contactar por WhatsApp
          <span class="help-btn-icon" set:html={arrowIcon} />
        </a>
        <a href="/contacto" class="help-btn help-btn-ghost">
          <span class="help-btn-icon" set:html={mailIcon} />
          Enviar mensaje
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Casi todo el ancho de la pantalla, como los demás banners anchos del sitio */
  .help .container { max-width: 1680px; }

  /* Panel: regla de bordes del sitio (.claude/skills/naniva-bordes) */
  .help-banner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 3rem;
    padding: 2.75rem 3.5rem;
    background:
      radial-gradient(circle at 0% 0%, rgba(255, 255, 255, 0.18), transparent 40%),
      radial-gradient(circle at 100% 100%, rgba(255, 255, 255, 0.16), transparent 40%),
      linear-gradient(110deg, #3b8cf6 0%, #1d63e8 50%, #4f95f7 100%);
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    box-shadow: var(--card-shadow);
    color: #fff;
  }
  .help-head { display: flex; align-items: center; gap: 1.25rem; }
  .help-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    color: #fff;
  }
  .help-icon :global(svg) { width: 34px; height: 34px; }
  .help-eyebrow { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.08em; color: #dbeafe; }
  .help-head h2 { margin-top: 0.2rem; font-size: clamp(1.5rem, 1.2rem + 1vw, 2.05rem); font-weight: 700; line-height: 1.2; }
  .help-text {
    max-width: 34rem;
    padding-left: 3rem;
    border-left: 1px solid rgba(255, 255, 255, 0.35);
    color: #eff6ff;
    font-size: 1rem;
    line-height: 1.65;
  }
  .help-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .help-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 52px;
    padding: 0.85rem 1.7rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.2s ease;
  }
  .help-btn:hover { transform: translateY(-2px); }
  .help-btn:focus-visible { outline: 3px solid #bfdbfe; outline-offset: 3px; }
  .help-btn-light { background: #fff; color: #1d4ed8; }
  .help-btn-ghost { border: 1.5px solid rgba(255, 255, 255, 0.8); color: #fff; }
  .help-btn-ghost:hover { background: rgba(255, 255, 255, 0.12); }
  .help-btn-icon { display: inline-flex; }
  .help-btn-icon :global(svg) { width: 20px; height: 20px; }

  @media (max-width: 1100px) {
    .help-banner { grid-template-columns: auto minmax(0, 1fr); }
    .help-actions { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .help-banner { grid-template-columns: 1fr; gap: 1rem; padding: 1.25rem; }
    .help-text { padding-left: 0; border-left: none; }
    .help-actions { flex-direction: column; }
    .help-btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .help-btn { transition: none; }
    .help-btn:hover { transform: none; }
  }
</style>
