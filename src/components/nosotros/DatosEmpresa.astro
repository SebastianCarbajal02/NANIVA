---
// "Datos de la empresa": texto a la izquierda y panel con razón social, RUC y contacto a la derecha (señal de confianza)
import { icons, arrowIcon } from '@components/producto/icons';
import './nosotros.css';

const svg = (paths: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
const buildingIcon = svg('<path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M16 9h2a2 2 0 0 1 2 2v10M2 21h20"/><path d="M8 7h4M8 11h4M8 15h4"/>');
const idIcon = svg('<rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="8" cy="11" r="2"/><path d="M5 16a3 3 0 0 1 6 0M14 10h5M14 14h4"/>');
const pinIcon = svg('<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>');
const callIcon = svg('<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>');
const mailIcon = svg('<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>');

const datos = [
  { icon: buildingIcon, label: 'Razón social', value: 'NANIVA TECHNOLOGIES S.A.C.' },
  { icon: idIcon, label: 'RUC', value: '20615608221' },
  { icon: pinIcon, label: 'Dirección', value: 'Calle Manrique de Luna 168, San Miguel, Lima' },
  { icon: callIcon, label: 'Teléfono', value: '+51 937 292 341', href: 'tel:+51937292341' },
  { icon: mailIcon, label: 'Correo', value: 'ventas@naniva.com', href: 'mailto:ventas@naniva.com' },
  { icon: icons.clock, label: 'Horario', value: 'Lunes a viernes, de 9:00 a 18:00' },
  { icon: icons.file, label: 'Facturación electrónica', value: 'SEE – Del Contribuyente de SUNAT' },
  { icon: icons.users, label: 'Atención al consumidor', value: 'Libro de Reclamaciones', href: '/libro-reclamaciones' },
];
---

<section class="ns-section">
  <div class="container company reveal">
    <div class="company-copy">
      <span class="eyebrow">NUESTRA EMPRESA</span>
      <h2>Datos de la <span class="hl">empresa</span></h2>
      <p>Somos una empresa formal, con oficina en Lima. Puedes verificar nuestros datos o visitarnos en horario de atención.</p>
      <a href="/contacto" class="btn btn-outline">
        <span class="btn-icon" set:html={icons.user} />
        Ir a contacto
        <span set:html={arrowIcon} />
      </a>
    </div>
    <dl class="company-data">
      {datos.map((d) => (
        <div class="company-item">
          <span class="company-icon" set:html={d.icon} />
          <div>
            <dt>{d.label}</dt>
            <dd>{d.href ? <a href={d.href}>{d.value}</a> : d.value}</dd>
          </div>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .company {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 2.5rem;
    align-items: center;
  }
  .company-copy h2 {
    margin-top: 0.85rem;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
  }
  .hl { color: #2563eb; }
  .company-copy p { margin: 0.75rem 0 1.5rem; max-width: 28rem; color: #475569; font-size: 0.98rem; line-height: 1.7; }
  .btn-icon { display: inline-flex; }
  .btn-icon :global(svg) { width: 17px; height: 17px; }

  /* Panel: regla de bordes del sitio (.claude/skills/naniva-bordes) */
  .company-data {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: column;
    grid-template-rows: repeat(4, auto);
    column-gap: 2rem;
    padding: 0.5rem 1.75rem;
    background: #fff;
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    box-shadow: var(--card-shadow);
    background-image: linear-gradient(#f1f5f9, #f1f5f9);
    background-size: 1px calc(100% - 2.5rem);
    background-position: center;
    background-repeat: no-repeat;
  }
  .company-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid #f1f5f9;
  }
  .company-item:nth-child(4n) { border-bottom: none; }
  .company-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #eff6ff;
    color: #2563eb;
  }
  .company-icon :global(svg) { width: 19px; height: 19px; }
  .company-item dt { color: #64748b; font-size: 0.82rem; }
  .company-item dd { margin-top: 0.1rem; color: #0f172a; font-size: 0.92rem; font-weight: 700; overflow-wrap: anywhere; }
  .company-item a { color: #1d4ed8; text-decoration: none; }
  .company-item a:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 960px) {
    .company { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 640px) {
    .company-data {
      grid-template-columns: 1fr;
      grid-auto-flow: row;
      grid-template-rows: none;
      padding: 0.5rem 1.25rem;
      background-image: none;
    }
    .company-item:nth-child(4n) { border-bottom: 1px solid #f1f5f9; }
    .company-item:last-child { border-bottom: none; }
  }
</style>
