---
import iconTelefono from '../assets/image/contacto/telefono.png';
import iconEmail from '../assets/image/contacto/email.png';
import iconHorario from '../assets/image/contacto/reloj-circular.png';
import iconDireccion from '../assets/image/contacto/ubicacion.png';

const contactInfo = [
  { icon: iconTelefono, title: "Teléfono", value: "+51 908 644 190" },
  { icon: iconEmail, title: "Email", value: "nanivatechnologies@gmail.com" },
  { icon: iconHorario, title: "Horario", value: "Lun - Vie 9:00 am - 6:00 pm" },
  { icon: iconDireccion, title: "Dirección", value: "Calle Manrique de Luna 168, San Miguel, Lima, Perú" },
];
---
<section class="contact-section">
  <div class="container">
    <div class="contact-grid">
      <form id="contactForm" class="contact-form reveal">
        <h2>Envíanos un mensaje</h2>
        <p class="form-sub">Completa el formulario y te responderemos a la brevedad.</p>
        <div class="field">
          <label for="name">Nombre completo</label>
          <input id="name" name="name" type="text" placeholder="Tu nombre" required />
        </div>
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input id="email" name="email" type="email" placeholder="tu@email.com" required />
        </div>
        <div class="field">
          <label for="phone">Teléfono</label>
          <input id="phone" name="phone" type="tel" placeholder="+51 999 999 999" />
        </div>
        <div class="field">
          <label for="message">Mensaje</label>
          <textarea id="message" name="message" rows="4" placeholder="Cuéntanos sobre tu negocio..." required></textarea>
        </div>
        <button type="submit" class="submit-btn hover-pop">Enviar mensaje</button>
      </form>

      <div class="contact-info" id="info">
        {contactInfo.map((c, i) => (
          <div class="info-card reveal hover-lift" style={`transition-delay:${i * 0.1}s`}>
            <span class="info-icon" style={`-webkit-mask-image:url('${c.icon.src}'); mask-image:url('${c.icon.src}');`}></span>
            <div>
              <h3>{c.title}</h3>
              <p>{c.value}</p>
            </div>
          </div>
        ))}
        <a href="https://wa.me/51908644190" target="_blank" rel="noopener noreferrer" class="whatsapp-card reveal hover-lift pulse-ring whatsapp">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="#25D366" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.92 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2m0 1.67a8.2 8.2 0 0 1 5.83 2.42 8.19 8.19 0 0 1 2.41 5.82c0 4.55-3.7 8.25-8.25 8.25a8.25 8.25 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.39c0-4.55 3.7-8.24 8.26-8.24m-4.53 4.7c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.03 0 1.2.87 2.35.99 2.51.12.16 1.7 2.7 4.19 3.7 2.07.82 2.49.66 2.94.62.45-.04 1.45-.6 1.65-1.17.2-.58.2-1.08.14-1.18-.06-.1-.22-.16-.46-.28-.24-.12-1.45-.72-1.67-.8-.22-.08-.39-.12-.55.12-.16.24-.63.8-.78.97-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.42-.55-.42h-.47z"/>
          </svg>
          <div>
            <h3>Escríbenos por WhatsApp</h3>
            <p>Respuesta inmediata</p>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div id="formModal" class="form-modal-backdrop" hidden>
    <div class="form-modal" role="dialog" aria-modal="true" aria-labelledby="formModalTitle">
      <div class="form-modal-progress"></div>
      <button type="button" class="form-modal-close" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <span class="form-modal-icon"></span>
      <h3 id="formModalTitle">Formulario enviado</h3>
      <p>¡Gracias! Tu mensaje fue enviado correctamente. Te responderemos pronto.</p>
      <button type="button" class="form-modal-btn hover-pop">Entendido</button>
    </div>
  </div>
</section>

<style>
  .contact-section { background: #f8fafc; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  .contact-form {
    background: white;
    border-radius: 18px;
    padding: 2.5rem;
    box-shadow: 0 4px 14px rgba(15,23,42,0.06);
  }
  .contact-form h2 { font-size: 1.4rem; color: #0f172a; margin-bottom: 0.4rem; }
  .form-sub { color: #64748b; font-size: 0.9rem; margin-bottom: 1.75rem; }
  .field { margin-bottom: 1.25rem; }
  .field label { display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem; }
  .field input, .field textarea {
    width: 100%;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    font-family: inherit;
    color: #0f172a;
    resize: vertical;
  }
  .field input:focus, .field textarea:focus {
    outline: none;
    border-color: #2563eb;
  }
  .submit-btn {
    width: 100%;
    background: #2563eb;
    color: white;
    border: none;
    padding: 0.9rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .contact-info { display: flex; flex-direction: column; gap: 1rem; }
  .info-card, .whatsapp-card {
    background: white;
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 4px 14px rgba(15,23,42,0.06);
  }
  .info-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background-color: #2563eb;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }
  .info-card h3, .whatsapp-card h3 { font-size: 0.95rem; color: #0f172a; margin-bottom: 0.2rem; }
  .info-card p, .whatsapp-card p { font-size: 0.85rem; color: #64748b; }
  .whatsapp-card {
    text-decoration: none;
    border: 1px solid #d1fae5;
  }

  @media (max-width: 600px) {
    .contact-form { padding: 1.5rem; }
  }
</style>

<script>
  import { initFormModal } from '../scripts/form-modal';

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const submitBtn = form?.querySelector<HTMLButtonElement>('.submit-btn');

  const { show: showModal } = initFormModal();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const originalText = submitBtn?.textContent;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
    }

    try {
      const formData = new FormData(form);
      formData.append('access_key', import.meta.env.PUBLIC_WEB3FORMS_KEY);
      formData.append('subject', 'Nuevo mensaje desde NANIVA Web');
      formData.append('from_name', 'Formulario Web NANIVA');

      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || 'Error al enviar el mensaje');
      }

      showModal('success', 'Formulario enviado', '¡Gracias! Tu mensaje fue enviado correctamente. Te responderemos pronto.');
      form.reset();
    } catch (error) {
      console.error('Error al enviar el formulario de contacto:', error);
      showModal('error', 'No se pudo enviar', 'Hubo un error al enviar tu mensaje. Por favor intenta nuevamente.');
    } finally {
      if (submitBtn && originalText) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    }
  });
</script>
