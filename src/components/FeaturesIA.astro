---
import icon13 from '../assets/image/IA/icong-13.webp';
import icon12 from '../assets/image/IA/icong-12.webp';
import icon11 from '../assets/image/IA/icong-11.webp';
import icon14 from '../assets/image/IA/icong-14.webp';
import icon15 from '../assets/image/IA/icong-15.webp';

const features = [
  {
    icon: icon13,
    title: 'Análisis predictivo',
    desc: 'Anticipa tendencias y comportamientos para tomar decisiones con ventaja.',
  },
  {
    icon: icon12,
    title: 'Aprendizaje continuo',
    desc: 'La IA aprende de tu negocio cada día y mejora sus recomendaciones.',
  },
  {
    icon: icon11,
    title: 'Integración total',
    desc: 'Conecta todas las áreas de tu empresa y centraliza tus datos.',
  },
  {
    icon: icon14,
    title: 'Reportes inteligentes',
    desc: 'Informes automáticos y personalizados en segundos, no en horas.',
  },
  {
    icon: icon15,
    title: 'Alertas en tiempo real',
    desc: 'Recibe notificaciones sobre oportunidades y riesgos importantes.',
  },
];
---

<section class="features-ia">
  <div class="container">
    <h2 class="features-title reveal">Más que datos, inteligencia que impulsa tu crecimiento.</h2>

    <div class="features-carousel-wrap">
      <button type="button" class="carousel-arrow carousel-arrow-prev" aria-label="Feature anterior">‹</button>
      <button type="button" class="carousel-arrow carousel-arrow-next" aria-label="Siguiente feature">›</button>

      <div class="features-grid">
        {features.map((feature, i) => (
          <div class="feature-card reveal hover-lift" style={`transition-delay:${i * 0.08}s`}>
            <div class="feature-icon-container">
              <img src={feature.icon.src} alt={feature.title} class="feature-icon" />
            </div>
            <h3 class="feature-card-title">{feature.title}</h3>
            <p class="feature-card-desc">{feature.desc}</p>
          </div>
        ))}
      </div>

      <div class="carousel-dots">
        {features.map((_, i) => (
          <button type="button" class="carousel-dot" data-index={i} aria-label={`Ir a la feature ${i + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initFeaturesCarousel() {
    const wrap = document.querySelector<HTMLElement>(".features-carousel-wrap");
    const track = document.querySelector<HTMLElement>(".features-grid");
    if (!wrap || !track) return;

    const slides = Array.from(track.querySelectorAll<HTMLElement>(".feature-card"));
    const dots = Array.from(wrap.querySelectorAll<HTMLButtonElement>(".carousel-dot"));
    const prevBtn = wrap.querySelector<HTMLButtonElement>(".carousel-arrow-prev");
    const nextBtn = wrap.querySelector<HTMLButtonElement>(".carousel-arrow-next");

    const mq = window.matchMedia("(max-width: 480px)");
    let active = false;

    const setActiveDot = (index: number) => {
      dots.forEach((d, i) => d.classList.toggle("is-active", i === index));
    };

    const currentIndex = () => {
      const scrollLeft = track.scrollLeft;
      const width = track.clientWidth;
      return Math.round(scrollLeft / width);
    };

    let animFrame: number | null = null;
    const easeInOutQuad = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

    const animateScrollTo = (target: number, duration = 600) => {
      if (animFrame) cancelAnimationFrame(animFrame);
      track.classList.add("is-animating");
      const start = track.scrollLeft;
      const distance = target - start;
      const startTime = performance.now();

      const step = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        track.scrollLeft = start + distance * easeInOutQuad(progress);
        if (progress < 1) {
          animFrame = requestAnimationFrame(step);
        } else {
          animFrame = null;
          track.classList.remove("is-animating");
        }
      };
      animFrame = requestAnimationFrame(step);
    };

    const goTo = (index: number) => {
      const clamped = Math.max(0, Math.min(slides.length - 1, index));
      animateScrollTo(clamped * track.clientWidth, 600);
    };

    const onScroll = () => setActiveDot(currentIndex());

    const enable = () => {
      if (active) return;
      active = true;
      track.addEventListener("scroll", onScroll, { passive: true });
      setActiveDot(0);
    };

    const disable = () => {
      if (!active) return;
      active = false;
      track.removeEventListener("scroll", onScroll);
    };

    mq.addEventListener("change", (e) => (e.matches ? enable() : disable()));
    if (mq.matches) enable();

    prevBtn?.addEventListener("click", () => goTo(currentIndex() - 1));
    nextBtn?.addEventListener("click", () => goTo(currentIndex() + 1));
    dots.forEach((dot) => {
      dot.addEventListener("click", () => goTo(Number(dot.dataset.index)));
    });

    let isDragging = false;
    let dragStartX = 0;
    let scrollStart = 0;

    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      isDragging = true;
      track.classList.add("is-dragging");
      dragStartX = e.clientX;
      scrollStart = track.scrollLeft;
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener("pointermove", (e) => {
      if (!isDragging) return;
      track.scrollLeft = scrollStart - (e.clientX - dragStartX);
    });
    const endDrag = (e: PointerEvent) => {
      if (e.pointerType !== "mouse" || !isDragging) return;
      isDragging = false;
      track.classList.remove("is-dragging");
      setActiveDot(currentIndex());
      goTo(currentIndex());
    };
    track.addEventListener("pointerup", endDrag);
    track.addEventListener("pointercancel", endDrag);
  }

  initFeaturesCarousel();
  document.addEventListener("astro:page-load", initFeaturesCarousel);
</script>

<style>
  .features-ia {
    background: #ffffff;
    padding: 5rem 1rem;
  }

  .features-ia .container {
    max-width: 1400px;
  }

  .features-title {
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    font-weight: 700;
    color: #0f172a;
    text-align: center;
    margin-bottom: 4rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.2;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
    align-items: stretch;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #ffffff;
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
    height: 100%;
    width: 250px;
  }

  .feature-icon-container {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    flex-shrink: 0;
  }

  .feature-icon {
    width: 120px;
    height: 120px;
    object-fit: contain;
  }

  .feature-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 1rem 0;
    line-height: 1.3;
  }

  .feature-card-desc {
    font-size: 0.9rem;
    font-weight: 500;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1200px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .feature-card {
      padding: 1.75rem;
    }
  }

  @media (max-width: 600px) {
    .features-ia {
      padding: 3.5rem 1rem;
    }

    .features-title {
      margin-bottom: 3rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .feature-card {
      padding: 1.5rem;
    }

    .feature-icon-container {
      width: 80px;
      height: 80px;
      margin-bottom: 1.25rem;
    }

    .feature-icon {
      width: 48px;
      height: 48px;
    }

    .feature-card-title {
      font-size: 1rem;
    }

    .feature-card-desc {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .feature-icon-container {
      width: 110px;
      height: 110px;
      margin-bottom: 1.25rem;
    }

    .feature-icon {
      width: 120px;
      height: 120px;
    }

    .features-carousel-wrap {
      position: relative;
      padding: 0 1.5rem;
    }

    .features-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      cursor: grab;
      user-select: none;
      gap: 0;
    }
    .features-grid::-webkit-scrollbar { display: none; }
    .features-grid.is-dragging,
    .features-grid.is-animating {
      cursor: grabbing;
      scroll-snap-type: none;
    }

    .features-grid {
      align-items: stretch;
    }

    .feature-card {
      flex: 0 0 100%;
      min-width: 0;
      width: auto;
      height: auto;
      scroll-snap-align: center;
    }

    .carousel-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 40%;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      border-radius: 999px;
      border: none;
      background: rgba(15, 23, 42, 0.85);
      color: white;
      font-size: 1.4rem;
      line-height: 1;
      z-index: 3;
      cursor: pointer;
    }
    .carousel-arrow-prev { left: 0; }
    .carousel-arrow-next { right: 0; }

    .carousel-dots {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1.25rem;
    }
    .carousel-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      border: none;
      background: #cbd5e1;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .carousel-dot.is-active {
      background: #2563eb;
      transform: scale(1.3);
    }
  }

  @media (min-width: 481px) {
    .carousel-arrow,
    .carousel-dots {
      display: none;
    }
  }
</style>
