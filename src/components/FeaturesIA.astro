---
import icon13 from '../assets/image/IA/icong-13.png';
import icon12 from '../assets/image/IA/icong-12.png';
import icon11 from '../assets/image/IA/icong-11.png';
import icon14 from '../assets/image/IA/icong-14.png';
import icon15 from '../assets/image/IA/icong-15.png';

const features = [
  {
    icon: icon13,
    title: 'Análisis predictivo',
    desc: 'Anticipa tendencias y comportamientos para tomar decisiones con ventaja.',
  },
  {
    icon: icon12,
    title: 'Aprendizaje continuo',
    desc: 'La IA aprende de tu negocio cada día y mejora sus recomendaciones.',
  },
  {
    icon: icon11,
    title: 'Integración total',
    desc: 'Conecta todas las áreas de tu empresa y centraliza tus datos.',
  },
  {
    icon: icon14,
    title: 'Reportes inteligentes',
    desc: 'Informes automáticos y personalizados en segundos, no en horas.',
  },
  {
    icon: icon15,
    title: 'Alertas en tiempo real',
    desc: 'Recibe notificaciones sobre oportunidades y riesgos importantes.',
  },
];
---

<section class="features-ia">
  <div class="container">
    <h2 class="features-title reveal">Más que datos, inteligencia que impulsa tu crecimiento.</h2>

    <div class="features-grid">
      {features.map((feature, i) => (
        <div class="feature-card reveal hover-lift" style={`transition-delay:${i * 0.08}s`}>
          <div class="feature-icon-container">
            <img src={feature.icon.src} alt={feature.title} class="feature-icon" />
          </div>
          <h3 class="feature-card-title">{feature.title}</h3>
          <p class="feature-card-desc">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-ia {
    background: #f8fafc;
    padding: 5rem 1rem;
  }

  .features-ia .container {
    max-width: 1400px;
  }

  .features-title {
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    font-weight: 700;
    color: #0f172a;
    text-align: center;
    margin-bottom: 4rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.2;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
    align-items: stretch;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #ffffff;
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
    height: 100%;
    width: 250px;
  }

  .feature-icon-container {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    flex-shrink: 0;
  }

  .feature-icon {
    width: 120px;
    height: 120px;
    object-fit: contain;
  }

  .feature-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 1rem 0;
    line-height: 1.3;
  }

  .feature-card-desc {
    font-size: 0.9rem;
    font-weight: 500;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1200px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .feature-card {
      padding: 1.75rem;
    }
  }

  @media (max-width: 600px) {
    .features-ia {
      padding: 3.5rem 1rem;
    }

    .features-title {
      margin-bottom: 3rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .feature-card {
      padding: 1.5rem;
    }

    .feature-icon-container {
      width: 80px;
      height: 80px;
      margin-bottom: 1.25rem;
    }

    .feature-icon {
      width: 48px;
      height: 48px;
    }

    .feature-card-title {
      font-size: 1rem;
    }

    .feature-card-desc {
      font-size: 0.85rem;
    }
  }
</style>
