---
// Planes del ERP: tarjetas resumen + tabla comparativa completa (desplegable).
// Valores: true = incluido, false = no incluido, string = valor concreto (límite o complemento).
type Value = boolean | string;

// "Ver todas las funciones" en cada tarjeta: oculto por el momento, cambiar a true para mostrarlo
const SHOW_ALL_FEATURES = false;

const plans = [
  { id: "basico", name: "Básico", price: 49, tagline: "Para empezar a ordenar tu negocio" },
  { id: "intermedio", name: "Intermedio", price: 79, featured: true, tagline: "Para negocios en crecimiento" },
  { id: "avanzado", name: "Avanzado", price: 129, tagline: "Para equipos con varios almacenes" },
] as const;

// Resumen de cada tarjeta: texto (igual o por plan) y si está incluido en cada plan
const cardFeatures: { text: string | [string, string, string]; included: [boolean, boolean, boolean] }[] = [
  { text: ["2 usuarios", "4 usuarios", "6 usuarios"], included: [true, true, true] },
  { text: "Comprobantes electrónicos ilimitados", included: [true, true, true] },
  { text: ["Hasta 500 productos", "Hasta 2,000 productos", "Hasta 5,000 productos"], included: [true, true, true] },
  { text: ["1 almacén", "2 almacenes", "3 almacenes"], included: [true, true, true] },
  { text: "POS inteligente", included: [true, true, true] },
  { text: "Kardex y ajuste de inventario", included: [false, true, true] },
  { text: "Catálogo digital", included: [false, true, true] },
  { text: "Cotizaciones y cuentas por cobrar", included: [false, true, true] },
  { text: "Seguimiento de envíos", included: [false, false, true] },
  { text: "Carga inteligente de productos", included: [false, false, true] },
];

const categories: { title: string; rows: [string, Value, Value, Value][] }[] = [
  {
    title: "Lo esencial del plan",
    rows: [
      ["Usuarios", "2", "4", "6"],
      ["Comprobantes electrónicos SUNAT", "Ilimitados", "Ilimitados", "Ilimitados"],
      ["Productos registrados", "Hasta 500", "Hasta 2,000", "Hasta 5,000"],
      ["Almacenes", "1", "2", "3"],
      ["Inventario", "Esencial", "Avanzado", "Avanzado"],
      ["Gestión masiva de productos", "Básica", "Avanzada", "Avanzada"],
    ],
  },
  {
    title: "Inventario",
    rows: [
      ["Entradas / salidas", true, true, true],
      ["Traspasos", true, true, true],
      ["Ajuste de inventario", false, true, true],
      ["Kardex", false, true, true],
      ["Stock", true, true, true],
      ["Registro masivo", false, true, true],
      ["Edición masiva", false, true, true],
      ["Importar Excel", true, true, true],
      ["Carga inteligente de productos", false, false, true],
      ["Imágenes masivas", false, true, true],
      ["Generador de códigos", false, true, true],
    ],
  },
  {
    title: "Catálogo digital",
    rows: [
      ["Catálogo digital", false, true, true],
      ["Productos publicados", false, "Hasta 100", "Hasta 200"],
      ["Imágenes por producto", false, "1", "1"],
      ["Ampliar catálogo", false, "NANIVA Store", "NANIVA Store"],
      ["Más imágenes por producto", false, "NANIVA Store", "NANIVA Store"],
    ],
  },
  {
    title: "Logística y envíos",
    rows: [["Seguimiento de envíos", false, false, true]],
  },
  {
    title: "Reportes",
    rows: [
      ["Resumen de ventas", true, true, true],
      ["Productos más vendidos", false, true, true],
      ["Inventario valorizado", false, true, true],
      ["Kardex valorizado", false, true, true],
      ["Resumen de compras", false, true, true],
      ["Ventas por vendedor", false, false, true],
    ],
  },
  {
    title: "Finanzas",
    rows: [
      ["Control de caja", true, true, true],
      ["Control financiero", false, true, true],
      ["Caja", true, true, true],
      ["Gastos", false, true, true],
      ["Movimientos financieros", false, true, true],
      ["Bancos y cuentas", false, true, true],
    ],
  },
  {
    title: "Categorización",
    rows: [
      ["Categorías", true, true, true],
      ["Unidades de medida", true, true, true],
      ["Marcas", true, true, true],
      ["Familias", true, true, true],
      ["Líneas", true, true, true],
      ["Tallas", false, true, true],
      ["Colores", false, true, true],
    ],
  },
  {
    title: "Ventas y clientes",
    rows: [
      ["POS inteligente", true, true, true],
      ["Realizar venta", true, true, true],
      ["Historial de ventas", true, true, true],
      ["Etiquetas de despacho", false, true, true],
      ["Ventas abiertas", false, false, true],
      ["Gestión de entregas", false, false, true],
      ["Ventas inteligentes", false, false, true],
      ["Ofertas enviadas", false, false, true],
      ["Clientes", true, true, true],
      ["Cuentas por cobrar", false, true, true],
      ["Nueva cotización", false, true, true],
      ["Historial de cotizaciones", false, true, true],
    ],
  },
  {
    title: "Compras",
    rows: [
      ["Registrar compra", true, true, true],
      ["Consultar compras", true, true, true],
      ["Solicitudes", false, true, true],
      ["Consultar cotizaciones", false, true, true],
      ["Registrar orden", false, true, true],
      ["Consultar órdenes", false, true, true],
      ["Inteligencia de compra", false, false, true],
      ["Proveedores", true, true, true],
      ["Cuentas por pagar", true, true, true],
      ["Gestión de órdenes de compra", false, true, true],
    ],
  },
];

const whatsappHref = (plan: string) =>
  `https://wa.me/51908644190?text=${encodeURIComponent(`Hola, me interesa el plan ${plan} del ERP NANIVA`)}`;

const crossIcon = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>`;
const smallCheckIcon = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
const checkIcon = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
---

<!-- Sin .reveal en el bloque: es muy alto y nunca llegaba al 15% visible que exige la animación -->
<div class="container erp-plans" id="erp-planes" data-erp-plans data-active="intermedio">
  <div class="erp-plans-head reveal">
    <span class="erp-plans-badge">PLANES DEL ERP</span>
    <h3>Compara los planes y elige <span class="erp-plans-highlight">el ideal para tu negocio</span></h3>
    <p>Todos los planes incluyen facturación electrónica con comprobantes ilimitados, POS, ventas, compras, caja e inventario. Crece de plan cuando tu negocio lo necesite.</p>
  </div>

  <!-- Tarjetas de planes -->
  <div class="erp-plan-cards">
    {plans.map((p, pi) => (
      <article class:list={["erp-plan-card", { featured: "featured" in p && p.featured }]}>
        {"featured" in p && p.featured && <span class="erp-plan-card-flag">Recomendado</span>}
        <h4 class="erp-plan-card-name">{p.name}</h4>
        <p class="erp-plan-card-tagline">{p.tagline}</p>
        <p class="erp-plan-card-price">
          <span class="erp-plan-card-amount">S/{p.price}</span>
          <span class="erp-plan-card-period">/ mes (inc. IGV)</span>
        </p>
        <ul class="erp-plan-card-list">
          {cardFeatures.map((feat) => {
            const text = typeof feat.text === "string" ? feat.text : feat.text[pi];
            const ok = feat.included[pi];
            return (
              <li class:list={{ off: !ok }}>
                <span class="erp-plan-card-icon" set:html={ok ? smallCheckIcon : crossIcon} />
                <span>{text}</span>
                {!ok && <span class="sr-only">(no incluido)</span>}
              </li>
            );
          })}
        </ul>
        <a href={whatsappHref(p.name)} target="_blank" rel="noopener noreferrer" class="erp-plan-card-cta">Elegir plan</a>
        {SHOW_ALL_FEATURES && (
        <details class="erp-plan-card-all">
          <summary>Ver todas las funciones</summary>
          {categories.filter((cat) => cat.title !== "Lo esencial del plan").map((cat) => (
            <div class="erp-plan-card-group">
              <h5>{cat.title}</h5>
              <ul>
                {cat.rows.map(([label, ...values]) => {
                  const v = values[pi];
                  return (
                    <li class:list={{ off: v === false }}>
                      <span class="erp-plan-card-icon" set:html={v === false ? crossIcon : smallCheckIcon} />
                      <span>
                        {label}
                        {typeof v === "string" && <strong class:list={["erp-plan-card-value", { "value-store": v === "NANIVA Store" }]}>{v}</strong>}
                      </span>
                      {v === false && <span class="sr-only">(no incluido)</span>}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </details>
        )}
      </article>
    ))}
  </div>

  <!-- Comparación completa: desplegable (el contenido sigue en el HTML para Google) -->
  <details class="erp-plans-details" id="erp-comparacion">
    <summary>Ver comparación completa de funcionalidades</summary>

  <!-- Selector de plan: solo visible en móvil, donde la tabla muestra un plan a la vez -->
  <div class="erp-plans-switch" role="group" aria-label="Elegir plan para comparar">
    {plans.map((p) => (
      <button type="button" data-plan={p.id} aria-pressed={p.id === "intermedio" ? "true" : "false"}>
        <span>{p.name}</span>
        <strong>S/ {p.price}</strong>
      </button>
    ))}
  </div>

  <div class="erp-plans-table-wrap">
    <table class="erp-plans-table">
      <caption class="sr-only">Comparación de funcionalidades de los planes Básico, Intermedio y Avanzado del ERP NANIVA</caption>
      <thead>
        <tr>
          <th scope="col" class="col-label">Funcionalidades</th>
          {plans.map((p) => (
            <th scope="col" class:list={["col-plan", `col-${p.id}`, { featured: "featured" in p && p.featured }]}>
              {"featured" in p && p.featured && <span class="plan-flag">Recomendado</span>}
              <span class="plan-name">{p.name}</span>
              <span class="plan-price"><span class="plan-currency">S/</span>{p.price}<span class="plan-period">/mes</span></span>
              <a href={whatsappHref(p.name)} target="_blank" rel="noopener noreferrer" class="plan-cta">Elegir plan</a>
            </th>
          ))}
        </tr>
      </thead>
      {categories.map((cat) => (
        <tbody>
          <tr class="row-category">
            <th scope="colgroup" colspan="4">{cat.title}</th>
          </tr>
          {cat.rows.map(([label, ...values]) => (
            <tr>
              <th scope="row" class="col-label">{label}</th>
              {values.map((v, i) => (
                <td class:list={["col-plan", `col-${plans[i].id}`, { featured: "featured" in plans[i] && plans[i].featured }]}>
                  {v === true && (
                    <span class="value-yes"><Fragment set:html={checkIcon} /><span class="sr-only">Incluido</span></span>
                  )}
                  {v === false && (
                    <><span class="value-no" aria-hidden="true">—</span><span class="sr-only">No incluido</span></>
                  )}
                  {typeof v === "string" && (
                    <span class:list={["value-text", { "value-store": v === "NANIVA Store" }]}>{v}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
  </details>

  <p class="erp-plans-note">
    Precios mensuales en soles, IGV incluido.<br />
    <span class="value-store">NANIVA Store</span> es la tienda de aplicaciones dentro de la plataforma, donde puedes solicitar ampliaciones para tu plan.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-erp-plans]").forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>(".erp-plans-switch button");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        root.dataset.active = btn.dataset.plan;
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      });
    });
  });
</script>

<style>
  /* Va al inicio de la sección del ERP, que ya tiene su propio espacio superior */
  .erp-plans {
    padding-top: 0;
    padding-bottom: 2rem;
  }
  .erp-plans-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.5rem;
  }
  .erp-plans-badge {
    display: inline-block;
    font-size: 1.5rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    color: #1d4ed8;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    margin-bottom: 1rem;
  }
  .erp-plans-head h3 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1.2;
    color: #0f172a;
    margin-bottom: 0.75rem;
  }
  .erp-plans-highlight { color: #2563eb; }
  .erp-plans-head p {
    color: #475569;
    font-size: 1rem;
  }

  /* ---------- Tarjetas de planes ---------- */
  .erp-plan-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 1120px;
    margin: 0 auto 2.5rem;
    /* start: al desplegar una tarjeta, las demás no se estiran con espacio vacío */
    align-items: start;
  }
  .erp-plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 2.25rem 1.75rem 1.75rem;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .erp-plan-card:hover,
  .erp-plan-card:focus-within {
    transform: translateY(-8px);
    border-color: #2563eb;
    box-shadow: 0 24px 50px rgba(37, 99, 235, 0.18);
  }
  .erp-plan-card.featured {
    border: 2px solid #2563eb;
    box-shadow: 0 18px 40px rgba(37, 99, 235, 0.14);
  }
  .erp-plan-card-flag {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #2563eb;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .erp-plan-card-name {
    font-size: 1.75rem;
    font-weight: 800;
    color: #1e3a8a;
    margin-bottom: 0.4rem;
  }
  .erp-plan-card-tagline {
    color: #475569;
    font-size: 0.95rem;
    min-height: 1.5em;
  }
  .erp-plan-card-price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.75rem 0 1.5rem;
  }
  .erp-plan-card-amount {
    font-size: 2.6rem;
    font-weight: 800;
    color: #1e3a8a;
    line-height: 1;
  }
  .erp-plan-card-period {
    font-size: 0.85rem;
    font-weight: 600;
    color: #475569;
  }
  .erp-plan-card-list {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    text-align: left;
    width: fit-content;
    flex: 1;
  }
  .erp-plan-card-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: #334155;
  }
  .erp-plan-card-list li.off { color: #64748b; }
  .erp-plan-card-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: #16a34a;
  }
  .erp-plan-card-list li.off .erp-plan-card-icon { color: #94a3b8; }
  .erp-plan-card-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 170px;
    min-height: 48px;
    padding: 0.7rem 1.75rem;
    border-radius: 999px;
    border: 1.5px solid #2563eb;
    color: #1d4ed8;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .erp-plan-card-cta:hover { background: #eff6ff; }
  .erp-plan-card.featured .erp-plan-card-cta { background: #2563eb; color: #ffffff; }
  .erp-plan-card.featured .erp-plan-card-cta:hover { background: #1d4ed8; }
  .erp-plan-card-all {
    width: 100%;
    margin-top: 1rem;
  }
  .erp-plan-card-all > summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #1d4ed8;
    cursor: pointer;
  }
  .erp-plan-card-all > summary::-webkit-details-marker { display: none; }
  .erp-plan-card-all > summary::after {
    content: "⌄";
    line-height: 1;
    transform: translateY(-0.15em);
    transition: transform 0.2s ease;
  }
  .erp-plan-card-all[open] > summary::after { transform: rotate(180deg) translateY(-0.1em); }
  .erp-plan-card-all > summary:hover { text-decoration: underline; }
  .erp-plan-card-all[open] > summary { margin-bottom: 0.5rem; }

  .erp-plan-card-group {
    text-align: left;
    border-top: 1px solid #f1f5f9;
    padding: 0.9rem 0 0.4rem;
  }
  .erp-plan-card-group h5 {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1d4ed8;
    margin-bottom: 0.6rem;
  }
  .erp-plan-card-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .erp-plan-card-group li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: #334155;
  }
  .erp-plan-card-group li .erp-plan-card-icon { margin-top: 0.15rem; }
  .erp-plan-card-group li.off { color: #64748b; }
  .erp-plan-card-group li.off .erp-plan-card-icon { color: #94a3b8; }
  .erp-plan-card-value {
    margin-left: 0.35rem;
    font-weight: 700;
    color: #0f172a;
  }
  .erp-plan-card-value.value-store {
    display: inline-block;
    font-size: 0.75rem;
    color: #6d28d9;
    background: #f3e8ff;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .erp-plan-card { transition: none; }
    .erp-plan-card:hover,
    .erp-plan-card:focus-within { transform: none; }
  }

  /* ---------- Comparación completa (desplegable) ---------- */
  .erp-plans-details { scroll-margin-top: 100px; }
  .erp-plans-details > summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: fit-content;
    min-height: 48px;
    margin: 0 auto 1.5rem;
    padding: 0.7rem 1.5rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 999px;
    background: #ffffff;
    color: #0f172a;
    font-weight: 700;
    cursor: pointer;
  }
  .erp-plans-details > summary::-webkit-details-marker { display: none; }
  .erp-plans-details > summary::after {
    content: "⌄";
    font-size: 1.1rem;
    line-height: 1;
    transform: translateY(-0.15em);
    transition: transform 0.2s ease;
  }
  .erp-plans-details[open] > summary::after { transform: rotate(180deg) translateY(-0.1em); }
  .erp-plans-details > summary:hover { border-color: #2563eb; color: #1d4ed8; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Tabla (escritorio) ---------- */
  .erp-plans-table-wrap {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
    overflow: clip;
  }
  .erp-plans-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    font-size: 0.95rem;
  }
  .erp-plans-table .col-label {
    width: 40%;
    text-align: left;
    font-weight: 600;
    color: #334155;
    padding: 0.8rem 1.5rem;
  }
  .erp-plans-table td,
  .erp-plans-table tbody th {
    border-bottom: 1px solid #f1f5f9;
  }
  .erp-plans-table td {
    text-align: center;
    padding: 0.8rem 0.75rem;
    color: #0f172a;
  }
  .erp-plans-table tbody tr:not(.row-category):hover td,
  .erp-plans-table tbody tr:not(.row-category):hover th {
    background: #f8fafc;
  }

  /* Encabezado de planes, fijo al hacer scroll */
  /* top = alto del menú fijo (~80 px) para que no lo tape */
  .erp-plans-table thead th {
    position: sticky;
    top: 80px;
    z-index: 2;
    background: #ffffff;
    border-bottom: 2px solid #e2e8f0;
    vertical-align: bottom;
    padding: 1.5rem 0.75rem 1.25rem;
  }
  .erp-plans-table thead .col-label {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
    padding-left: 1.5rem;
  }
  .col-plan { text-align: center; }
  .plan-flag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
    background: #2563eb;
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
