---
import { Image } from 'astro:assets';
import Plans from '@components/producto/Plans.astro';
import { productos } from '@data/productos';
import catalogoMockup from '@assets/image/planes/catalogo/catgbb-15.webp';
import catFeatureShare from '@assets/image/planes/catalogo/iconcatgl-18.png';
import catFeatureWhatsapp from '@assets/image/planes/catalogo/iconcatgl-19.png';
import catFeatureQuote from '@assets/image/planes/catalogo/iconcatgl-16.png';
import catFeatureGrowth from '@assets/image/planes/catalogo/iconcatgg-16.png';
import iconNegocioFerreterias from '@assets/image/planes/tipo-negocio/iconocatgg-03.jpg.jpeg';
import iconNegocioDistribuidoras from '@assets/image/planes/tipo-negocio/iconocatgg-04.jpg.jpeg';
import iconNegocioTiendas from '@assets/image/planes/tipo-negocio/iconocatgg-05.jpg.jpeg';
import iconNegocioImportadores from '@assets/image/planes/tipo-negocio/iconocatgg-06.jpg.jpeg';
import iconNegocioMinimarkets from '@assets/image/planes/tipo-negocio/iconocatgg-07.jpg.jpeg';
import iconNegocioMayoristas from '@assets/image/planes/tipo-negocio/iconocatgg-08.jpg.jpeg';
import catalogoCtaBanner from '@assets/image/planes/catalogo/banner-plan.webp';
import catalogoCtaBannerMobile from '@assets/image/planes/catalogo/banner-catalogo.png';
import iconRestauranteExtra15 from '@assets/image/planes/tipo-negocio/icons cayg-15 (1).png';
import iconRestauranteExtra16 from '@assets/image/planes/tipo-negocio/icons cayg-16 (1).png';

// Icon generator function
function icon(name: string, color: string = "#2563eb", size = 22) {
  const icons: Record<string, string> = {
    store: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 2-4h16l2 4"/><path d="M2 7h20v3a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0V7Z"/><path d="M4 10v10h16V10"/></svg>`,
    check: `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`,
    box: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
    help: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9a4 4 0 1 1 5.5 3.7c-.9.4-1.5 1.3-1.5 2.3v.5"/><path d="M12 18.5h.01"/></svg>`,
    shield: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>`,
    refresh: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>`,
    lock: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    headset: `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14v-3a9 9 0 0 1 18 0v3"/><path d="M21 15a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2h3Zm-18 0a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2H3Z"/><path d="M21 15v1a4 4 0 0 1-4 4h-4"/></svg>`,
  };
  return icons[name] ?? "";
}

const catalogoFeatures = [
  { img: catFeatureShare, alt: "Comparte tu catálogo en segundos" },
  { img: catFeatureWhatsapp, alt: "Recibe pedidos por WhatsApp" },
  { img: catFeatureQuote, alt: "Envía cotizaciones profesionales" },
  { img: catFeatureGrowth, alt: "Convierte consultas en ventas" },
];

const trustBadges = [
  { icon: "shield", title: "Sin contratos forzosos", desc: "Planes flexibles sin permanencia" },
  { icon: "refresh", title: "Cambia o cancela cuando quieras", desc: "Tú decides, sin complicaciones" },
  { icon: "lock", title: "Pago 100% seguro", desc: "Tus datos siempre protegidos" },
  { icon: "headset", title: "Soporte especializado", desc: "Estamos para ayudarte" },
];

const negociosCategories = [
  { img: iconNegocioFerreterias, label: "Ferreterías" },
  { img: iconNegocioDistribuidoras, label: "Distribuidoras" },
  { img: iconNegocioTiendas, label: "Tiendas" },
  { img: iconNegocioMinimarkets, label: "Minimarkets" },
  { img: iconNegocioImportadores, label: "Importadores" },
  { img: iconNegocioMayoristas, label: "Mayoristas" },
];
---

<section id="catalogo-digital" class="erp-detail catalogo-detail product-detail">
  <div class="container erp-hero">
    <div class="erp-hero-copy reveal">
      <span class="erp-badge catalogo-badge">
        <span set:html={icon("store", "#16a34a", 15)} />
        CATÁLOGO SMART
      </span>
      <h2>Catálogo <span class="p-highlight catalogo-highlight">Digital</span></h2>
      <p class="erp-hero-sub">Vender más a través de todos los canales. Comparte tu catálogo, recibe pedidos y convierte consultas en ventas.</p>

      <div class="catalogo-features">
        {catalogoFeatures.map((f) => (
          <Image src={f.img} alt={f.alt} class="catalogo-feature-img" widths={[160, 320, 480]} sizes="160px" />
        ))}
      </div>

      <div class="erp-cta">
        <a href="https://wa.me/51937292341?text=%F0%9F%91%8B%20%C2%A1Hola!%20%F0%9F%9B%8D%EF%B8%8F%20Deseo%20conocer%20c%C3%B3mo%20funciona%20el%20Cat%C3%A1logo%20Digital%20y%20c%C3%B3mo%20puede%20ayudarme%20a%20vender%20m%C3%A1s.%20Agradecer%C3%A9%20su%20asesor%C3%ADa." class="btn-primary catalogo-btn-primary hover-pop">Comenzar ahora</a>
        <a href="https://wa.me/51937292341?text=%F0%9F%91%8B%20%C2%A1Hola!%20Estoy%20interesado%20en%20el%20Cat%C3%A1logo%20Digital.%20Me%20gustar%C3%ADa%20solicitar%20una%20demostraci%C3%B3n%20para%20conocer%20sus%20funcionalidades%2C%20beneficios%20y%20c%C3%B3mo%20puede%20impulsar%20las%20ventas%20de%20mi%20empresa.%20%F0%9F%93%B1" class="btn-outline catalogo-btn-outline hover-pop">Solicitar demostración</a>
      </div>
      <a href="/catalogo-digital" class="detail-more-link">Ver todas las funciones del catálogo digital →</a>
    </div>

    <div class="erp-hero-media reveal">
      <Image src={catalogoMockup} alt="Catálogo Digital Naniva - pedidos por WhatsApp" class="erp-mockup-img catalogo-mockup-img" widths={[640, 1000, 1400, 2000]} sizes="(max-width: 900px) 100vw, (max-width: 1400px) 55vw, 810px" />
    </div>
  </div>

  <!-- Mismos planes que /catalogo-digital: salen de @data/productos -->
  <Plans producto={productos.catalogo} id="catalogo-planes" />

  <div class="container catalogo-trust">
    <div class="trust-badges-row reveal">
      {trustBadges.map((t) => (
        <div class="trust-badge">
          <span class="trust-badge-icon" set:html={icon(t.icon, "#16a34a", 22)} />
          <div class="trust-badge-text">
            <strong>{t.title}</strong>
            <span>{t.desc}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="container catalogo-audience reveal">
    <div class="catalogo-pricing-head">
      <h2 class="audience-title"><span class="audience-dash"></span> Ideal para negocios <span class="p-highlight catalogo-highlight">como el tuyo</span> <span class="audience-dash"></span></h2>
      <p>Nuestros planes se adaptan a todo tipo de negocio. Elige el que mejor se ajuste a tus necesidades.</p>
    </div>

    <div class="audience-carousel">
      <button type="button" class="audience-nav" aria-label="Anterior" data-carousel-prev>‹</button>
      <div class="audience-track" data-carousel-track>
        {negociosCategories.map((c) => (
          <div class="audience-card">
            <Image src={c.img} alt={c.label} class="audience-card-icon" widths={[120, 240, 360]} sizes="120px" />
            <span class="audience-card-label">{c.label}</span>
            <span class="audience-card-underline"></span>
          </div>
        ))}
        <div class="audience-card catalogo-extra-audience-card">
          <Image src={iconRestauranteExtra15} alt="Farmacias" class="audience-card-icon" widths={[120, 240, 360]} sizes="120px" />
          <span class="audience-card-label">Farmacias</span>
          <span class="audience-card-underline"></span>
        </div>
        <div class="audience-card catalogo-extra-audience-card">
          <Image src={iconRestauranteExtra16} alt="Jugueterías" class="audience-card-icon" widths={[120, 240, 360]} sizes="120px" />
          <span class="audience-card-label">Jugueterías</span>
          <span class="audience-card-underline"></span>
        </div>
      </div>
      <button type="button" class="audience-nav" aria-label="Siguiente" data-carousel-next>›</button>
    </div>
  </div>

  <div class="container">
    <div class="catalogo-cta-banner reveal">
      
      <Image src={catalogoCtaBanner} alt="Empieza a vender por WhatsApp hoy mismo" class="catalogo-cta-banner-img catalogo-cta-banner-desktop" widths={[800, 1280, 1920, 2800]} sizes="95vw" />
      <Image src={catalogoCtaBannerMobile} alt="Empieza a vender por WhatsApp hoy mismo" class="catalogo-cta-banner-img catalogo-cta-banner-mobile" widths={[480, 800, 1200]} sizes="100vw" />
      <a href="https://wa.me/51937292341?text=%F0%9F%91%8B%20%C2%A1Hola!%20Estoy%20interesado%20en%20el%20Cat%C3%A1logo%20Digital.%20Me%20gustar%C3%ADa%20solicitar%20una%20demostraci%C3%B3n%20para%20conocer%20sus%20funcionalidades%2C%20beneficios%20y%20c%C3%B3mo%20puede%20impulsar%20las%20ventas%20de%20mi%20empresa.%20%F0%9F%93%B1" class="catalogo-cta-banner-btn hover-pop pulse-ring whatsapp">Solicitar demostración aquí→</a>
    </div>
  </div>
</section>

<style>
  .p-highlight { color: #2563eb; }
  .catalogo-highlight { color: #16a34a; }

  .erp-detail {
    background: #f8fafc;
    padding: 4rem 0 5rem;
    scroll-margin-top: 6rem;
  }

  .erp-detail .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    margin-top: 4rem;
  }

  .erp-hero {
    display: flex;
    align-items: center;
    gap: 3rem;
    padding-bottom: 3rem;
  }

  .erp-hero-copy { flex: 1; min-width: 320px; }
  .erp-hero-media { flex: 1.2; min-width: 320px; }

  .erp-mockup-img {
    width: 115%;
    height: auto;
    border-radius: 16px;
  }

  .erp-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #eef4ff;
    color: #2563eb;
    font-size: 1.1rem;
    font-weight: 750;
    letter-spacing: 0.03em;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    margin-top: 0.5rem;
  }

  .catalogo-badge { background: #e3f9e5; color: #16a34a; }

  .erp-hero-copy h2 {
    font-size: clamp(3rem, 5vw, 4rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }

  .erp-hero-sub {
    font-size: 1.5rem;
    color: #475569;
    margin: 0 0 1.5rem;
    font-weight: 700;
  }

  .catalogo-features {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .catalogo-feature-img {
    width: 132px;
    height: 148px;
    object-fit: contain;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .catalogo-feature-img:nth-child(2),
  .catalogo-feature-img:nth-child(3) {
    transform: scale(1.12);
  }

  .catalogo-feature-img:nth-child(2) {
    transform: scale(1.07);
  }

  .catalogo-feature-img:hover {
    transform: scale(1.15);
    filter: drop-shadow(0 0 12px rgba(128, 75, 228, 0.35));
  }

  .catalogo-feature-img:nth-child(2):hover,
  .catalogo-feature-img:nth-child(3):hover {
    transform: scale(1.27);
  }

  .catalogo-feature-img:nth-child(2):hover {
    transform: scale(1.22);
  }

  .catalogo-mockup-img { border-radius: 0; }

  .erp-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .btn-primary {
    background: #2563eb;
    color: white;
    border: none;
    padding: 0.85rem 1.6rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    display: inline-block;
  }

  .btn-outline {
    background: white;
    color: #2563eb;
    border: 1.5px solid #2563eb;
    padding: 0.85rem 1.6rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    display: inline-block;
  }

  .catalogo-btn-primary { background: #16a34a; }
  .catalogo-btn-outline { color: #16a34a; border-color: #16a34a; }

  .catalogo-detail { border-top: 1px solid #e2e8f0; }

  .catalogo-trust.container { margin-top: 0; }

  .detail-more-link { color: #15803d; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .detail-more-link:hover { color: #166534; }

  .catalogo-pricing-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 1.5rem;
  }

  .catalogo-pricing-head h2 {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.5rem;
  }

  .catalogo-pricing-head p {
    color: #64748b;
    font-size: 0.95rem;
    margin: 0;
  }


    @media (max-width: 1368px) and (min-width: 606px) {

      .erp-detail {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 2rem;
    margin-top: 4rem;
}

    .erp-mockup-img { width: 100%;
    margin-left:3rem}

    .erp-hero-copy h2 {
    font-size: clamp(2rem, 3.5vw, 4rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }

  .erp-hero-sub {
    font-size: 1.2rem;
    color: #475569;
    margin: 0 0 1.5rem;
    font-weight: 600;
  }
  .catalogo-features{
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
    width: 120%;
} 
.catalogo-feature-img:nth-child(1) {
    transform: scale(1.12);
  }

  .catalogo-feature-img:nth-child(3) {
    margin-top: 0.3rem;
    transform: scale(1.03);
  }

  .catalogo-feature-img:nth-child(2) {
    transform: scale(1.12);
  }

    }

  .trust-badges-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding: 1.5rem 2rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .trust-badge-icon {
    flex-shrink: 0;
    background: #e3f9e5;
    border-radius: 10px;
    padding: 0.5rem;
    display: flex;
  }

  .trust-badge-text { display: flex; flex-direction: column; gap: 0.1rem; }
  .trust-badge-text strong { font-size: 0.85rem; color: #0f172a; }
  .trust-badge-text span { font-size: 0.78rem; color: #64748b; }

  .catalogo-audience {
    padding-top: 3.5rem;
  }

  .audience-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .audience-dash {
    display: inline-block;
    width: 28px;
    height: 3px;
    background: #0f172a;
    border-radius: 2px;
  }

  .audience-carousel {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .audience-nav {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    background: white;
    color: #2563eb;
    font-size: 1.4rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .audience-nav:hover { border-color: #2563eb; }

  .audience-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    flex: 1;
    scrollbar-width: none;
  }

  .audience-track::-webkit-scrollbar { display: none; }

  .audience-card {
    flex: 0 0 200px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    text-align: center;
  }

  .audience-card-icon { width: 120px; height: 120px; object-fit: contain; }
  .audience-card-label { font-weight: 700; font-size: 1.1rem; color: #0f172a; }
  .audience-card-underline {
    width: 24px;
    height: 3px;
    background: #16a34a;
    border-radius: 2px;
  }

  .catalogo-cta-banner {
    position: relative;
    display: block;
    margin-top: 3rem;
    border-radius: 20px;
    overflow: hidden;
  }

  .catalogo-cta-banner-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .catalogo-cta-banner-desktop {
    display: block;
  }

  .catalogo-cta-banner-mobile {
    display: none;
  }

  .catalogo-cta-banner-btn {
    position: absolute;
    right: 6%;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: white;
    color: #16a34a;
    font-weight: 700;
    font-size: clamp(0.85rem, 1.3vw, 1.05rem);
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .catalogo-cta-banner-btn {
      position: static;
      transform: none;
      display: flex;
      justify-content: center;
      margin: 0.75rem auto 0;
      width: max-content;
    }
  }

  @media (max-width: 900px) {
    .trust-badges-row { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .trust-badges-row { grid-template-columns: 1fr; }
  }

  @media (max-width: 900px) {
    .erp-hero { flex-direction: column; }
    .erp-hero-copy, .erp-hero-media { min-width: 0; width: 100%; }
    .erp-mockup-img { width: 100%; }
  }

  .product-detail {
    display: none;
  }

  .product-detail.is-active {
    display: block;
  }

  @media (max-width: 480px) {
    .erp-detail .container {
      padding: 0 1rem;
    }

    .catalogo-features {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      justify-content: center;
      justify-items: center;
    }

    .catalogo-feature-img {
      width: 100%;
      max-width: 140px;
      height: auto;
    }

    .catalogo-feature-img:nth-child(2),
    .catalogo-feature-img:nth-child(3) {
      transform: scale(1);
    }

    .catalogo-feature-img:nth-child(2) {
      transform: scale(1);
    }

    .erp-hero-sub {
      font-size: 1.1rem;
    }

    .trust-badges-row {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1rem;
    }

    .trust-badge {
      gap: 0.6rem;
    }

    .trust-badge-text strong {
      font-size: 0.8rem;
    }

    .audience-card {
      flex: 0 0 150px;
      padding: 2rem 1.25rem;
    }

    .audience-card-icon {
      width: 80px;
      height: 80px;
    }

    .audience-dash {
      display: none;
    }

    .audience-title {
      flex-direction: column;
      gap: 0;
    }

    .catalogo-cta-banner-desktop {
      display: none;
    }

    .catalogo-cta-banner-mobile {
      display: block;
    }

    .catalogo-cta-banner-btn {
      position: absolute;
      right: auto;
      top: auto;
      bottom: 1.25rem;
      left: 50%;
      transform: translateX(-55%);
      margin: 1rem;
      width: calc(80% - 3rem);
      justify-content: center;
