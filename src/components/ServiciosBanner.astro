---
import { Image } from 'astro:assets';
import fondoImg from '../assets/image/servicios/fondo-contactanos-01.webp';
import personasImg from '../assets/image/servicios/servicios personas-02.webp';

const stats = [
  { value: "+10,000", label: "Comprobantes emitidos" },
  { value: "+1,500", label: "Negocios|activos" },
  { value: "99.9%", label: "Disponibilidad" },
  { value: "Soporte", label: "24/7", labelClass: "push-down" },
  { value: "+3 millones", label: "en ventas procesadas" },
];
---

<section class="banner" style={`background-image: url('${fondoImg.src}');`}>
  <Image src={personasImg} alt="Personas usando servicios" class="personas-img" loading="eager" widths={[600, 1200, 1800, 2400]} sizes="60vw" />
  <div class="content reveal">
    <h1>Impulsa tu negocio<br />con nuestas<br /><span class="highlight">Soluciones</span></h1>
    <p>Te asesoramos para que tengas el mejor<br />sistema que se adecue para tu NEGOCIO.</p>
    <div class="stats">
      {stats.map((s, i) => (
        <div class="stat reveal" style={`transition-delay:${i * 0.12}s`}>
          <span class="stat-value">{s.value}</span>
          <span class={`stat-label ${s.labelClass ?? ""}`}>
            {s.label.split("|").map((line, idx, arr) => (
              idx < arr.length - 1 ? <>{line}<br /></> : line
            ))}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .banner {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 6rem;
    overflow: hidden;
  }

  .personas-img {
    position: absolute;
    right: -3rem;
    bottom: 0;
    max-width: 60%;
    height: auto;
    object-fit: contain;
    z-index: 1;
    pointer-events: none;
    transform: translateY(3rem);
    
  }

  h1 {
    font-size: clamp(3rem, 4.5vw, 4rem);
    font-weight: 798;
    line-height: 1.15;
    color: #0f172a;
    transform: translateY(-1rem);

  }

  .highlight {
    position: relative;
    color: #007bff;
  }

  .highlight::after {
    content: "";
    position: absolute;
    left: -6%;
    right: -6%;
    bottom: -1.4rem;
    height: 1.2rem;
    border-bottom: 4px solid #007bff;
    border-radius: 50%;
    transform: scaleY(-1.5);
  }

  p {
    font-size: 1.8rem;
    font-weight: 650;
    color: #334155;
    transform: translateY(1rem);
  }
  .content {
    max-width: 840px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 1rem;
    z-index: 10;
    
  }

  .stats {
    display: flex;
    gap: 1rem;
    flex-wrap: nowrap;
    margin-top: 0.5rem;
    transform: translateY(5rem);
  }

  .stat {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 10px;
    padding: 0.5rem 0.6rem;
    text-align: center;
    flex: 1;
    min-width: 0;
  }

  .stat:last-child {
    flex: 1.3;
    padding: 0.5rem 0.9rem;
  }

  .stat:nth-child(1),
  .stat:nth-child(2),
  .stat:nth-child(3) {
    flex: 1.15;
    padding: 0.6rem 0.8rem;
  }

  .stat-value {
    display: block;
    color: #2563eb;
    font-weight: 800;
    font-size: 1.3rem;
    white-space: nowrap;
  }

  .stat-label {
    display: block;
    color: #64748b;
    font-size: 1rem;
    font-weight: 700;
  }
  @media (max-width: 1368px) and (min-width: 606px) {

  

    .personas-img {
      position: absolute;
      right: -2.2rem;
      bottom: 0;
      max-width: 54%;
      height: auto;
      object-fit: contain;
      z-index: 1;
      pointer-events: none;
      transform: translateY(2rem);
      
    }

    h1 {
    font-size: clamp(1.5rem, 3.5vw, 3rem);
    font-weight: 798;
    line-height: 1.15;
    color: #0f172a;
    transform: translateY(2rem);

  }
  p {
    font-size: 1.5rem;
    font-weight: 650;
    color: #334155;
    transform: translateY(4rem);
  }
    .content {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 1rem;
    z-index: 10;
    
  }

  .stats {
    display: flex;
    gap: 1.2rem;
    flex-wrap: nowrap;
    transform: translateY(4rem);
    max-width: 680px;
  }


  .stat:last-child {
    flex: 1.2;
    padding: 0.5rem 0.9rem;
  }

  .stat:nth-child(1),
  .stat:nth-child(2),
  .stat:nth-child(3) {
    flex: 1.3;
    padding: 0.6rem 0.8rem;
  }

  .stat-value {
    display: block;
    color: #2563eb;
    font-weight: 800;
    font-size: 1rem;
    white-space: nowrap;
  }

  .stat-label {
    display: block;
    color: #64748b;
    font-size: 0.9rem;
    font-weight: 700;
  }


  }
  @media (max-width: 1200px) {
    .banner {
      min-height: auto;
      padding: 3rem 2rem;
    }

    .personas-img {
      width: 200%;
      right: clamp(-30%, calc(-20% - 0.0015 * (100vw - 606px)), -15%);
    }
  }

  @media (max-width: 768px) {
    .banner {
      padding: 2rem 1rem;
    }

    .content {
      max-width: 100%;
    }

    h1 {
      transform: none;
      font-size: clamp(1.8rem, 7vw, 2.5rem);
    }

    p {
      transform: none;
      font-size: 1rem;
    }

    .stats {
      flex-wrap: wrap;
    }

    .stat,
    .stat:last-child,
    .stat:nth-child(1),
    .stat:nth-child(2),
    .stat:nth-child(3) {
      flex: 1 1 calc(50% - 0.5rem);
    }

    .personas-img {
      max-height: 300px;
    }
  }

  @media (max-width: 480px) {
    .banner {
      position: relative;
      height: 110vh;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      padding: 2rem;
    }

    .personas-img {
      display: block;
      position: static;
      order: 2;
      width: 145%;
      max-width: 560px;
      height: 70vh;
      margin: 4.5rem auto 0;
      -webkit-mask-image: linear-gradient(to bottom, black 75%, transparent 100%);
      mask-image: linear-gradient(to bottom, black 75%, transparent 100%);
      transform: translatex(-5rem);
    }

    .content {
      order: 1;
    }

    h1 {
      font-size: clamp(1.7rem, 7vw, 2.2rem);
      font-weight: 700;
      line-height: 1.15;
      color: #0f172a;
      width: 100%;
      text-align: center;
      transform: translateY(4rem);
    }

    p {
      font-size: 0.8rem;
      font-weight: 600;
      color: #334155;
      text-align: center;
      transform: translateY(5rem) translateX(1.25rem);
      margin-left: 0;
    }

    .content {
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      gap: 1rem;
      z-index: 10;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.4rem;
      width: 100%;
    }

    .stat {
      padding: 0.2rem 0.3rem;
    }

    .stat-value {
      font-size: 0.68rem;
    }

    .stat-label {
      font-size: 0.55rem;
    }

    .stat:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
