---
// Sección bajo el banner de /facturacion-electronica: el problema de facturar a mano y la solución de NANIVA.
// Fondo blanco: el banner de arriba es azul y las secciones alternan azul y blanco.
import { Image } from 'astro:assets';
import { checkIcon } from '@components/producto/icons';
import logoImg from '@assets/image/libro-reclamaciones/logo-inicio.webp';

const comprobantes = [
  'Facturas electrónicas',
  'Boletas de venta',
  'Notas de crédito y débito',
  'Guías de remisión',
  'Otros comprobantes',
];

const xIcon = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>`;

// Hoja de comprobante dibujada: se repite apilada en la ilustración y en el panel de la solución
const hoja = `<svg viewBox="0 0 56 68" fill="none" aria-hidden="true">
  <path d="M6 2h30l16 16v44a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V6a4 4 0 0 1 4-4Z" fill="#fff" stroke="#cbd5e1" stroke-width="2"/>
  <path d="M36 2v16h16" stroke="#cbd5e1" stroke-width="2" stroke-linejoin="round"/>
  <path d="M11 26h26M11 34h30M11 42h20M11 50h24" stroke="#e2e8f0" stroke-width="3" stroke-linecap="round"/>
</svg>`;
---

<section class="fp-section">
  <div class="fp-wrap">
    <div class="fp-split">
      <div class="fp-problema reveal">
        <div class="fp-copy">
          <span class="fp-pill">EL PROBLEMA</span>
          <h2>La facturación electrónica puede ser un <span class="fp-hl">dolor de cabeza.</span></h2>
          <p>
            Gestionar comprobantes de forma manual o con sistemas desactualizados genera errores, retrabajos y riesgo de
            sanciones. Necesitas una solución confiable que te asegure el cumplimiento con SUNAT y simplifique tu
            operación.
          </p>
        </div>

        <div class="fp-visual" aria-hidden="true">
          <div class="fp-hojas">
            <span class="fp-hoja fp-hoja-1" set:html={hoja} />
            <span class="fp-hoja fp-hoja-2" set:html={hoja} />
            <span class="fp-hoja fp-hoja-3" set:html={hoja} />
            <span class="fp-x" set:html={xIcon} />
          </div>
          <svg class="fp-flecha" viewBox="0 0 40 16" fill="none">
            <path d="M2 8h34M29 2l7 6-7 6" stroke="#2f8ef5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div class="fp-laptop">
            <div class="fp-pantalla">
              <Image src={logoImg} alt="" widths={[80, 160]} sizes="80px" loading="lazy" class="fp-logo" />
              <strong>NANIVA</strong>
            </div>
            <span class="fp-base"></span>
            <span class="fp-ok" set:html={checkIcon} />
          </div>
        </div>
      </div>

      <div class="fp-solucion reveal" style="--d: 120ms">
        <div class="fp-solucion-copy">
          <span class="fp-pill fp-pill-sm">LA SOLUCIÓN NANIVA</span>
          <h3>Facturación electrónica integrada y sin <span class="fp-hl">complicaciones.</span></h3>
          <p>
            Emite tus comprobantes electrónicos de manera rápida y segura desde el sistema, con integración directa a
            SUNAT y cumplimiento de todos los requisitos legales.
          </p>
          <ul class="fp-checks">
            {comprobantes.map((c) => (
              <li><span class="fp-check" set:html={checkIcon} />{c}</li>
            ))}
          </ul>
        </div>

        <div class="fp-doc" aria-hidden="true">
          <span class="fp-doc-atras" set:html={hoja} />
          <span class="fp-doc-frente" set:html={hoja} />
          <span class="fp-doc-ok" set:html={checkIcon} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .fp-section { padding: clamp(3.5rem, 6vw, 6rem) 0; background: #fff; }
  /* Mismo ancho que el panel de /migracion-datos */
  .fp-wrap { width: min(1900px, calc(100% - 1.5rem)); margin: 0 auto; }

  /* Dos paneles separados, mitad y mitad, como en /migracion-datos: el problema (blanco) y la solución (celeste) */
  .fp-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(1.25rem, 2vw, 2rem);
  }

  .fp-problema {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    padding: clamp(1.75rem, 2.5vw, 2.75rem);
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    background: #fff;
    box-shadow: var(--card-shadow);
  }

  .fp-pill {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: #e8f0ff;
    color: #1d4ed8;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .fp-copy h2 {
    margin: 1.1rem 0 1rem;
    font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #0b1f4d;
  }
  .fp-hl { color: #1d8cf8; }
  .fp-copy p { max-width: 30rem; margin: 0; color: #475569; font-size: 1rem; line-height: 1.7; }

  /* Ilustración: comprobantes en papel con error → laptop de NANIVA validada */
  .fp-visual { display: flex; align-items: center; justify-content: center; gap: 1rem; }
  .fp-hojas { position: relative; width: 92px; height: 104px; flex: none; }
  .fp-hoja { position: absolute; width: 64px; filter: drop-shadow(0 6px 12px rgba(15, 23, 42, 0.08)); }
  .fp-hoja :global(svg) { display: block; width: 100%; height: auto; }
  .fp-hoja-1 { top: 0; left: 0; transform: rotate(-10deg); }
  .fp-hoja-2 { top: 8px; left: 14px; transform: rotate(-3deg); }
  .fp-hoja-3 { top: 18px; left: 26px; }
  .fp-x {
    position: absolute;
    right: -6px;
    bottom: -4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #fde2e2;
    color: #e5484d;
  }
  .fp-flecha { flex: none; width: 38px; }

  .fp-laptop { position: relative; flex: none; width: clamp(150px, 13vw, 210px); }
  .fp-pantalla {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    aspect-ratio: 16 / 10.5;
    border: 7px solid #1e293b;
    border-radius: 12px 12px 4px 4px;
    background: #fff;
  }
  .fp-logo { width: 38%; height: auto; }
  .fp-pantalla strong { color: #12408f; font-size: clamp(0.85rem, 0.5rem + 0.6vw, 1.1rem); font-weight: 700; letter-spacing: 0.08em; }
  .fp-base {
    display: block;
    width: 118%;
    height: 10px;
    margin-left: -9%;
    border-radius: 0 0 10px 10px;
    background: linear-gradient(#cbd5e1, #94a3b8);
  }
  .fp-ok {
    position: absolute;
    top: -12px;
    right: -12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #14b8a6;
    color: #fff;
  }

  /* Tarjeta de la solución */
  .fp-solucion {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.75rem, 2.5vw, 2.75rem);
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    background: linear-gradient(135deg, #f1f7ff 0%, #e6f0ff 100%);
    box-shadow: var(--card-shadow);
  }
  .fp-pill-sm { background: #fff; font-size: 0.7rem; }
  .fp-solucion h3 {
    margin: 0.9rem 0 0.75rem;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.65rem);
    font-weight: 700;
    line-height: 1.25;
    color: #0b1f4d;
  }
  .fp-solucion-copy > p { max-width: 30rem; margin: 0 0 1.1rem; color: #475569; font-size: 0.85rem; line-height: 1.65; }
  .fp-checks { list-style: none; display: grid; gap: 0.6rem; margin: 0; padding: 0; }
  .fp-checks li { display: flex; align-items: center; gap: 0.65rem; color: #1e293b; font-size: 0.85rem; font-weight: 600; }
  .fp-check {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #14b8a6;
    color: #fff;
  }
  .fp-check :global(svg) { width: 13px; height: 13px; }

  /* Comprobantes validados en la esquina de la tarjeta */
  .fp-doc { position: relative; width: 84px; height: 96px; }
  .fp-doc span:not(.fp-doc-ok) { position: absolute; width: 60px; }
  .fp-doc :global(svg) { display: block; width: 100%; height: auto; }
  .fp-doc-atras { top: 0; left: 0; opacity: 0.6; }
  .fp-doc-frente { top: 10px; left: 16px; filter: drop-shadow(0 6px 12px rgba(15, 23, 42, 0.1)); }
  .fp-doc-ok {
    position: absolute;
    right: -4px;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #14b8a6;
    color: #fff;
  }

  @media (max-width: 1200px) {
    .fp-split { grid-template-columns: 1fr; }
  }
  @media (max-width: 800px) {
    .fp-problema { grid-template-columns: 1fr; padding: 1.5rem 1.1rem; }
    .fp-solucion { grid-template-columns: 1fr; padding: 1.5rem 1.1rem; }
    .fp-doc { display: none; }
  }
  @media (max-width: 420px) {
    .fp-visual { gap: 0.6rem; }
    .fp-hojas { transform: scale(0.85); }
    .fp-laptop { width: 140px; }
  }
</style>
