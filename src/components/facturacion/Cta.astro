---
// Banner de cierre de /facturacion-electronica: escudo, título, texto y botones en una sola franja azul oscuro.
// Fondo celeste: va después de la sección blanca de SUNAT (las secciones alternan azul y blanco).
import { arrowIcon } from '@components/producto/icons';

const whatsapp = `https://wa.me/51937292341?text=${encodeURIComponent('Hola, quiero información sobre la facturación electrónica de NANIVA')}`;

const escudoIcon = `<svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>`;

const whatsappIcon = `<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>`;
---

<section class="fx-cta">
  <div class="fx-wrap">
    <div class="fx-panel reveal">
      {/* Ondas de luz de fondo: decorativas */}
      <svg class="fx-ondas" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 150 C 220 90, 420 210, 640 140 S 1000 40, 1200 110" />
        <path d="M0 175 C 260 120, 460 230, 700 165 S 1020 80, 1200 145" />
        <path d="M760 200 C 860 150, 1000 150, 1200 70" />
      </svg>

      <div class="fx-lead">
        <span class="fx-escudo" set:html={escudoIcon} />
        <div>
          <span class="fx-eyebrow">DA EL SIGUIENTE PASO</span>
          <h2><span>Tu facturación electrónica,</span> <span class="fx-hl">más simple y segura.</span></h2>
        </div>
      </div>

      <p class="fx-texto">
        Solicita una demo y descubre cómo NANIVA puede ayudarte a emitir tus comprobantes electrónicos de forma rápida y
        sin complicaciones.
      </p>

      <div class="fx-actions">
        <a href="/solicitar-demo" class="fx-btn fx-btn-primary">
          <span set:html={arrowIcon} /> Solicitar demostración
        </a>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="fx-btn fx-btn-outline">
          <span class="fx-wa" set:html={whatsappIcon} /> Contactar por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .fx-cta { padding: clamp(3.5rem, 6vw, 6rem) 0; background: #f3f8ff; }
  /* Mismo ancho que el cierre de /migracion-datos */
  .fx-wrap { width: min(1440px, calc(100% - 3rem)); margin: 0 auto; }

  /* Franja azul: regla de bordes del sitio (panel) */
  .fx-panel {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(18rem, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    padding: clamp(1.5rem, 2.2vw, 2.25rem) clamp(1.5rem, 3vw, 3rem);
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    background:
      radial-gradient(28rem 14rem at 0% 0%, rgba(59, 130, 246, 0.45), transparent 70%),
      linear-gradient(100deg, #0a3fa8 0%, #0b4fd0 55%, #0a46bb 100%);
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }
  .fx-ondas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgba(147, 197, 253, 0.22);
    stroke-width: 1.5;
    pointer-events: none;
  }
  .fx-ondas path { vector-effect: non-scaling-stroke; }

  .fx-lead { position: relative; display: flex; align-items: center; gap: clamp(1rem, 2vw, 1.75rem); }
  .fx-escudo {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: linear-gradient(145deg, #5aa9ff, #2f80ed);
    color: #fff;
    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.08), 0 10px 24px rgba(3, 20, 70, 0.35);
  }
  .fx-eyebrow {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #dbeafe;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .fx-lead h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.4rem, 1.1rem + 0.6vw, 1.7rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #fff;
  }
  /* Una línea por frase */
  .fx-lead h2 span { display: block; white-space: nowrap; }
  .fx-hl { color: #7dd3fc; }

  /* Texto con una línea divisoria a la izquierda */
  .fx-texto {
    position: relative;
    max-width: 30rem;
    margin: 0;
    padding-left: clamp(1.25rem, 2.5vw, 2.5rem);
    border-left: 1px solid rgba(255, 255, 255, 0.25);
    color: #dbeafe;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .fx-actions { position: relative; display: flex; gap: 0.9rem; }
  .fx-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.2s ease;
  }
  .fx-btn:hover { transform: translateY(-2px); }
  .fx-btn:focus-visible { outline: 3px solid #93c5fd; outline-offset: 3px; }
  .fx-btn :global(svg) { display: block; flex-shrink: 0; }
  .fx-btn-primary { background: #fff; color: #0b3aa8; }
  .fx-btn-primary:hover { background: #eef5ff; }
  .fx-btn-outline { border: 1.5px solid rgba(255, 255, 255, 0.7); color: #fff; }
  .fx-btn-outline:hover { background: rgba(255, 255, 255, 0.1); }
  .fx-wa { display: inline-flex; }

  @media (prefers-reduced-motion: reduce) {
    .fx-btn, .fx-btn:hover { transform: none; }
  }
  @media (max-width: 1300px) {
    .fx-panel { grid-template-columns: auto minmax(0, 1fr); }
    .fx-actions .fx-btn { flex: 1 1 16rem; max-width: 22rem; }
    .fx-actions { grid-column: 1 / -1; flex-wrap: wrap; justify-content: center; }
  }
  @media (max-width: 800px) {
    .fx-panel { grid-template-columns: 1fr; padding: 1.75rem 1.25rem; text-align: center; }
    .fx-lead { flex-direction: column; }
    .fx-lead h2 span { white-space: normal; }
    .fx-texto { margin: 0 auto; padding: 1.25rem 0 0; border-left: 0; border-top: 1px solid rgba(255, 255, 255, 0.25); }
    .fx-actions { flex-direction: column; }
    .fx-btn { width: 100%; white-space: normal; }
  }
</style>
