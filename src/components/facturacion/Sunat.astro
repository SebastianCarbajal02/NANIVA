---
// "Conexión directa con SUNAT" de /facturacion-electronica: laptop con el dashboard y tarjetas flotantes del
// recorrido del comprobante (enviado, aceptado y validado por SUNAT) a la izquierda, y el texto con tres
// beneficios separados por líneas a la derecha.
// Fondo blanco: va después de la sección azul de comprobantes (las secciones alternan azul y blanco).
import { Image } from 'astro:assets';
import { checkIcon } from '@components/producto/icons';
import laptopImg from '@assets/image/facturacion-electronica/banner-ultimo.webp';
import sunatLogo from '@assets/image/facturacion-electronica/sunat.webp';

const svg = (paths: string) =>
  `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

const facturaIcon = svg('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h5"/><path d="M14 2v6h6v4"/><path d="M8 9h3M8 13h5M8 17h2"/><circle cx="17.5" cy="17.5" r="3.5"/><path d="m16 17.5 1 1 2-2"/>');
const escudoIcon = svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>');

const beneficios = [
  { title: 'Validación automática', desc: 'de comprobantes', icon: facturaIcon },
  { title: 'Menos errores', desc: 'y retrabajos', icon: escudoIcon },
  {
    title: 'Mayor seguridad',
    desc: 'en tu información',
    icon: svg('<rect x="4" y="11" width="16" height="11" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><circle cx="12" cy="16" r="1.4"/><path d="M12 17.4V19"/>'),
  },
];

const linkIcon = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>`;
---

<section class="fs-section">
  <div class="fs-wrap">
    <div class="fs-visual reveal">
      <span class="fs-blob" aria-hidden="true"></span>
      <div class="fs-device">
        <Image
          src={laptopImg}
          alt="Panel de NANIVA con el resumen de ventas y facturación"
          widths={[320, 480, 680, 1024]}
          sizes="(max-width: 1000px) 90vw, 720px"
          loading="lazy"
          class="fs-laptop"
        />
      </div>

      <!-- Recorrido del comprobante: enviado a SUNAT (arriba) y aceptado (abajo), unidos por una línea punteada -->
      <div class="fs-flow">
        <div class="fs-card fs-card-envio">
          <Image src={sunatLogo} alt="SUNAT" widths={[130, 265]} sizes="130px" loading="lazy" class="fs-brand" />
          <span class="fs-card-sub">Comprobante electrónico</span>
          <span class="fs-estado"><span set:html={checkIcon} />Enviado a SUNAT</span>
        </div>
        <span class="fs-conector" aria-hidden="true"></span>
        <div class="fs-card fs-card-factura">
          <span class="fs-card-icon" set:html={facturaIcon} />
          <span class="fs-card-text">
            <strong>Factura electrónica</strong>
            <span class="fs-card-sub">F001-000123</span>
            <span class="fs-estado"><span set:html={checkIcon} />Aceptado</span>
          </span>
        </div>
      </div>

      <div class="fs-card fs-card-validacion">
        <span class="fs-card-ok" set:html={checkIcon} />
        <span class="fs-card-icon" set:html={escudoIcon} />
        <strong>Validación SUNAT</strong>
        <span class="fs-card-sub">Conforme</span>
      </div>
    </div>

    <div class="fs-copy">
      <span class="fs-pill reveal"><span set:html={linkIcon} />INTEGRACIÓN Y VALIDACIÓN</span>
      <h2 class="reveal" style="--d: 60ms">Conexión directa con <span class="fs-hl">SUNAT</span></h2>
      <p class="reveal" style="--d: 120ms">
        NANIVA se integra directamente con SUNAT para emitir y validar tus comprobantes electrónicos, ayudándote a
        cumplir con los requisitos normativos y a mantener la información organizada.
      </p>

      <ul class="fs-beneficios">
        {beneficios.map((b, i) => (
          <li class="reveal" style={`--d: ${200 + i * 100}ms`}>
            <span class="fs-icon" set:html={b.icon} />
            <strong>{b.title}</strong>
            <span>{b.desc}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .fs-section { padding: clamp(3.5rem, 6vw, 6rem) 0; background: #fff; overflow: hidden; }
  .fs-wrap {
    width: min(1600px, calc(100% - 1.5rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4.5rem);
  }

  /* Laptop sobre un círculo celeste, con tarjetas flotantes a la izquierda y a la derecha */
  .fs-visual { position: relative; padding: 2.5rem 0 2.5rem 5%; }
  .fs-blob {
    position: absolute;
    top: -4%;
    left: 14%;
    width: 72%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #e3eeff 0%, #edf4ff 45%, rgba(243, 248, 255, 0) 70%);
  }
  .fs-device { position: relative; max-width: 760px; margin-right: 7%; }
  /* Sombra suave bajo la laptop */
  .fs-device::before {
    content: '';
    position: absolute;
    left: 16%;
    right: 2%;
    bottom: 6%;
    height: 14%;
    background: radial-gradient(ellipse at center, rgba(37, 99, 235, 0.2), transparent 70%);
  }
  /* La foto viene cortada a la derecha: ese borde se desvanece y la tarjeta de validación lo cubre */
  .fs-laptop {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    -webkit-mask-image: linear-gradient(to right, #000 90%, transparent);
    mask-image: linear-gradient(to right, #000 90%, transparent);
  }

  .fs-card {
    border: var(--border-soft);
    border-radius: var(--card-radius);
    background: #fff;
    box-shadow: var(--card-shadow-hover);
  }
  .fs-card strong { color: #0b1f4d; font-size: 1rem; font-weight: 700; }
  .fs-card-sub { color: #64748b; font-size: 0.85rem; }
  .fs-card-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #e8f0ff;
    color: #1d6fe0;
  }
  .fs-estado {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    width: fit-content;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: #14b8a6;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
  }
  .fs-estado :global(svg) { display: block; width: 11px; height: 11px; }

  /* Columna izquierda: tarjeta de envío arriba, factura aceptada abajo y la línea punteada entre ambas */
  .fs-flow {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .fs-card-envio { display: grid; justify-items: center; gap: 0.35rem; padding: 1rem 1.4rem; }
  .fs-brand { display: block; width: 130px; height: auto; }
  .fs-conector {
    position: relative;
    flex: 1;
    width: 0;
    margin-left: 4.5rem;
    border-left: 2px dashed rgba(29, 111, 224, 0.4);
  }
  .fs-conector::before {
    content: '';
    position: absolute;
    top: -5px;
    left: -6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #1d6fe0;
    box-shadow: 0 0 0 4px rgba(29, 111, 224, 0.15);
  }
  .fs-card-factura { display: flex; align-items: center; gap: 0.9rem; padding: 1rem 1.25rem; }
  .fs-card-text { display: grid; gap: 0.25rem; }
  .fs-card-text .fs-estado { justify-self: end; margin-top: 0.25rem; }

  /* Tarjeta derecha: validación conforme, encima del borde cortado de la laptop */
  .fs-card-validacion {
    position: absolute;
    right: -2%;
    top: 46%;
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    padding: 1.1rem 1.4rem;
  }
  .fs-card-validacion .fs-card-icon { margin-bottom: 0.4rem; }
  .fs-card-ok {
    position: absolute;
    top: -10px;
    right: -10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #14b8a6;
    color: #fff;
  }
  .fs-card-ok :global(svg) { width: 13px; height: 13px; }

  /* Texto */
  .fs-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: #e8f0ff;
    color: #1d4ed8;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .fs-pill :global(svg) { display: block; }
  .fs-copy h2 {
    margin: 1.1rem 0 1rem;
    font-size: clamp(1.9rem, 1.2rem + 2vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #0b1f4d;
  }
  .fs-hl { color: #1d8cf8; }
  .fs-copy > p { max-width: 38rem; margin: 0; color: #475569; font-size: 1.05rem; line-height: 1.7; }

  /* Tres beneficios separados por líneas verticales */
  .fs-beneficios {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2.25rem 0 0;
    padding: 0;
  }
  .fs-beneficios li { display: grid; justify-items: start; gap: 0.2rem; padding: 0 1.5rem; }
  .fs-beneficios li:first-child { padding-left: 0; }
  .fs-beneficios li + li { border-left: 1px solid rgba(148, 163, 184, 0.35); }
  .fs-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    margin-bottom: 0.9rem;
    border-radius: 50%;
    background: #e8f0ff;
    color: #1d6fe0;
  }
  .fs-icon :global(svg) { width: 30px; height: 30px; }
  .fs-beneficios strong { color: #12408f; font-size: 1rem; font-weight: 700; }
  .fs-beneficios span:not(.fs-icon) { color: #64748b; font-size: 0.92rem; }

  @media (max-width: 1000px) {
    .fs-wrap { grid-template-columns: 1fr; }
    .fs-copy { order: -1; }
  }
  @media (max-width: 640px) {
    .fs-visual { padding: 4.5rem 0 5rem; }
    .fs-device { margin-right: 0; }
    .fs-card-envio { padding: 0.6rem 0.8rem; gap: 0.2rem; }
    .fs-brand { width: 92px; }
    .fs-card-sub { font-size: 0.72rem; }
    .fs-estado { font-size: 0.65rem; padding: 0.15rem 0.5rem; }
    .fs-conector { margin-left: 2.5rem; }
    .fs-card-factura { padding: 0.6rem 0.8rem; gap: 0.6rem; }
    .fs-card strong { font-size: 0.85rem; }
    .fs-card-icon { width: 38px; height: 38px; }
    .fs-card-icon :global(svg) { width: 20px; height: 20px; }
    .fs-card-validacion { top: 28%; padding: 0.7rem 0.9rem; }
    .fs-beneficios { grid-template-columns: 1fr; gap: 1.25rem; }
    .fs-beneficios li { grid-template-columns: auto 1fr; column-gap: 0.9rem; padding: 0; border: 0 !important; }
    .fs-icon { grid-row: span 2; margin: 0; width: 52px; height: 52px; }
    .fs-icon :global(svg) { width: 26px; height: 26px; }
  }
</style>
