---
import iconDetecta from '../assets/image/IA/beneficios/icono-detecta-quiebres.webp';
import iconUtilidad from '../assets/image/IA/beneficios/icono-mayor-utilidad.webp';
import iconClientes from '../assets/image/IA/beneficios/icono-recupera-clientes.webp';
import iconRecomienda from '../assets/image/IA/beneficios/icono-recomienda-comprar.webp';
import iconPrioriza from '../assets/image/IA/beneficios/icono-prioriza-importante.webp';
import iconDecision from '../assets/image/IA/beneficios/icono-mejor-decision.webp';

const benefits = [
  {
    icon: iconDetecta,
    accent: "#16a34a",
    title: "Detecta quiebres de stock antes que ocurran.",
    desc: "Tu venta no se detiene: prevé y actúa a tiempo.",
  },
  {
    icon: iconUtilidad,
    accent: "#f97316",
    title: "Encuentra productos con mayor utilidad.",
    desc: "Vende lo que más renta, elimina lo que no te da resultado.",
  },
  {
    icon: iconClientes,
    accent: "#2563eb",
    title: "Recupera clientes que dejaron de comprar.",
    desc: "Detecta clientes inactivos y activa campañas efectivas.",
  },
  {
    icon: iconRecomienda,
    accent: "#a855f7",
    title: "Recomienda qué comprar y a quién venderle.",
    desc: "Adecúa tu inventario, mejora tus ventas y optimiza cada compra.",
  },
  {
    icon: iconPrioriza,
    accent: "#ec4899",
    title: "Prioriza lo importante para tu negocio.",
    desc: "Enfócate en lo que realmente impacta y genera resultados.",
  },
  {
    icon: iconDecision,
    accent: "#0ea5a3",
    title: "Te recomienda la mejor decisión.",
    desc: "Decisiones claras, basadas en datos reales.",
  },
];
---
<section class="benefits-ia">
  <div class="container">
    <div class="benefits-head reveal">
      <span class="benefits-badge">
        <img src={iconRecomienda.src} alt="" />
      </span>
      <h2>Lo que la IA hace por tu empresa</h2>
    </div>

    <div class="benefits-carousel-wrap">
      <button type="button" class="carousel-arrow carousel-arrow-prev" aria-label="Beneficio anterior">‹</button>
      <button type="button" class="carousel-arrow carousel-arrow-next" aria-label="Siguiente beneficio">›</button>

      <div class="benefits-grid">
        {benefits.map((b, i) => (
          <div class="benefit-card reveal hover-lift" style={`transition-delay:${i * 0.08}s`}>
            <span class="benefit-icon">
              <img src={b.icon.src} alt="" />
            </span>
            <h3>{b.title}</h3>
            <span class="benefit-divider" style={`background:${b.accent};`}></span>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>

      <div class="carousel-dots">
        {benefits.map((_, i) => (
          <button type="button" class="carousel-dot" data-index={i} aria-label={`Ir al beneficio ${i + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initBenefitsCarousel() {
    const wrap = document.querySelector<HTMLElement>(".benefits-carousel-wrap");
    const track = document.querySelector<HTMLElement>(".benefits-grid");
    if (!wrap || !track) return;

    const slides = Array.from(track.querySelectorAll<HTMLElement>(".benefit-card"));
    const dots = Array.from(wrap.querySelectorAll<HTMLButtonElement>(".carousel-dot"));
    const prevBtn = wrap.querySelector<HTMLButtonElement>(".carousel-arrow-prev");
    const nextBtn = wrap.querySelector<HTMLButtonElement>(".carousel-arrow-next");

    const mq = window.matchMedia("(max-width: 480px)");
    let active = false;

    const setActiveDot = (index: number) => {
      dots.forEach((d, i) => d.classList.toggle("is-active", i === index));
    };

    const currentIndex = () => {
      const scrollLeft = track.scrollLeft;
      const width = track.clientWidth;
      return Math.round(scrollLeft / width);
    };

    let animFrame: number | null = null;
    const easeInOutQuad = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

    const animateScrollTo = (target: number, duration = 600) => {
      if (animFrame) cancelAnimationFrame(animFrame);
      track.classList.add("is-animating");
      const start = track.scrollLeft;
      const distance = target - start;
      const startTime = performance.now();

      const step = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        track.scrollLeft = start + distance * easeInOutQuad(progress);
        if (progress < 1) {
          animFrame = requestAnimationFrame(step);
        } else {
          animFrame = null;
          track.classList.remove("is-animating");
        }
      };
      animFrame = requestAnimationFrame(step);
    };

    const goTo = (index: number) => {
      const clamped = Math.max(0, Math.min(slides.length - 1, index));
      animateScrollTo(clamped * track.clientWidth, 600);
    };

    const onScroll = () => setActiveDot(currentIndex());

    const enable = () => {
      if (active) return;
      active = true;
      track.addEventListener("scroll", onScroll, { passive: true });
      setActiveDot(0);
    };

    const disable = () => {
      if (!active) return;
      active = false;
      track.removeEventListener("scroll", onScroll);
    };

    mq.addEventListener("change", (e) => (e.matches ? enable() : disable()));
    if (mq.matches) enable();

    prevBtn?.addEventListener("click", () => goTo(currentIndex() - 1));
    nextBtn?.addEventListener("click", () => goTo(currentIndex() + 1));
    dots.forEach((dot) => {
      dot.addEventListener("click", () => goTo(Number(dot.dataset.index)));
    });

    let isDragging = false;
    let dragStartX = 0;
    let scrollStart = 0;

    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      isDragging = true;
      track.classList.add("is-dragging");
      dragStartX = e.clientX;
      scrollStart = track.scrollLeft;
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener("pointermove", (e) => {
      if (!isDragging) return;
      track.scrollLeft = scrollStart - (e.clientX - dragStartX);
    });
    const endDrag = (e: PointerEvent) => {
      if (e.pointerType !== "mouse" || !isDragging) return;
      isDragging = false;
      track.classList.remove("is-dragging");
      setActiveDot(currentIndex());
      goTo(currentIndex());
    };
    track.addEventListener("pointerup", endDrag);
    track.addEventListener("pointercancel", endDrag);
  }

  initBenefitsCarousel();
  document.addEventListener("astro:page-load", initBenefitsCarousel);
</script>

<style>
  .benefits-ia {
    background: #f8fafc;
    padding: 5rem 1rem;
  }

  .benefits-ia .container {
    max-width: 1500px;
  }

  .benefits-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .benefits-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100px;
    height: 100px;
  }
  .benefits-badge img {
    width: 150%;
    height: 150%;
    object-fit: contain;
  }
  .benefits-head h2 {
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    font-weight: 700;
    color: #0f172a;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.75rem;
    align-items: stretch;
  }

  .benefit-card {
    height: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #ffffff;
    border-radius: 20px;
    padding: 1.75rem 1.1rem;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
  }

  .benefit-icon {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }
  .benefit-icon img {
    width: 120px;
    height: 120px;
    object-fit: contain;
  }

  .benefit-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.4;
  }

  .benefit-divider {
    width: 32px;
    height: 2px;
    border-radius: 999px;
    margin: 0.9rem 0;
  }

  .benefit-card p {
    font-size: 0.9rem;
    font-weight: 500;
    color: #64748b;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .benefits-ia { padding: 3.5rem 1rem; }
  }

  @media (max-width: 480px) {
    .benefits-carousel-wrap {
      position: relative;
      padding: 0 1.5rem;
    }

    .benefits-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      cursor: grab;
      user-select: none;
      gap: 0;
    }
    .benefits-grid::-webkit-scrollbar { display: none; }
    .benefits-grid.is-dragging,
    .benefits-grid.is-animating {
      cursor: grabbing;
      scroll-snap-type: none;
    }

    .benefit-card {
      flex: 0 0 100%;
      min-width: 0;
      scroll-snap-align: center;
    }

    .carousel-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 40%;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      border-radius: 999px;
      border: none;
      background: rgba(15, 23, 42, 0.85);
      color: white;
      font-size: 1.4rem;
      line-height: 1;
      z-index: 3;
      cursor: pointer;
    }
    .carousel-arrow-prev { left: 0; }
    .carousel-arrow-next { right: 0; }

    .carousel-dots {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1.25rem;
    }
    .carousel-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      border: none;
      background: #cbd5e1;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .carousel-dot.is-active {
      background: #2563eb;
      transform: scale(1.3);
    }
  }

  @media (min-width: 481px) {
    .carousel-arrow,
    .carousel-dots {
      display: none;
    }
  }
</style>
