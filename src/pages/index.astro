---
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav.astro';
import Hero from '@components/home/Hero.astro';
import Services from '@components/home/Services.astro';
import Implementation from '@components/home/Implementation.astro';
import DemoVideo from '@components/home/DemoVideo.astro';
import WhyNaniva from '@components/home/WhyNaniva.astro';
import Dashboard from '@components/home/Dashboard.astro';
import CaseStudies from '@components/home/CaseStudies.astro';
import TransformBanner from '@components/home/TransformBanner.astro';
import Faq from '@components/home/Faq.astro';
import { faqSchema } from '@data/faqs';
---

<BaseLayout
  title="NANIVA | Facturación Electrónica, ERP y Software con IA en Perú"
  description="Gestiona ventas, inventario, compras y facturación electrónica SUNAT en una sola plataforma con inteligencia artificial. Solicita tu demo gratis."
  schema={faqSchema}
>
  <link slot="head" rel="preload" as="image" href="/fondo-hero.webp" fetchpriority="high" />
  <Nav />
  <Hero />
  <Dashboard />
  <Implementation />
  <Services />
  <DemoVideo />
  <WhyNaniva />
  <CaseStudies />
  <TransformBanner />
  <Faq />
</BaseLayout>