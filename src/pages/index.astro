---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero_original.astro';
import ClientsTrust from '../components/ClientsTrust.astro';
import Services from '../components/Services.astro';
import Implementation from '../components/Implementation.astro';
import DemoVideo from '../components/DemoVideo.astro';
import WhyNaniva from '../components/WhyNaniva.astro';
import Showcase from '../components/Showcase.astro';
import CaseStudies from '../components/CaseStudies.astro';
import TransformBanner from '../components/TransformBanner.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import { faqSchema } from '../data/faqs';
---

<BaseLayout
  title="NANIVA | Facturación Electrónica, ERP y Software con IA en Perú"
  description="Gestiona ventas, inventario, compras y facturación electrónica SUNAT en una sola plataforma con inteligencia artificial. Solicita tu demo gratis."
  schema={faqSchema}
>
  <Nav />
  <Hero />
  <ClientsTrust />
  <Services />
  <DemoVideo />
  <WhyNaniva />
  <Showcase />
  <Implementation />
  <CaseStudies />
  <TransformBanner />
  <Faq />
</BaseLayout>