---
// Página "Nosotros": señal de confianza (E-E-A-T). Solo datos verificables de la empresa;
// equipo, historia y casos de clientes se agregan cuando estén confirmados (ver docs/seo/parte-4).
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav.astro';
import { icons, arrowIcon } from '@components/producto/icons';

const site = Astro.site;
const whatsapp = `https://wa.me/51937292341?text=${encodeURIComponent('Hola, quiero conocer más sobre NANIVA')}`;

const soluciones = [
  { icon: icons.chart, title: 'Sistema ERP', desc: 'Ventas, inventario, compras, caja y facturación electrónica SUNAT en un solo sistema.', href: '/erp', cta: 'Ver el sistema ERP' },
  { icon: icons.utensils, title: 'Sistema para restaurantes', desc: 'Comandas, pre-cuentas, caja y comprobantes electrónicos para tu negocio gastronómico.', href: '/sistema-para-restaurantes', cta: 'Ver el sistema para restaurantes' },
  { icon: icons.book, title: 'Catálogo digital', desc: 'Comparte tus productos con un enlace o en PDF y recibe pedidos por WhatsApp.', href: '/catalogo-digital', cta: 'Ver el catálogo digital' },
  { icon: icons.store, title: 'Tienda online', desc: 'Tu propia tienda con carrito, pagos en línea y stock conectado a tu ERP.', href: '/tienda-online', cta: 'Ver la tienda online' },
  { icon: icons.sparkles, title: 'Naniva IA', desc: 'Convierte tus datos de ventas, compras e inventario en recomendaciones concretas.', href: '/ia', cta: 'Conoce Naniva IA' },
];

const comoTrabajamos = [
  { icon: icons.clock, title: 'Implementación rápida', desc: 'Tu sistema queda listo en aproximadamente 24 horas desde que contratas.' },
  { icon: icons.upload, title: 'Migración desde Excel', desc: 'Te ayudamos a importar tus productos, clientes e inventario sin empezar de cero.' },
  { icon: icons.cloud, title: '100% en la nube', desc: 'Funciona desde el navegador, sin instalar nada, y con actualizaciones incluidas.' },
  { icon: icons.headset, title: 'Soporte cercano', desc: 'Te atendemos por WhatsApp y teléfono de lunes a viernes, de 9:00 a 18:00.' },
];

const datos = [
  { label: 'Razón social', value: 'NANIVA TECHNOLOGIES S.A.C.' },
  { label: 'RUC', value: '20615608221' },
  { label: 'Dirección', value: 'Calle Manrique de Luna 168, San Miguel, Lima' },
  { label: 'Teléfono', value: '+51 937 292 341', href: 'tel:+51937292341' },
  { label: 'Correo', value: 'ventas@naniva.com', href: 'mailto:ventas@naniva.com' },
  { label: 'Horario', value: 'Lunes a viernes, de 9:00 a 18:00' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Nosotros | NANIVA',
    url: new URL('/nosotros', site).href,
    inLanguage: 'es-PE',
    about: { '@id': new URL('/#organization', site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Nosotros', item: new URL('/nosotros', site).href },
    ],
  },
];
---

<BaseLayout
  title="Nosotros: empresa peruana de software | NANIVA"
  description="NANIVA Technologies es una empresa peruana de software en San Miguel, Lima. Creamos ERP, sistemas para restaurantes y tiendas digitales con IA."
  schema={schema}
>
  <Nav />

  <section class="about-hero">
    <div class="container">
      <span class="eyebrow">NOSOTROS</span>
      <h1>Tecnología peruana para que tu negocio <span class="hl">crezca con orden</span></h1>
      <p class="lead">
        En NANIVA Technologies creamos software en la nube para pymes del Perú: un ERP con facturación electrónica SUNAT,
        un sistema para restaurantes, catálogo digital y tienda online, todos conectados entre sí y con inteligencia
        artificial que convierte tus datos en decisiones.
      </p>
      <div class="actions">
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Hablemos por WhatsApp</a>
        <a href="/planes" class="btn btn-outline">Ver planes y precios</a>
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="container">
      <div class="section-head reveal">
        <h2>Nuestra misión</h2>
        <p>
          Que cualquier negocio, desde una bodega hasta una distribuidora, pueda vender, facturar y controlar su inventario
          sin depender del Excel ni de sistemas desconectados. Por eso todas nuestras soluciones comparten la misma
          información: lo que vendes en tu tienda, en tu restaurante o por WhatsApp se refleja al instante en tu stock,
          tu caja y tus reportes.
        </p>
      </div>
    </div>
  </section>

  <section class="about-section alt">
    <div class="container">
      <div class="section-head reveal">
        <h2>Qué hacemos</h2>
        <p>Soluciones pensadas para la forma en que trabajan los negocios en el Perú.</p>
      </div>
      <ul class="cards cards-5">
        {soluciones.map((s, i) => (
          <li class="card reveal" style={`transition-delay: ${i * 70}ms`}>
            <span class="card-icon" set:html={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <a href={s.href} class="card-link">{s.cta} <span set:html={arrowIcon} /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="about-section">
    <div class="container">
      <div class="section-head reveal">
        <h2>Cómo trabajamos</h2>
        <p>Te acompañamos desde el primer día, no solo te entregamos un sistema.</p>
      </div>
      <ul class="cards cards-4">
        {comoTrabajamos.map((c, i) => (
          <li class="card reveal" style={`transition-delay: ${i * 70}ms`}>
            <span class="card-icon" set:html={c.icon} />
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </li>
        ))}
      </ul>
      <p class="sunat-note reveal">
        <span set:html={icons.receipt} />
        Facturación electrónica bajo el SEE – Del Contribuyente de SUNAT: tus comprobantes se emiten desde tu propio sistema.
      </p>
    </div>
  </section>

  <section class="about-section alt">
    <div class="container">
      <div class="company reveal">
        <div class="company-copy">
          <h2>Datos de la empresa</h2>
          <p>Somos una empresa formal, con oficina en Lima. Puedes verificar nuestros datos o visitarnos en horario de atención.</p>
          <a href="/contacto" class="btn btn-outline">Ir a contacto</a>
        </div>
        <dl class="company-data">
          {datos.map((d) => (
            <div class="company-row">
              <dt>{d.label}</dt>
              <dd>{d.href ? <a href={d.href}>{d.value}</a> : d.value}</dd>
            </div>
          ))}
          <div class="company-row">
            <dt>Atención al consumidor</dt>
            <dd><a href="/libro-reclamaciones">Libro de Reclamaciones</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="container">
      <div class="cta-panel reveal">
        <h2>¿Quieres ver NANIVA en acción?</h2>
        <p>Agenda una demostración gratuita y te mostramos cómo funciona con los datos de tu negocio.</p>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-light">Solicitar demostración</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: 8.5rem 1rem 4.5rem;
    background: linear-gradient(180deg, #eef4ff 0%, #f8fafc 100%);
    text-align: center;
  }
  .eyebrow {
    display: inline-block;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .about-hero h1 {
    max-width: 22ch;
    margin: 1rem auto 0;
    color: #0f172a;
    letter-spacing: -0.02em;
  }
  .hl { color: #2563eb; }
  .lead {
    max-width: 46rem;
    margin: 1.25rem auto 0;
    color: #475569;
    font-size: clamp(1.02rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.65;
  }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-top: 2rem; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.2s ease;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn:focus-visible { outline: 3px solid #93c5fd; outline-offset: 3px; }
  .btn-primary { background: #2563eb; color: #fff; }
  .btn-primary:hover { background: #1d4ed8; }
  .btn-outline { border: 2px solid #2563eb; color: #1d4ed8; background: #fff; }
  .btn-outline:hover { background: #eff6ff; }
  .btn-light { background: #fff; color: #1d4ed8; }

  .about-section { padding: 4.5rem 1rem; background: #fff; }
  .about-section.alt { background: #f8fafc; }
  .section-head { max-width: 46rem; margin: 0 auto 2.5rem; text-align: center; }
  .section-head h2,
  .company-copy h2 {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
  }
  .section-head p { margin-top: 0.75rem; color: #475569; font-size: 1.05rem; line-height: 1.7; }

  /* Tarjetas: regla de bordes del sitio (.claude/skills/naniva-bordes) */
  .cards { list-style: none; display: grid; gap: 1.25rem; }
  .cards-5 { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .cards-4 { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem 1.4rem;
    background: #fff;
    border: var(--border-soft);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .card:hover { transform: translateY(-2px); box-shadow: var(--card-shadow-hover); }
  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #eff6ff;
    color: #2563eb;
  }
  .card-icon :global(svg) { width: 24px; height: 24px; }
  .card h3 { font-size: 1.1rem; font-weight: 800; color: #0f172a; }
  .card p { color: #475569; font-size: 0.95rem; line-height: 1.6; flex: 1; }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #1d4ed8;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .card-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .sunat-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    max-width: 46rem;
    margin: 2rem auto 0;
    color: #334155;
    font-weight: 600;
    text-align: center;
  }
  .sunat-note :global(svg) { flex-shrink: 0; width: 22px; height: 22px; color: #2563eb; }

  /* Datos de la empresa: panel */
  .company {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2.5rem;
    align-items: center;
    padding: 2.5rem;
    background: #fff;
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    box-shadow: var(--card-shadow);
  }
  .company-copy p { margin: 0.75rem 0 1.5rem; color: #475569; line-height: 1.7; }
  .company-row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid #f1f5f9;
  }
  .company-row:last-child { border-bottom: none; }
  .company-row dt { color: #64748b; font-weight: 600; }
  .company-row dd { color: #0f172a; font-weight: 700; overflow-wrap: anywhere; }
  .company-row a { color: #1d4ed8; text-decoration: none; }
  .company-row a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .cta-panel {
    padding: 3rem 2rem;
    text-align: center;
    background: linear-gradient(120deg, #1d4ed8 0%, #2563eb 100%);
    border: var(--border-soft);
    border-radius: var(--panel-radius);
    box-shadow: var(--card-shadow);
    color: #fff;
  }
  .cta-panel h2 { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.2rem); font-weight: 800; }
  .cta-panel p { max-width: 36rem; margin: 0.75rem auto 1.75rem; color: #dbeafe; line-height: 1.6; }

  @media (max-width: 860px) {
    .company { grid-template-columns: 1fr; padding: 1.75rem 1.25rem; gap: 1.5rem; }
  }
  @media (max-width: 600px) {
    .about-hero { padding: 7rem 1rem 3.5rem; }
    .about-section { padding: 3.5rem 1rem; }
    .company-row { grid-template-columns: 1fr; gap: 0.2rem; }
    .actions .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .btn { transition: none; }
    .card:hover, .btn:hover { transform: none; }
  }
</style>
