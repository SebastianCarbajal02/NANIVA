---
// Página "Nosotros": señal de confianza (E-E-A-T). Solo datos verificables de la empresa;
// equipo, historia y casos de clientes se agregan cuando estén confirmados (ver docs/seo/parte-4).
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav.astro';
import Hero from '@components/nosotros/Hero.astro';
import Trayectoria from '@components/nosotros/Trayectoria.astro';
import MisionVision from '@components/nosotros/MisionVision.astro';
import Valores from '@components/nosotros/Valores.astro';
import Soluciones from '@components/nosotros/Soluciones.astro';
import ComoTrabajamos from '@components/nosotros/ComoTrabajamos.astro';
import DatosEmpresa from '@components/nosotros/DatosEmpresa.astro';
import Cta from '@components/nosotros/Cta.astro';

const site = Astro.site;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Nosotros | NANIVA',
    url: new URL('/nosotros', site).href,
    inLanguage: 'es-PE',
    about: { '@id': new URL('/#organization', site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Nosotros', item: new URL('/nosotros', site).href },
    ],
  },
];
---

<BaseLayout
  title="Nosotros: empresa peruana de software | NANIVA"
  description="NANIVA Technologies es una empresa peruana de software en San Miguel, Lima. Creamos ERP, sistemas para restaurantes y tiendas digitales con IA."
  schema={schema}
>
  <Nav />
  <Hero />
  <Trayectoria />
  <MisionVision />
  <Valores />
  <Soluciones />
  <ComoTrabajamos />
  <DatosEmpresa />
  <Cta />
</BaseLayout>
