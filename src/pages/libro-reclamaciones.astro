---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/libro-reclamaciones/Hero.astro';
import Form from '@components/libro-reclamaciones/Form.astro';
---

<BaseLayout title="Libro de Reclamaciones | NANIVA" description="Libro de Reclamaciones virtual de NANIVA Technologies. Registra tu queja o reclamo conforme al Código de Protección y Defensa del Consumidor.">
  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1e40af;
      --text-dark: #0f172a;
      --text-muted: #64748b;
      --border-light: #e2e8f0;
      --bg-light: #f8fafc;
      --bg-blue-light: #eff6ff;
    }
  </style>

  <Hero />
  <Form />
</BaseLayout>
