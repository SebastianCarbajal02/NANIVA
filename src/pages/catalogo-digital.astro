---
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav.astro';
import Hero from '@components/producto/Hero.astro';
import Why from '@components/producto/Why.astro';
import Steps from '@components/producto/Steps.astro';
import Audience from '@components/producto/Audience.astro';
import ShareBanner from '@components/producto/ShareBanner.astro';
import Plans from '@components/producto/Plans.astro';
import Faq from '@components/producto/Faq.astro';
import { productos, productoSchema } from '@data/productos';

const p = productos.catalogo;
---

<BaseLayout title={p.title} description={p.description} schema={productoSchema(p, Astro.site)}>
  <Nav />
  <Hero producto={p} />
  <Why producto={p} />
  <Steps producto={p} />
  <Audience producto={p} />
  <Plans producto={p} />
  <ShareBanner producto={p} />
  <Faq producto={p} />
</BaseLayout>

<style is:global>
  /* Fondos alternados después del banner (verde menta): blanco, verde, blanco, verde... */
  /* :not(:first-of-type) sube la especificidad para ganarle al fondo propio de cada componente */
  main > section:nth-of-type(even):not(:first-of-type) { background: #fff; }
  main > section:nth-of-type(odd):not(:first-of-type) { background: #f1faf5; }
</style>
