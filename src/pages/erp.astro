---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav.astro';
import Hero from '@components/producto/Hero.astro';
import Features from '@components/producto/Features.astro';
import Benefits from '@components/producto/Benefits.astro';
import Steps from '@components/producto/Steps.astro';
import Audience from '@components/producto/Audience.astro';
import ErpPlans from '@components/planes/ErpPlans.astro';
import Faq from '@components/producto/Faq.astro';
import Cta from '@components/producto/Cta.astro';
import { productos, productoSchema } from '@data/productos';
import ventaPosImage from '@assets/image/producto/VENTA-POS.webp';
import demoErpImage from '@assets/image/producto/demo.erp.naniva.cloud_.webp';
import kardexImage from '@assets/image/producto/KARDEX.webp';
import iaImage from '@assets/image/producto/IA.webp';
import { icons } from '@components/producto/icons';

const p = productos.erp;

const vistas = [
  {
    id: 'pos',
    tag: 'POS',
    title: 'Punto de venta',
    desc: 'Catálogo visual, búsqueda por SKU y cobro con boleta, factura o nota de venta.',
    img: ventaPosImage,
    alt: 'Punto de venta de NANIVA ERP con catálogo de productos y carrito de cobro',
  },
  {
    id: 'kardex',
    tag: 'Kardex',
    title: 'Inventario y kardex',
    desc: 'Entradas, salidas y traspasos por almacén con saldo actualizado al instante.',
    img: kardexImage,
    alt: 'Kardex de inventario de NANIVA ERP con movimientos por almacén',
  },
  {
    id: 'ia',
    tag: 'IA',
    title: 'Compras con IA',
    desc: 'Recomendaciones de reposición según la rotación real de tus productos.',
    img: iaImage,
    alt: 'Inteligencia artificial de NANIVA ERP recomendando compras',
  },
];

const desafios = [
  {
    title: 'Descontrol de inventario',
    desc: 'Stock desactualizado, productos faltantes o en exceso, y poca visibilidad de lo que realmente tienes.',
    icon: icons.box,
  },
  {
    title: 'Información dispersa',
    desc: 'Datos en diferentes archivos y sistemas que dificultan la toma de decisiones y generan errores.',
    icon: icons.file,
  },
  {
    title: 'Tareas manuales',
    desc: 'Procesos repetitivos que consumen tiempo, aumentan los errores y afectan la productividad.',
    icon: icons.clock,
  },
];

const lineIcon = (paths: string, size = 24) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
const slidersIcon = (size?: number) =>
  lineIcon('<path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/>', size);
const gaugeIcon = lineIcon('<path d="M3.5 17a9 9 0 1 1 17 0"/><path d="m12 13 4-4"/><circle cx="12" cy="13" r="1.3"/><path d="M6.5 13H5M19 13h-1.5M12 6.5V5"/>');
const yesIcon = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
const noIcon = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>`;

const solidIcon = (body: string) =>
  `<svg viewBox="0 0 48 48" width="52" height="52" aria-hidden="true">${body}</svg>`;
const whiteCheck = (d: string) =>
  `<path d="${d}" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>`;

const shieldBadge = `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 2 4 5v6.5c0 5 3.4 8.9 8 10.5 4.6-1.6 8-5.5 8-10.5V5Z" fill="currentColor" opacity=".9"/><path d="m8.8 12 2.2 2.2 4.3-4.4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const seguridad = [
  {
    title: 'Permisos por rol',
    desc: 'Define quién puede vender, ver reportes, aprobar compras o modificar precios.',
    tone: '#2563eb',
    soft: '#eaf1ff',
    icon: solidIcon(
      `<path d="M14 21v-6a9.5 9.5 0 0 1 19 0v6" fill="none" stroke="currentColor" stroke-width="4.5"/><rect x="8" y="19" width="31" height="23" rx="5" fill="currentColor"/><circle cx="23.5" cy="28.5" r="3.2" fill="#fff"/><rect x="22" y="29" width="3" height="6.5" rx="1.5" fill="#fff"/><circle cx="37" cy="37" r="9" fill="#1d4ed8" stroke="#fff" stroke-width="3"/>${whiteCheck('m32.8 37 3 3 5.5-5.6')}`,
    ),
  },
  {
    title: 'Auditoría y trazabilidad',
    desc: 'Todo movimiento queda registrado para evitar errores, fraudes o cambios no autorizados.',
    tone: '#10b981',
    soft: '#e6f8f1',
    icon: solidIcon(
      `<rect x="7" y="3" width="29" height="38" rx="5" fill="currentColor"/><path d="M14 13h15M14 20h15M14 27h8" stroke="#fff" stroke-width="3" stroke-linecap="round"/><path d="m39.5 39.5 5 5" stroke="#047857" stroke-width="5" stroke-linecap="round"/><circle cx="33" cy="33" r="8" fill="#fff" stroke="#047857" stroke-width="4"/>`,
    ),
  },
  {
    title: 'Compatibilidad de hardware',
    desc: 'Funciona con laptops, tablets, impresoras y terminales POS compatibles con tu operación.',
    tone: '#8b5cf6',
    soft: '#f1ebff',
    icon: solidIcon(
      `<rect x="5" y="7" width="34" height="24" rx="3.5" fill="currentColor"/><path d="m22 11.5 5.5 7-5.5 7-5.5-7Z" fill="#fff"/><path d="M1 34h42v1.5a3.5 3.5 0 0 1-3.5 3.5h-35A3.5 3.5 0 0 1 1 35.5Z" fill="currentColor"/><circle cx="38" cy="35" r="9" fill="#6d28d9" stroke="#fff" stroke-width="3"/><path d="M38 28.6v1.6M38 39.8v1.6M31.6 35h1.6M42.8 35h1.6M33.5 30.5l1.1 1.1M41.4 38.4l1.1 1.1M33.5 39.5l1.1-1.1M41.4 31.6l1.1-1.1" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/><circle cx="38" cy="35" r="3.9" fill="none" stroke="#fff" stroke-width="2.6"/>`,
    ),
  },
  {
    title: 'Acceso seguro en la nube',
    desc: 'Consulta, vende y gestiona desde cualquier lugar con respaldos automáticos y control centralizado.',
    tone: '#3b82f6',
    soft: '#e8f1ff',
    icon: solidIcon(
      `<path d="M13.5 37a10 10 0 0 1-1.4-19.9A12.5 12.5 0 0 1 36.4 15 10 10 0 0 1 35 37Z" fill="currentColor"/><path d="m36 22.5 9 3.5v6.5c0 5.6-3.8 9.1-9 11.1-5.2-2-9-5.5-9-11.1V26Z" fill="#1d4ed8" stroke="#fff" stroke-width="3" stroke-linejoin="round"/>${whiteCheck('m31.8 33 3 3 5.5-5.6')}`,
    ),
  },
];

const comparacion: { funcion: string; icon: string; valores: [boolean, string][] }[] = [
  {
    funcion: 'Control de inventario en tiempo real',
    icon: icons.clock,
    valores: [[false, 'Manual y con errores'], [false, 'No incluye o es básico'], [true, 'Kardex y alertas automáticas']],
  },
  {
    funcion: 'Velocidad de emisión de comprobantes',
    icon: gaugeIcon,
    valores: [[false, 'Lento (portal se cae)'], [true, 'Rápido'], [true, 'En 3 clics y directo a WhatsApp']],
  },
  {
    funcion: 'Múltiples almacenes o sucursales',
    icon: icons.store,
    valores: [[false, 'Imposible coordinar'], [false, 'Cobro extra por local'], [true, 'Sincronizado en la nube']],
  },
  {
    funcion: 'Seguridad y permisos de cajeros',
    icon: icons.shield,
    valores: [[false, 'Cualquiera puede alterar'], [false, 'Limitado'], [true, 'Roles antifraude y auditoría']],
  },
  {
    funcion: 'Predicción de compras y rotación',
    icon: icons.chart,
    valores: [[false, 'Cero análisis'], [false, 'Reportes planos'], [true, 'Motor de análisis para tu negocio']],
  },
  {
    funcion: 'Ventas, compras, caja y cobranzas conectadas',
    icon: icons.refresh,
    valores: [[false, 'Hojas sueltas sin conexión'], [false, 'Solo facturación'], [true, 'Todo en un solo sistema']],
  },
  {
    funcion: 'Migración de tus datos actuales',
    icon: icons.upload,
    valores: [[false, 'Copias a mano'], [false, 'Empiezas de cero'], [true, 'Importamos tu Excel']],
  },
];
---

<BaseLayout title={p.title} description={p.description} schema={productoSchema(p, Astro.site)}>
  <Nav />
  <Hero producto={p} />

  <section class="erp-challenge">
    <div class="container">
      <div class="challenge-head">
        <span class="challenge-eyebrow reveal">El desafío</span>
        <h2 class="reveal" style="--d: 60ms">¿Te suena familiar?</h2>
        <p class="reveal" style="--d: 120ms">
          Muchos negocios pierden tiempo, dinero y oportunidades por procesos desordenados y falta de información en tiempo real.
        </p>
      </div>

      <div class="challenge-grid">
        {desafios.map((d, i) => (
          <article class="challenge-card reveal" style={`--d: ${i * 100}ms`}>
            <span class="challenge-icon"><Fragment set:html={d.icon} /></span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="erp-product-showcase">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">VISTAS REALES DEL SOFTWARE</span>
        <h2>Así se ve la operación real de tu negocio en <span class="highlight">NANIVA ERP</span></h2>
      </div>

      <div class="viewer reveal" style="--d: 120ms" data-viewer>
        <div class="viewer-tabs" role="tablist" aria-label="Vistas del software">
          {vistas.map((v, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${v.id}`}
              class="viewer-tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`vista-${v.id}`}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="viewer-tab-tag">{v.tag}</span>
              <span class="viewer-tab-title">{v.title}</span>
              <span class="viewer-tab-desc">{v.desc}</span>
            </button>
          ))}
        </div>

        <div class="browser">
          <div class="browser-bar" aria-hidden="true">
            <span class="browser-dots"><i></i><i></i><i></i></span>
            
          </div>
          <div class="browser-screen">
            {vistas.map((v, i) => (
              <figure
                id={`vista-${v.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${v.id}`}
                class:list={['viewer-panel', { 'is-active': i === 0 }]}
              >
                <Image
                  src={v.img}
                  alt={v.alt}
                  widths={[640, 960, 1280, 1920]}
                  sizes="(max-width: 1240px) 100vw, 1200px"
                />
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <Features producto={p} />

  <section class="erp-migration">
    <div class="container">
      <div class="migration-panel">
        <div class="migration-text">
          <span class="migration-eyebrow reveal">Migración de datos</span>
          <h2 class="reveal" style="--d: 60ms">Cambia de sistema sin empezar de cero</h2>
          <p class="reveal" style="--d: 120ms">
            Adaptamos la migración de tu información a las plantillas de Excel que ya usas.
            Así, puedes continuar con tu operación sin complicaciones y sin perder tus datos.
          </p>
          <a href="/migracion-datos" class="migration-btn reveal" style="--d: 180ms">
            Conoce más sobre la migración
          </a>
        </div>

        <div class="migration-visual reveal" style="--d: 120ms">
          <div class="excel-file" aria-hidden="true">
            <svg class="excel-logo" viewBox="0 0 64 56" width="78" height="68">
              <rect x="26" y="4" width="36" height="48" rx="3" fill="#fff" stroke="#1d6f42" stroke-width="2.5"/>
              <path d="M34 14h20M34 22h20M34 30h20M34 38h20M44 10v36" stroke="#1d6f42" stroke-width="2.5"/>
              <path d="M2 8 36 2v52L2 48Z" fill="#1d6f42"/>
              <path d="m11 18 14 20M25 18 11 38" stroke="#fff" stroke-width="5" stroke-linecap="round"/>
            </svg>
            <span class="excel-bar"></span>
            <span class="excel-rows"><i></i><i></i><i></i><i></i></span>
          </div>

          <svg class="migration-arrow" viewBox="0 0 40 24" width="40" height="24" fill="none" aria-hidden="true">
            <path d="M3 12h32M25 3l10 9-10 9" stroke="#1d6ff2" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>

          <div class="migration-shot">
            <Image
              src={demoErpImage}
              alt="NANIVA ERP con la información migrada desde Excel"
              widths={[480, 720, 960, 1440]}
              sizes="(max-width: 900px) 90vw, 720px"
              loading="lazy"
            />
            <span class="migration-badge">
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
                <circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="2"/>
                <path d="m6.5 10 2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Tus datos, en un nuevo sistema
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Benefits producto={p} />

  <section class="erp-product-compare">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow eyebrow-icon"><Fragment set:html={slidersIcon(16)} />Comparación</span>
        <h2 class="compare-title">
          Portal SUNAT / Excel vs.{' '}
          <span class="compare-brand">
            NANIVA ERP
            <svg class="brand-sparks" viewBox="0 0 40 44" width="40" height="44" fill="none" aria-hidden="true">
              <path d="M6 16 20 4M10 26l20-4M8 36l16 6" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
            </svg>
            <svg class="brand-swoosh" viewBox="0 0 220 24" preserveAspectRatio="none" fill="none" aria-hidden="true">
              <path d="M4 18C60 6 140 2 216 8" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
              <path d="M40 22c50-8 110-11 150-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity=".55"/>
            </svg>
          </span>
        </h2>
        <p class="compare-sub">Más control, menos errores, <strong>mayor eficiencia</strong>.</p>
        <span class="compare-rule" aria-hidden="true"></span>
      </div>

      <div class="compare-wrap reveal" style="--d: 120ms">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col">
                <span class="col-head">
                  <span class="col-icon plain"><Fragment set:html={slidersIcon()} /></span>
                  Función
                </span>
              </th>
              <th scope="col">
                <span class="col-head">
                  <span class="col-icon"><Fragment set:html={icons.file} /></span>
                  Portal SUNAT / Excel
                </span>
              </th>
              <th scope="col">
                <span class="col-head">
                  <span class="col-icon"><Fragment set:html={icons.cloud} /></span>
                  Software de facturación simple
                </span>
              </th>
              <th scope="col" class="col-naniva">
                <span class="col-head">
                  <span class="col-icon brand" aria-hidden="true">N</span>
                  NANIVA ERP
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            {comparacion.map((fila) => (
              <tr>
                <th scope="row">
                  <span class="row-head">
                    <span class="row-icon"><Fragment set:html={fila.icon} /></span>
                    {fila.funcion}
                  </span>
                </th>
                {fila.valores.map(([ok, texto], i) => (
                  <td class:list={{ 'col-naniva': i === 2 }}>
                    <span class="cell">
                      <span class:list={['mark', ok ? 'yes' : 'no']}>
                        <Fragment set:html={ok ? yesIcon : noIcon} />
                        <span class="sr-only">{ok ? 'Sí:' : 'No:'}</span>
                      </span>
                      {texto}
                    </span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <Steps producto={p} />
  <section class="erp-pricing">
    <ErpPlans />
  </section>

  <section class="erp-security">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow eyebrow-with-icon"><Fragment set:html={shieldBadge} />SEGURIDAD Y CONTROL</span>
        <h2>Tu operación protegida y operando <span class="highlight">sin fricción</span></h2>
        <p class="compare-sub">Accede a herramientas que te dan control, seguridad y tranquilidad en cada proceso.</p>
        <span class="compare-rule" aria-hidden="true"></span>
      </div>

      <div class="security-grid">
        {seguridad.map((s, i) => (
          <article class="security-card reveal" style={`--d: ${i * 80}ms; --tone: ${s.tone}; --tone-soft: ${s.soft};`}>
            <div class="security-icon"><Fragment set:html={s.icon} /></div>
            <div class="security-head">
              <h3>{s.title}</h3>
              <span class="security-bar" aria-hidden="true"></span>
            </div>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Cta producto={p} />
  <Faq producto={p} />

  <style>
    /* Secciones alternas: blanco / azul claro, con línea en cada cambio */
    .erp-product-showcase,
    .erp-product-compare {
      padding: 4rem 0;
    }

    .erp-product-showcase,
    .erp-product-compare,
    .erp-pricing,
    :global(.producto-section.cta.cta) {
      background: #f0f5ff;
      border-top: 1px solid #dbe4f3;
    }

    :global(.producto-section.benefits.benefits),
    :global(.producto-section.steps.steps),
    .erp-security,
    :global(#faq.faq) {
      background: #fff;
      border-top: 1px solid #dbe4f3;
    }

    /* Migración de datos: tarjeta azul clara con Excel → NANIVA ERP */
    .erp-migration {
      padding: 3.5rem 0;
      background: #fff;
      border-top: 1px solid #dbe4f3;
    }

    .migration-panel {
      display: grid;
      grid-template-columns: minmax(0, 0.68fr) minmax(0, 1.32fr);
      align-items: center;
      gap: 2.5rem;
      width: min(1480px, calc(100vw - 3rem));
      margin-left: 50%;
      transform: translateX(-50%);
      padding: 5rem 3rem 5.5rem 5rem;
      border-radius: var(--panel-radius);
      background: linear-gradient(135deg, #eaf3ff 0%, #f3f8ff 55%, #eaf2fd 100%);
    }

    .migration-eyebrow {
      display: inline-block;
      color: #1d6ff2;
      font-size: 1.05rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .migration-text h2 {
      margin: 0.5rem 0 1.25rem;
      max-width: 13em;
      font-size: clamp(1.9rem, 3vw, 2.9rem);
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: #0f2a5c;
    }

    .migration-text p {
      margin: 0 0 2rem;
      max-width: 30em;
      color: #475569;
      font-size: 1.15rem;
      line-height: 1.75;
    }

    .migration-btn {
      display: inline-flex;
      align-items: center;
      padding: 1.1rem 2.3rem;
      border-radius: 10px;
      background: #1d6ff2;
      color: #fff;
      font-weight: 600;
      font-size: 1.08rem;
      text-decoration: none;
      transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .migration-btn:hover { background: #1558c9; transform: translateY(-2px); }

    .migration-visual {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
      padding-bottom: 1.5rem;
    }

    /* Mancha suave de fondo detrás del Excel y la flecha */
    .migration-visual::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      width: 70%;
      aspect-ratio: 1;
      transform: translateY(-50%);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(191, 219, 254, 0.55), transparent 70%);
      pointer-events: none;
    }

    .excel-file {
      position: relative;
      flex: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.7rem;
      width: 128px;
      padding: 1.2rem 0.9rem 1rem;
      background: #fff;
      border-radius: 10px;
      clip-path: polygon(0 0, 86% 0, 100% 10%, 100% 100%, 0 100%);
      box-shadow: 0 14px 30px -14px rgba(15, 42, 92, 0.22);
    }

    .excel-bar {
      width: 100%;
      height: 7px;
      border-radius: 2px;
      background: #1d8a4e;
    }

    .excel-rows {
      display: grid;
      gap: 6px;
      width: 100%;
    }

    .excel-rows i {
      display: block;
      height: 7px;
      border-radius: 2px;
      background: #e5e9ef;
    }

    .migration-arrow { position: relative; flex: none; }

    .migration-shot {
      position: relative;
      flex: 1 1 auto;
      min-width: 0;
    }

    .migration-shot img {
      display: block;
      width: 100%;
      height: auto;
      border: 2px solid #1d6ff2;
      border-radius: 12px;
      box-shadow: 0 24px 50px -20px rgba(15, 42, 92, 0.35);
    }

    .migration-badge {
      position: absolute;
      right: 1.25rem;
      bottom: -1.5rem;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.85rem 1.3rem;
      background: #fff;
      border-radius: 10px;
      color: #16a34a;
      font-size: 1rem;
      font-weight: 600;
      white-space: nowrap;
      box-shadow: 0 12px 30px -10px rgba(15, 42, 92, 0.25);
    }

    @media (max-width: 1100px) {
      .migration-panel { padding: 3rem; gap: 2rem; }
